{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "M0Probe",
    "version": "0.1.0",
    "identifier": "com.hifishifter.m0probe",
    "build": {
        "frontendDist": "../frontend",
        "devUrl": "http://localhost:1430",
        "beforeDevCommand": ""
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "title": "M0 Probe",
                "width": 900,
                "height": 700
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "resources": {
            "resources/probe.bin": "probe.bin"
        },
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/icon.png",
            "icons/icon.ico"
        ]
    }
}
