+    );
+}
diff --git a/frontend/src/components/mobile/useClipOverlayGeometry.ts b/frontend/src/components/mobile/useClipOverlayGeometry.ts
new file mode 100644
index 00000000..d1faffae
--- /dev/null
+++ b/frontend/src/components/mobile/useClipOverlayGeometry.ts
@@ -0,0 +1,169 @@
+/**
+ * 手机上「浮在音频块之上的 DOM 覆盖层」共用的几何真值。
+ *
+ * 【为什么需要它】块是**内核 canvas 自绘、没有 DOM**（规格表也印证：双击块只能走内核
+ * 回调）⇒ 覆盖层只能自己把「秒 → 像素」算一遍：`x = 容器左 + startSec·pxPerSec − scrollLeft`，
+ * `y = 容器上 + 行号·rowHeight − scrollTop`。目前有三处这种计算（常用操作浮条
+ * `ClipQuickActions`、左右控制点 `ClipControlPoints`、长按提示 `ClipEdgeLongPressHint`），
+ * 各写一份必然漂移——三者的横向锚点是同一个"块左/右缘"，差一像素就是"看着在角上、
+ * 摸着不在角上"。
+ *
+ * 【视口真值为什么要 rAF 轮询】滚动 / 缩放 / 行高都会变（内核是自绘的，不触发 React
+ * 状态更新），没有可订阅的事件；但存储用的仍是**内核自己的钩子** `__hsViewport()`
+ * （与渲染同源），因此不存在"算出来和画出来不一致"。
+ *
+ * 【边缘带为什么这么算】左右边缘（`left-edge` / `right-edge`）在竖直方向只占块的下部：
+ *   `localY ∈ [header + reserve, clipHeight − 12)`
+ * 其中 `header = CLIP_HEADER_HEIGHT(18)`、`reserve = max(14, floor(body/3))`、
+ * 末尾 12px 让给 SnapOffset 三角握把。这与 `kernel/interaction/hitTest.ts` 的判定
+ * **逐项对齐**（照抄常量关系而不是调用它：那个模块是纯函数、不依赖 DOM，但在渲染层
+ * 引入内核内部模块会把两边的耦合面撑大）。控制点画在这条带上，用户"看着按"就等于
+ * 按进内核的边缘命中区。
+ */
+import React from "react";
+import { shallowEqual } from "react-redux";
+import { useAppSelector } from "../../app/hooks";
+
+/** `__hsViewport()` 返回的视口真值（只列覆盖层真正用到的字段）。 */
+export type ViewportTruth = {
+    scrollLeft: number;
+    scrollTop: number;
+    pxPerSec: number;
+    rowHeight: number;
+    containerRect?: { left: number; top: number; width: number; height: number };
+};
+
+/** 覆盖层几何（全部为**屏幕坐标**，可直接喂给 `position: fixed`）。 */
+export interface ClipOverlayGeometry {
+    readonly clipId: string;
+    /** 块的屏幕矩形。 */
+    readonly left: number;
+    readonly top: number;
+    readonly width: number;
+    readonly clipHeight: number;
+    /** 边缘控制点所在的竖直带（屏幕坐标）。 */
+    readonly edgeBandTop: number;
+    readonly edgeBandHeight: number;
+    readonly container: { left: number; top: number; width: number; height: number };
+    readonly pxPerSec: number;
+    readonly rowHeight: number;
+    /** 块是否与容器有横向交集（完全在视口外时覆盖层不必渲染）。 */
+    readonly horizontallyVisible: boolean;
+    readonly multiSelectedCount: number;
+    /** 手机断点（与常用操作浮条同一口径：< 600px）。 */
+    readonly isPhone: boolean;
+}
+
+/** 与内核 `constants.ts` 对齐的常量（见文件头说明）。 */
+const CLIP_HEADER_HEIGHT = 18;
+/** SnapOffset 三角握把的命中高度：边缘带必须让开这 12px。 */
+const SNAP_OFFSET_HIT_HEIGHT = 12;
+/** 淡变角保留区 = max(14, body/3)。 */
+function cornerReservePx(bodyHeightPx: number): number {
+    return Math.max(14, Math.round(Math.max(0, bodyHeightPx) / 3));
+}
+
+/**
+ * 订阅内核视口真值（rAF 轮询 + 仅在关键字段变化时 setState，避免逐帧重渲染）。
+ *
+ * @returns 视口真值；内核未就绪时为 null。
+ */
+export function useTimelineViewportTruth(): ViewportTruth | null {
+    const [vp, setVp] = React.useState<ViewportTruth | null>(null);
+    React.useEffect(() => {
+        let raf = 0;
+        const tick = () => {
+            const w = window as unknown as { __hsViewport?: () => ViewportTruth };
+            const next = w.__hsViewport ? w.__hsViewport() : null;
+            setVp((prev) =>
+                prev &&
+                next &&
+                prev.scrollLeft === next.scrollLeft &&
+                prev.scrollTop === next.scrollTop &&
+                prev.pxPerSec === next.pxPerSec &&
+                prev.rowHeight === next.rowHeight &&
+                prev.containerRect?.left === next.containerRect?.left &&
+                prev.containerRect?.top === next.containerRect?.top &&
+                prev.containerRect?.width === next.containerRect?.width &&
+                prev.containerRect?.height === next.containerRect?.height
+                    ? prev
+                    : next,
+            );
+            raf = requestAnimationFrame(tick);
+        };
+        raf = requestAnimationFrame(tick);
+        return () => cancelAnimationFrame(raf);
+    }, []);
+    return vp;
+}
+
+/**
+ * 当前选中块的覆盖层几何。
+ *
+ * @returns 几何；未选中 / 未就绪 / 选中的是**多选集合**（> 1）时为 null。
+ */
+export function useClipOverlayGeometry(): ClipOverlayGeometry | null {
+    const s = useAppSelector(
+        (st) => ({
+            selectedClipId: st.session.selectedClipId,
+            multiSelectedClipIds: st.session.multiSelectedClipIds,
+            clips: st.session.clips,
+            tracks: st.session.tracks,
+        }),
+        shallowEqual,
+    );
+    const vp = useTimelineViewportTruth();
+    const [isPhone, setIsPhone] = React.useState(
+        () => typeof window !== "undefined" && window.innerWidth < 600,
+    );
+    React.useEffect(() => {
+        const onResize = () => setIsPhone(window.innerWidth < 600);
+        window.addEventListener("resize", onResize);
+        onResize();
+        return () => window.removeEventListener("resize", onResize);
+    }, []);
+
+    return React.useMemo(() => {
+        if (!vp || !vp.containerRect) return null;
+        const clip = s.selectedClipId
+            ? s.clips.find((item) => item.id === s.selectedClipId)
+            : undefined;
+        if (!clip) return null;
+        const rowIndex = s.tracks.findIndex((track) => track.id === clip.trackId);
+        if (rowIndex < 0) return null;
+        const c = vp.containerRect;
+        const left = c.left + (clip.startSec ?? 0) * vp.pxPerSec - vp.scrollLeft;
+        /* ⚠️ 用 `lengthSec`（**时间轴长度**）而不是 `durationSec`（素材时长）：
+           块画多宽由 lengthSec 决定，左右控制点必须落在画出来的两条边上；变速过的块
+           两者会差一个 playbackRate 倍率（第一版浮条用 durationSec 居中，位置是偏的）。*/
+        const width = Math.max(24, (clip.lengthSec ?? 0) * vp.pxPerSec);
+        /* ⚠️ 行的纵坐标必须取**渲染真值**（轨道头 DOM 行 `[data-hs-track-row=<id>]`），
+           不能按「扁平下标 × rowHeight」推算：`state.tracks` 是扁平列表，而时间轴按
+           "父 → 其子 → 下一个父"渲染，子母轨存在时**扁平下标 ≠ 可视行号** ⇒ 控制点会
+           整行错位（实测：3 条轨道时算出的抓手比真块低 48px，正好落在下一条轨道上）。
+           取不到 DOM 行（例如平板走的是另一套布局）时才退回算术。 */
+        const rowEl = document.querySelector(`[data-hs-track-row="${clip.trackId}"]`);
+        const rowRect = rowEl ? rowEl.getBoundingClientRect() : null;
+        const rowHeightPx = rowRect ? rowRect.height : vp.rowHeight;
+        const top = rowRect ? rowRect.top : c.top + rowIndex * vp.rowHeight - vp.scrollTop;
+        const clipHeight = Math.max(1, rowHeightPx - 2);
+        const body = Math.max(1, clipHeight - CLIP_HEADER_HEIGHT);
+        const edgeTop = CLIP_HEADER_HEIGHT + cornerReservePx(body);
+        const edgeBottom = Math.max(edgeTop + 1, clipHeight - SNAP_OFFSET_HIT_HEIGHT);
+        return {
+            clipId: clip.id,
+            left,
+            top,
+            width,
+            clipHeight,
+            edgeBandTop: top + edgeTop,
+            edgeBandHeight: edgeBottom - edgeTop,
+            container: c,
+            pxPerSec: vp.pxPerSec,
+            rowHeight: vp.rowHeight,
+            horizontallyVisible: left + width >= c.left + 8 && left <= c.left + c.width - 8,
+            multiSelectedCount: s.multiSelectedClipIds.length,
+            isPhone,
+        };
+    }, [s, vp, isPhone]);
+}
