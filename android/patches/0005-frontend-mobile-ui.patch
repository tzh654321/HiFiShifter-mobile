+/**
+ * 可选模型管理对话框（`docs/02` §3.3 / ADR-012）。
+ *
+ * APK 里只内置核心声码器 `nsf_hifigan`（54 MB）；`hnsep`（气声分离，~88 MB）与
+ * `fcpe`（F0 提取，~41 MB）走「下载 / 本地导入」双通道。这里做的是**本地导入**：
+ * 走 SAF 让用户选一个 `.onnx`，后端把它放进 `<app_data_dir>/models/<模型>/`，
+ * 与「从 APK 拷贝」是同一个落点 ⇒ 模型加载侧一行不用改，且**免重启生效**
+ * （后端会补设启动时没设上的 `OnceLock`）。
+ *
+ * 为什么只需要用户提供一个文件：各模型的伴随小文件（`config.json` / `config.yaml`，
+ * 合计 < 1 KB）继续随包，只有大权重需要用户提供 —— 这样就不依赖 SAF 的"选目录"
+ * （`pick_folder` 还没实现，见 `docs/11` §7.2）。
+ *
+ * 文案走 i18n（`src/i18n/*.ts` 共 5 个语种，E36 补齐）。
+ */
+
+import { useCallback, useEffect, useState } from "react";
+import { Button, Dialog, Flex, Text } from "@radix-ui/themes";
+import type { OptionalModelStatus } from "../../types/api";
+import { coreApi } from "../../services/api/core";
+import { useI18n } from "../../i18n/I18nProvider";
+
+interface ModelManagerDialogProps {
+    open: boolean;
+    onOpenChange: (open: boolean) => void;
+}
+
+function formatMb(bytes: number | null): string {
+    if (bytes == null) return "—";
+    return `${(bytes / 1024 / 1024).toFixed(1)} MB`;
+}
+
+export function ModelManagerDialog({ open, onOpenChange }: ModelManagerDialogProps) {
+    const { t } = useI18n();
+    const tAny = t as (key: string) => string;
+    /** 带占位符的文案：i18n 是扁平 key→string 映射（没有参数表），这里做一次 `{name}` 替换。 */
+    const tf = (key: string, vars: Record<string, string | number>): string => {
+        let out = tAny(key);
+        for (const [k, v] of Object.entries(vars)) out = out.replace(`{${k}}`, String(v));
+        return out;
+    };
+    const [models, setModels] = useState<OptionalModelStatus[]>([]);
+    const [loading, setLoading] = useState(false);
+    const [busyId, setBusyId] = useState<string | null>(null);
+    const [message, setMessage] = useState<{ kind: "ok" | "warn" | "err"; text: string } | null>(
+        null,
+    );
+    const [loadError, setLoadError] = useState<string | null>(null);
+
+    const reload = useCallback(async () => {
+        setLoading(true);
+        setLoadError(null);
+        try {
+            const res = await coreApi.listOptionalModels();
+            setModels(res.models ?? []);
+        } catch (e: unknown) {
+            setLoadError(e instanceof Error ? e.message : String(e));
+        } finally {
+            setLoading(false);
+        }
+    }, []);
+
+    useEffect(() => {
+        if (!open) return;
+        // eslint-disable-next-line react-hooks/set-state-in-effect -- 对话框打开时拉一次状态（既有模式）
+        void reload();
+        setMessage(null);
+    }, [open, reload]);
+
+    async function handleImport(id: string) {
+        setBusyId(id);
+        setMessage(null);
+        try {
+            const res = await coreApi.importOptionalModel(id);
+            if (res.canceled) {
+                setMessage({ kind: "warn", text: tAny("model_manager_cancelled") });
+            } else if (!res.ok) {
+                setMessage({ kind: "err", text: res.error ?? tAny("model_manager_import_failed") });
+            } else {
+                setMessage({
+                    kind: "ok",
+                    text: tf(
+                        res.activated
+                            ? "model_manager_import_done_live"
+                            : "model_manager_import_done_restart",
+                        { size: formatMb(res.sizeBytes) },
+                    ),
+                });
+            }
+            await reload();
+        } catch (e: unknown) {
+            setMessage({ kind: "err", text: e instanceof Error ? e.message : String(e) });
+        } finally {
+            setBusyId(null);
+        }
+    }
+
+    const supported = models.length === 0 ? true : models[0].supported;
+
+    return (
+        <Dialog.Root open={open} onOpenChange={onOpenChange}>
+            <Dialog.Content style={{ maxWidth: 560 }} onKeyDown={(e) => e.stopPropagation()}>
+                <Dialog.Title>{tAny("model_manager_title")}</Dialog.Title>
+                <Dialog.Description size="2" color="gray">
+                    {tAny("model_manager_desc")}
+                </Dialog.Description>
+
+                <Flex direction="column" gap="3" mt="4">
+                    {loadError ? (
+                        <Text size="2" color="red">
+                            {tf("model_manager_load_failed", { err: loadError ?? "" })}
+                        </Text>
+                    ) : null}
+
+                    {!supported ? (
+                        <Text size="2" color="gray">
+                            {tAny("model_manager_unsupported")}
+                        </Text>
+                    ) : null}
+
+                    {models.map((m) => (
+                        <Flex
+                            key={m.id}
+                            align="center"
+                            justify="between"
+                            gap="3"
+                            style={{
+                                border: "1px solid var(--qt-border)",
+                                borderRadius: 6,
+                                padding: "10px 12px",
+                            }}
+                        >
+                            <Flex direction="column" gap="1" style={{ minWidth: 0 }}>
+                                <Text size="2" weight="medium">
+                                    {m.label}
+                                </Text>
+                                <Text size="1" color={m.present ? "green" : "gray"}>
+                                    {m.present
+                                        ? tf("model_manager_installed", { size: formatMb(m.sizeBytes) })
+                                        : tf("model_manager_not_installed", { file: m.fileName, mb: m.approxMb })}
+                                    {m.present && !m.active ? tAny("model_manager_restart_needed") : ""}
+                                </Text>
+                            </Flex>
+                            <Button
+                                size="2"
+                                variant={m.present ? "soft" : "solid"}
+                                disabled={!supported || busyId !== null || loading}
+                                onClick={() => void handleImport(m.id)}
+                            >
+                                {busyId === m.id
+                                    ? tAny("model_manager_waiting_pick")
+                                    : m.present
+                                      ? tAny("model_manager_reimport")
+                                      : tAny("model_manager_import_from_file")}
+                            </Button>
+                        </Flex>
+                    ))}
+
+                    {message ? (
+                        <Text
+                            size="2"
+                            color={
+                                message.kind === "ok"
+                                    ? "green"
+                                    : message.kind === "warn"
+                                      ? "gray"
+                                      : "red"
+                            }
+                        >
+                            {message.text}
+                        </Text>
+                    ) : null}
+
+                    <Text size="1" color="gray">
+                        {tAny("model_manager_hint")}
+                    </Text>
+                </Flex>
+
+                <Flex justify="end" gap="2" mt="4">
+                    <Dialog.Close>
+                        <Button variant="soft" color="gray">
+                            {tAny("close")}
+                        </Button>
+                    </Dialog.Close>
+                </Flex>
+            </Dialog.Content>
+        </Dialog.Root>
+    );
+}
