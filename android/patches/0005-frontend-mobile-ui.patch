+                            {tAny("storage_effective_root")}
+                        </Text>
+                        <Text size="1" style={{ wordBreak: "break-all" }} data-hs-storage-effective>
+                            {report?.effectiveRoot ?? "…"}
+                        </Text>
+                        {report?.usingFallback ? (
+                            <Text size="1" color="orange">
+                                {tAny("storage_using_fallback")}
+                            </Text>
+                        ) : null}
+                        <Text size="1" color="gray" style={{ wordBreak: "break-all" }}>
+                            {`${tAny("storage_default_root")}: ${report?.defaultRoot ?? ""}`}
+                        </Text>
+                        <Flex gap="2" mt="1" wrap="wrap">
+                            <Button
+                                size="1"
+                                variant="soft"
+                                disabled={!report?.effectiveRoot}
+                                onClick={() => openInApp(report?.effectiveRoot ?? "")}
+                            >
+                                {tAny("storage_open_in_browser")}
+                            </Button>
+                            <Button
+                                size="1"
+                                variant="soft"
+                                disabled={busy}
+                                onClick={() => {
+                                    setBusy(true);
+                                    void fileBrowserApi
+                                        .setStorageRoot("")
+                                        .then(() => refresh())
+                                        .finally(() => setBusy(false));
+                                }}
+                            >
+                                {tAny("storage_use_default")}
+                            </Button>
+                        </Flex>
+                    </Flex>
+
+                    <Flex direction="column" gap="2">
+                        <Text size="2" weight="bold">
+                            {tAny("storage_access_title")}
+                        </Text>
+                        {row(
+                            tAny("storage_access_all_files"),
+                            Boolean(report?.access.allFiles),
+                            tAny("storage_access_all_files_desc"),
+                            tAny("storage_go_settings"),
+                            () => {
+                                void fileBrowserApi
+                                    .openAllFilesAccessSettings()
+                                    .catch(() => null);
+                            },
+                        )}
+                        {row(
+                            tAny("storage_access_saf"),
+                            Boolean(report?.access.safTree),
+                            report?.access.safPrefix || tAny("storage_access_saf_desc"),
+                            tAny("storage_pick_dir"),
+                            () => {
+                                void fileBrowserApi
+                                    .pickDirectory()
+                                    .then(() => refresh())
+                                    .catch(() => null);
+                            },
+                        )}
+                        {row(
+                            tAny("storage_access_shizuku"),
+                            Boolean(report?.access.shizuku),
+                            tAny("storage_access_shizuku_desc"),
+                            tAny("storage_bind_shizuku"),
+                            () => {
+                                void (async () => {
+                                    await fileBrowserApi
+                                        .shizukuBindShellService()
+                                        .catch(() => null);
+                                    for (let i = 0; i < 12; i++) {
+                                        await new Promise((r) => setTimeout(r, 400));
+                                        const s = await fileBrowserApi
+                                            .shizukuShellReady()
+                                            .catch(() => null);
+                                        if (s?.ready) break;
+                                    }
+                                    await refresh();
+                                })();
+                            },
+                        )}
+                    </Flex>
+                </Flex>
+
+                <Flex justify="end" mt="4">
+                    <Button variant="soft" onClick={() => onOpenChange(false)}>
+                        {tAny("close")}
+                    </Button>
+                </Flex>
+            </div>
+            </>
+        </ExitPresence>
+    );
+}
