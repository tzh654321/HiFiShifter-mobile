+export function normalizeSplitTransitionCurve(value: string): SplitTransitionCurveType {
+    switch (value) {
+        case "linear":
+        case "convexSlight":
+        case "lateSlight":
+        case "convexSharp":
+        case "lateSharp":
+        case "sSlight":
+        case "sSharp":
+            return value;
+        case "exponential":
+            return "lateSlight";
+        case "logarithmic":
+            return "convexSlight";
+        case "sine":
+        case "scurve":
+            return "sSlight";
+        default:
