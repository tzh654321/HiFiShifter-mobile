new file mode 100644
index 00000000..b44f8bc2
--- /dev/null
+++ b/frontend/src/components/mobile/ClipEdgeLongPressHint.tsx
@@ -0,0 +1,146 @@
+/**
+ * 音频块头尾「控制点」长按提示 —— 规格 `docs/15` 触屏交互规格表，
+ * 「音频块头尾的控制点」列 · **长按**行：
+ *
+ * > `-`（**其上方出现淡入/淡出图标，下方出现变速缩放图标**）
+ *
+ * 同一列「长按并划动」行说明了这两个图标**各自的用途**：
+ * 上划后再横滑 = 调淡入淡出时长、下划后再横滑 = 调变速缩放。
+ * 因此这里不是装饰：它是**两段式手势的第一段反馈** —— 用户长按到 500ms 时
+ * 必须立刻知道"现在往上还是有戏、往下还有戏"，否则第二段横滑无从谈起。
+ *
+ * 【为什么用事件而不是 props 一路传下来】
+ * 长按的判定在内核（`timelineKernelHost.ts`，它拿得到 `pointerType === "touch"`
+ * 与 500ms 定时器），消费在渲染层（本组件）。中间隔着 `TimelinePanel` →
+ * `TimelineKernelView` 两层，props 传递要穿过与本次功能无关的一堆形参。
+ * 时间轴编辑操作早已确立「**事件名即契约**」这条约定（`hifi:timelineEditOp` /
+ * `hifi:editOp`，见 `focusRouting`）——提示通道是同一种东西：**瞬时、无状态、
+ * 只有一个订阅者**，正是事件最合适的形状。
+ *
+ * 【为什么按 clientX/clientY 定位】控制点是内核画在 canvas 上的（无 DOM），
+ * 且它的位置随缩放/滚动逐帧变化；内核在长按成立那一刻给的就是屏幕坐标，
+ * 直接 `position: fixed` 落在指针处，不需要再算一遍 sec→px 投影。
+ */
+import React from "react";
+
+/** 事件名即契约：内核宿主 → 提示浮层。 */
+export const CLIP_EDGE_LONG_PRESS_HINT_EVENT = "hifi:clipEdgeLongPressHint";
+
+/** 长按提示的载荷；`null` = 收起。 */
+export type ClipEdgeLongPressHintArgs = {
+    readonly clipId: string;
+    readonly side: "left" | "right";
+    readonly clientX: number;
+    readonly clientY: number;
+} | null;
+
+/**
+ * 派发一次长按提示（宿主 / 面板调用）。
+ *
+ * @param args 长按锚点；`null` 收起提示。
+ * @returns 无返回值。
+ */
+export function dispatchClipEdgeLongPressHint(args: ClipEdgeLongPressHintArgs): void {
+    window.dispatchEvent(
+        new CustomEvent<ClipEdgeLongPressHintArgs>(CLIP_EDGE_LONG_PRESS_HINT_EVENT, {
+            detail: args,
+        }),
+    );
+}
+
+/* ── 图标（与 `ClipQuickActions` 同规格：16×16 viewBox + currentColor）────── */
+const S = { width: 18, height: 18, viewBox: "0 0 16 16", fill: "none", "aria-hidden": true } as const;
+const stroke = {
+    stroke: "currentColor",
+    strokeWidth: 1.3,
+    strokeLinecap: "round",
+    strokeLinejoin: "round",
+} as const;
+
+/** 淡入淡出：一条 0 → 1 的包络上升曲线（与时间轴上的 fade 包络同一形状语言）。 */
+const IconFade = () => (
+    <svg {...S}>
+        <path d="M2 13.2c3.6 0 5.2-10.4 12-10.4" {...stroke} />
+        <path d="M2 13.2h12" {...stroke} strokeDasharray="1.5 2" />
+    </svg>
+);
+
+/** 变速缩放：左右双箭头 + 两端挡块（表示"两端固定、中间被拉伸"，区别于"移动"）。 */
+const IconStretch = () => (
+    <svg {...S}>
+        <path d="M4 8h8" {...stroke} />
+        <path d="M6 6 4 8l2 2M10 6l2 2-2 2" {...stroke} />
+        <path d="M2.2 4.6v6.8M13.8 4.6v6.8" {...stroke} />
+    </svg>
+);
+
+/**
+ * 控制点长按提示浮层（挂在手机时间轴面板里，全局只渲染一个）。
+ *
+ * @returns 提示浮层；未长按时返回 `null`（不占位、不拦截指针）。
+ */
+export function ClipEdgeLongPressHint() {
+    const [hint, setHint] = React.useState<ClipEdgeLongPressHintArgs>(null);
+
+    React.useEffect(() => {
+        const onHint = (event: Event) => {
+            const detail = (event as CustomEvent<ClipEdgeLongPressHintArgs>).detail ?? null;
+            setHint(detail);
+        };
+        window.addEventListener(CLIP_EDGE_LONG_PRESS_HINT_EVENT, onHint);
+        return () => window.removeEventListener(CLIP_EDGE_LONG_PRESS_HINT_EVENT, onHint);
+    }, []);
+
+    if (hint === null) return null;
+    // 只让**手机**看到（规格表整表是"触屏交互"，桌面鼠标路径走物理 Alt，不需要提示）。
+    if (typeof window !== "undefined" && window.innerWidth >= 600) return null;
+
+    // 控制点可能贴在屏幕边缘（块本身在视口边上）⇒ 夹住横向位置，否则提示会被裁掉。
+    const x = Math.min(Math.max(hint.clientX, 62), Math.max(62, window.innerWidth - 62));
+
+    const pill: React.CSSProperties = {
+        position: "absolute",
+        left: 0,
+        transform: "translateX(-50%)",
+        display: "inline-flex",
+        alignItems: "center",
+        gap: 5,
+        padding: "5px 10px",
+        borderRadius: 999,
+        border: "1px solid var(--qt-border, rgba(255,255,255,0.22))",
+        background: "var(--qt-window, #1b1b1f)",
+        color: "var(--qt-text, #e5e7eb)",
+        fontSize: 11,
+        lineHeight: 1,
+        whiteSpace: "nowrap",
+        boxShadow: "0 6px 18px rgba(0,0,0,0.5)",
+    };
+
+    return (
+        <div
+            data-hs-edge-longpress-hint
+            data-hs-edge-side={hint.side}
+            /* 🔴 2026-10-03（用户口径）：临时窗口要**盖住轨道头 / 拍数栏**
+               ⇒ 原来裸数字 27 与它们同档 ⇒ 改用设计令牌 `--hs-z-transient`（60）。
+               本层是 `position: fixed`，定位仍在视口坐标（不受令牌影响）。 */
+            style={{ position: "fixed", left: x, top: hint.clientY, zIndex: "var(--hs-z-transient)", pointerEvents: "none" }}
+        >
+            {/* 上划 = 淡入淡出时长（左控制点 = 淡入，右控制点 = 淡出） */}
+            <div data-hs-edge-hint="fade" style={{ ...pill, top: -54 }}>
+                <span aria-hidden style={{ opacity: 0.7 }}>
+                    ↑
+                </span>
+                <IconFade />
+                <span>{hint.side === "left" ? "淡入" : "淡出"}</span>
+            </div>
+            {/* 下划 = 变速缩放（等价电脑版 Alt 拖边缘） */}
+            <div data-hs-edge-hint="stretch" style={{ ...pill, top: 22 }}>
+                <span aria-hidden style={{ opacity: 0.7 }}>
+                    ↓
+                </span>
+                <IconStretch />
+                <span>变速</span>
+            </div>
+        </div>
+    );
+}
