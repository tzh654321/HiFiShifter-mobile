diff --git a/frontend/src/components/layout/longPressArbiter.ts b/frontend/src/components/layout/longPressArbiter.ts
new file mode 100644
index 00000000..0bd9ab3b
--- /dev/null
+++ b/frontend/src/components/layout/longPressArbiter.ts
@@ -0,0 +1,67 @@
+/**
+ * 长按仲裁（2026-10-02，用户口径）——
+ *
+ * > 「长按与长按并划动时常出现同时触发的情况，修法是长按操作**松手时才生效**
+ * >   （如调增益与轨道头长按菜单同时出现）」
+ *
+ * 现象成因（实测定位）：长按起手落在**轨道头的增益旋钮**上时，轨道排序的 `touchstart`
+ * 候选会**早退**（起手在交互控件上不参与排序）⇒ 它的 `touchHold` 恒为 `null`
+ * ⇒ 它的"拦下原生菜单、抬手再决定"那道闸门也失效；而 WebView 在长按约 500ms 时
+ * **照样**派发 `contextmenu` ⇒ **增益旋钮的拖动（260ms 已武装）与轨道菜单同时生效**。
+ *
+ * 本模块给"长按"类手势一个**全局互斥**：同一时刻只允许一个长按持有者
+ * （先用者占位，后来者 `begin` 返回 false ⇒ 直接放弃自己的长按）。
+ * 另外暴露 `longPressDragActive()` 给"菜单类"处理器：**只要有长按拖动在跑，就别弹菜单**。
+ *
+ * 设计取舍：
+ * - **以 `token` 认领**（`useRef({})` 或 `Symbol()`），不用 `pointerId` —— 本项目的长按
+ *   有 pointer 与原生 touch 两条路径，`pointerId` 在 `pointercancel` 之后不可靠；
+ *   token 只用于"能否安全释放"，不会把别人的锁清掉。
+ * - 单槽即可：这些都是单指手势，多点同时长按不是本项目的场景。
+ */
+
+type Kind = "menu" | "drag";
+
+let held: { token: object; kind: Kind } | null = null;
+
+/**
+ * 认领长按（应在**门槛定时器触发那一刻**调用，不是按下时）。
+ *
+ * @param token 持有者令牌（同一个对象才能释放）。
+ * @param kind `drag` = 长按并划动；`menu` = 长按不动。
+ * @returns false = 已有别人占着 ⇒ 调用方必须放弃自己的长按。
+ */
+export function beginLongPress(token: object, kind: Kind): boolean {
+    if (held !== null) return false;
+    held = { token, kind };
+    return true;
+}
+
+/** 释放（只有持有者本人能释放，避免误清别人的锁）。 */
+export function endLongPress(token: object): void {
+    if (held !== null && held.token === token) held = null;
+}
+
+/** 当前是否有"长按并划动"在跑 ⇒ 菜单类处理器据此闭嘴。 */
+export function longPressDragActive(): boolean {
+    return held !== null && held.kind === "drag";
+}
+
+/** 当前是否有任何长按在跑（调试/探针用）。 */
+export function longPressBusy(): boolean {
+    return held !== null;
+}
+
+/**
+ * 「起手是否落在交互控件上」——轨道排序/长按菜单都要用同一份判定。
+ *
+ * 之前这段选择器在 `TrackList` 里**抄了两份**（`onStart` 一份、别处一份），
+ * 抄漏一处就会出现"旋钮上按下去还被当成长按空白区"的重复触发。
+ */
+export const INTERACTIVE_TARGET_SELECTOR =
+    "button,[role='slider'],[role='button'],input,textarea,select,a,[data-hs-interactive]";
+
+export function isInteractiveTarget(target: EventTarget | null): boolean {
+    const el = target as HTMLElement | null;
+    return Boolean(el && typeof el.closest === "function" && el.closest(INTERACTIVE_TARGET_SELECTOR));
+}
diff --git a/frontend/src/components/layout/pianoRoll/VibratoAdjustOverlay.tsx b/frontend/src/components/layout/pianoRoll/VibratoAdjustOverlay.tsx
new file mode 100644
index 00000000..16f29ae7
--- /dev/null
+++ b/frontend/src/components/layout/pianoRoll/VibratoAdjustOverlay.tsx
@@ -0,0 +1,262 @@
+/**
+ * 直线/颤音：画完一条线后弹出的「波长 / 振幅」双滑条浮层（TASKS.md #7）。
+ *
+ * 用户口径：「直线/颤音 功能画完一条直线后，在直线对应位置旁 显示一横一纵两个滑动条，
+ * 横条调整波长，纵条调整振幅，点击空白处（**不包括**拍数栏、钢琴栏、上下工具栏、菜单栏）
+ * 确认以关闭滑动条」。
+ *
+ * 为什么需要它：颤音参数原本只有两条调节通道 —— **键盘修饰键**与**滚轮**
+ * （见 `vibratoDragAdjust.ts` 的 `VibratoAdjustTarget`）。手机上两者都没有，
+ * 所以线一画完振幅/波长就定死了。
+ *
+ * 实现上**刻意不新建后端通道**：调整时直接重算密集点再 `commitStroke` 覆盖，
+ * 复用上游既有的落盘路径（`buildVibratoDense` → `commitStroke`）。
+ */
+import React from "react";
+
+/* #53/#54：波长要换算成「秒」。换算基准是**参数曲线的帧周期**（5 ms/帧），
+   **不是采样率** —— 拿 48000 去除会小 240 倍（用户报的「显示 0.0649 s、
+   肉眼却十几秒」就是它）。常量出处见 `utils/timelineSnapping.ts`。 */
+import { DEFAULT_PARAM_FRAME_PERIOD_MS } from "../../../utils/timelineSnapping";
+
+export interface VibratoAdjustInfo {
+    /** 线覆盖的帧区间（含端点）。 */
+    startFrame: number;
+    endFrame: number;
+    /** 当前振幅 / 波长（频率）。 */
+    amplitude: number;
+    frequency: number;
+    /**
+     * 曲线帧周期（毫秒）。缺省 = `DEFAULT_PARAM_FRAME_PERIOD_MS`（5 ms/帧）。
+     * 只在多轨帧率不一致时才需要显式传（当前前端到处都按 5 处理）。
+     */
+    framePeriodMs?: number;
+    /** 浮层锚点：画完那一刻的指针位置（屏幕坐标）。 */
+    clientX: number;
+    clientY: number;
+}
+
+interface Props {
+    info: VibratoAdjustInfo;
+    /** 当前参数值域（振幅的单位就是它）。 */
+    range: { min: number; max: number };
+    /**
+     * 拖动中：把新的振幅/波长交给上层重算。
+     * `commit: false` 走节流预览；`commit: true`（松手/确认）立即落盘。
+     */
+    onChange: (next: { amplitude: number; frequency: number; commit?: boolean }) => void;
+    /** 保留：确认动作现在由外层「点击框外」触发（用户口径：去掉完成键）。 */
+    onClose?: () => void;
+}
+
+/** 波长（每个选区内的周期数）：`2π·freq·t` 里的 freq，1~2 个周期最常用。 */
+const FREQ_MIN = 0.2;
+const FREQ_MAX = 12;
+/**
+ * 振幅占值域的默认比例。上游 `vibratoStateRef` 的初值是 `amplitude: 0`，
+ * 只拖波长的话曲线还是直线 ⇒ 拖波长时若振幅为 0，自动补到这个比例，让变化立即可见。
+ */
+const AMP_AUTO_RATIO = 0.12;
+
+// 232：原先 196 装不下「标签26 + 滑条128 + 数值34 + 间隙」⇒ 数值出界。
+const PANEL_W = 232;
+const PANEL_H = 108;
+/** 浮层与指针的间距，避免盖住手指。 */
+const GAP = 14;
+
+export function VibratoAdjustOverlay({ info, range, onChange }: Props) {
+    /** 振幅上限 = 值域跨度的一半（再大就整体翻出可视区了）。 */
+    const ampMax = Math.max(0.01, (range.max - range.min) / 2);
+    /**
+     * 滑条是**线性位置**，但振幅要「下密上疏」：
+     * 用户口径「多数情况只会用到 2 以内，但偶尔会需要几十」。
+     * ⇒ 位置 t∈[0,1] 映射到值 `ampMax · t^k`（k=3）：
+     *   t=0.5 ⇒ 只有 ampMax/8 —— 一半的行程都用来精细调小值。
+     */
+    const AMP_CURVE_K = 3;
+    const SLIDER_STEPS = 1000; // 位置分辨率
+    const posToAmp = (pos: number) => ampMax * Math.pow(pos / SLIDER_STEPS, AMP_CURVE_K);
+    const ampToPos = (amp: number) =>
+        Math.round(SLIDER_STEPS * Math.pow(Math.max(0, amp) / ampMax, 1 / AMP_CURVE_K));
+    const autoAmp = Math.max(ampMax * 0.01, (range.max - range.min) * AMP_AUTO_RATIO);
+    // 锚点：优先放在指针**上方**（手指不会挡住）；顶上放不下就落到下方。
+    const [pos, setPos] = React.useState(() => {
+        const vw = window.innerWidth;
+        const vh = window.innerHeight;
+        let left = info.clientX - PANEL_W / 2;
+        left = Math.max(6, Math.min(left, vw - PANEL_W - 6));
+        let top = info.clientY - PANEL_H - GAP;
+        if (top < 6) top = Math.min(info.clientY + GAP, vh - PANEL_H - 6);
+        return { left, top };
+    });
+
+    React.useEffect(() => {
+        const vw = window.innerWidth;
+        const vh = window.innerHeight;
+        let left = info.clientX - PANEL_W / 2;
+        left = Math.max(6, Math.min(left, vw - PANEL_W - 6));
+        let top = info.clientY - PANEL_H - GAP;
+        if (top < 6) top = Math.min(info.clientY + GAP, vh - PANEL_H - 6);
+        setPos({ left, top });
+    }, [info.clientX, info.clientY]);
+
+    const stop = (e: React.SyntheticEvent) => e.stopPropagation();
+
+    /**
+     * 触摸友好的滑条：`<input type="range">` 在 WebView 里足够可靠，
+     * 且自带无障碍语义。`touch-action: none` 防止拖动时页面跟着滚
+     * （项目约定：触屏拖拽一律 touch-action: none）。
+     */
+    const slider = (
+        label: string,
+        value: number,
+        min: number,
+        max: number,
+        step: number,
+        onChangeValue: (v: number, commit: boolean) => void,
+        /** #53：数值的**显示**格式由调用方决定（单位不同），滑条本身只负责取值。 */
+        format: (v: number) => string,
+    ) => (
+        <div style={{ display: "flex", alignItems: "center", gap: 6 }}>
+            <span
+                style={{
+                    fontSize: 10.5,
+                    width: 26,
+                    flexShrink: 0,
+                    // 用户口径：「波长」「振幅」用主题色
+                    color: "var(--accent-9)",
+                    fontWeight: 600,
+                }}
+            >
+                {label}
+            </span>
+            <input
+                type="range"
+                min={min}
+                max={max}
+                step={step}
+                value={value}
+                aria-label={label}
+                // 拖动中（input）走节流预览；松手（change）立即落盘
+                onChange={(e) => onChangeValue(Number(e.target.value), false)}
+                onPointerUp={(e) => {
+                    stop(e);
+                    onChangeValue(Number((e.target as HTMLInputElement).value), true);
+                }}
+                onPointerDown={stop}
+                /* 用项目的 .qt-range：track=--qt-border、thumb=--accent-9（主题色）。
+                   不要用原生 accentColor —— 那个跟不上主题。 */
+                className="qt-range"
+                style={{
+                    flex: "1 1 auto",
+                    width: 128,
+                    touchAction: "none",
+                }}
+            />
+            <span
+                style={{
+                    fontSize: 10,
+                    width: 40,
+                    textAlign: "right",
+                    opacity: 0.65,
+                    flexShrink: 0,
+                    fontVariantNumeric: "tabular-nums",
+                }}
+            >
+                {format(value)}
+            </span>
+        </div>
+    );
+
+    return (
+        <div
+            role="group"
+            aria-label="颤音参数"
+            /* 浮层自身不参与「点空白关闭」的判定（见 PianoRollPanel 的判定逻辑）。 */
+            data-hs-vibrato-adjust="true"
+            className="fixed border border-qt-border"
+            style={{
+                left: pos.left,
+                top: pos.top,
+                width: PANEL_W,
+                zIndex: 60,
+                borderRadius: 10,
+                padding: "7px 9px",
+                /* 🔴 用户口径：「调完曲线需要预览音频再确认」⇒ 浮层底色必须透明，
+                   否则会挡住下面的波形/曲线，没法边调边看。只留边框 + 轻微阴影界定范围。 */
+                background: "transparent",
+                boxShadow: "0 6px 18px rgba(0,0,0,0.18)",
+                backdropFilter: "none",
+                userSelect: "none",
+                WebkitUserSelect: "none",
+            }}
+            onPointerDown={stop}
+            onPointerUp={stop}
+        >
+            {slider(
+                "波长",
+                info.frequency,
+                FREQ_MIN,
+                FREQ_MAX,
+                0.05,
+                (v, commit) =>
+                    onChange({
+                        // 🔴 拖波长时若振幅为 0，补一个可见的默认值 ——
+                        // 否则波形没有任何变化（用户实测报的就是这个）。
+                        amplitude: info.amplitude > 0 ? info.amplitude : autoAmp,
+                        frequency: v,
+                        commit,
+                    }),
+                /* #53 用户口径：波长要显示成「多少秒」。
+                 *
+                 * `frequency` 是「整条线里的周期数」（见 buildVibratoDense 里
+                 * `sin(2π·freq·t)`，t 是归一化进度，**不是秒**）⇒ 一个周期的秒数：
+                 *
+                 *     周期秒 = 线长秒数 / 周期数
+                 *
+                 * 🔴 **线长秒数必须按 `len` 算，不能用 `endFrame - startFrame`** ——
+                 * `buildVibratoDense` 里采样点是 `for (f = minF; f <= maxF; f++)`
+                 * ⇒ **实际有 `endFrame - startFrame + 1` 个帧**（闭区间含两端）。
+                 *
+                 * 🔴🔴 **帧 → 秒是 `帧 × framePeriodMs / 1000`（一帧 5 ms），
+                 * 不是 `帧 / 采样率`**。原先按 48000 除 ⇒ 比真值小 **240 倍**，
+                 * 用户报「曲线肉眼约 16 秒、读数却是 0.0649 s」就是它
+                 * （0.0649 × 240 ≈ 15.6 s）。别再用采样率，采样率在这里毫无关系。
+                 *
+                 * ⚠️ 显示成「秒」时跨度很大（几十毫秒 ~ 几十秒）⇒ 按量级切换小数位，
+                 * 数值栏只有 40px，`toFixed(4)` 在十几秒时会撑出去。
+                 */
+                (v) => {
+                    const len = Math.abs(info.endFrame - info.startFrame) + 1;
+                    const fp =
+                        info.framePeriodMs && info.framePeriodMs > 0
+                            ? info.framePeriodMs
+                            : DEFAULT_PARAM_FRAME_PERIOD_MS;
+                    const secs = (len * fp) / 1000;
+                    const period = v > 1e-6 ? secs / v : 0;
+                    if (period >= 10) return `${period.toFixed(1)} s`;
+                    if (period >= 1) return `${period.toFixed(2)} s`;
+                    return `${period.toFixed(3)} s`;
+                },
+            )}
+            {slider(
+                "振幅",
+                ampToPos(info.amplitude),
+                0,
+                SLIDER_STEPS,
+                1,
+                (pos, commit) =>
+                    onChange({
+                        amplitude: posToAmp(pos),
+                        frequency: info.frequency,
+                        commit,
+                    }),
+                /* #53 用户口径：**振幅不写单位** —— 直接给数值即可。
+                 * 振幅本身就是 pitch 参数值（见本文件 `range` 的注释），
+                 * 加「半音」只是把参数的内部单位暴露给用户，没必要。
+                 * 保留 `±`：那是**正负号语义**（波峰上下摆动的幅度），不是单位。 */
+                (pos) => `±${posToAmp(pos).toFixed(2)}`,
+            )}
+        </div>
+    );
+}
