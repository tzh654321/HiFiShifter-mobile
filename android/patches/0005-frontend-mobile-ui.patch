+                                                    </button>
+                                                );
+                                            })}
+                                        </>
+                                    );
+                                })()}
+                            </>
+                        );
+                    })()}
+                </div>
+            )}
+            <AppTooltipBubble
+                text={volumeTooltipText}
+                position={showVolumeTooltip ? volumeTooltipPos : null}
+            />
+        </Flex>
+    );
+};
