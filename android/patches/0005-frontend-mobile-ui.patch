diff --git a/frontend/src/hooks/useExitPresence.tsx b/frontend/src/hooks/useExitPresence.tsx
new file mode 100644
index 00000000..b21518ca
--- /dev/null
+++ b/frontend/src/hooks/useExitPresence.tsx
@@ -0,0 +1,160 @@
+/*
+ * E22 · 出场动画的「挂载闸门」（presence 状态机）—— 2026-10-01
+ *
+ * 由来：入场动画是纯 CSS（挂载即跑关键帧），出场却做不到 —— React 一旦把节点卸载，
+ * 就没有"动画期间"可言。所以这里补一个**最小的挂载闸门**：`open` 由 true → false 时
+ * 不立刻卸载，而是把**最后一次打开时的子树快照**多留一个出场时长，期间给节点打上
+ * `data-hs-leaving`，CSS 据此跑 `hs-menu-out` / `hs-fade-out`。
+ *
+ * ── 四条硬约束（都踩过/推演过，**别再简化掉**）────────────────────────────
+ *
+ * ① **快照，而不是"当前 children"**：关门那一下外部状态往往已经清空
+ *    （`openMenu = null`、`contextMenu = null`、`mobilePanels.x = false`…）。
+ *    若继续渲染当前 children，菜单会当场跳位（坐标变 0/undefined）、内容闪一下再淡出。
+ *    快照把"关门前的样子"冻住 ⇒ 淡出的是用户刚才看到的那个东西。
+ *
+ * ② **🔴 绝对不要再加 DOM 包装层**：本闸门一开始给子树套过一层
+ *    `div[data-hs-leaving-root]{display:contents}`（想让后代选择器兜住"组件子节点"）。
+ *    结果直接**打坏了分屏拖动** —— `App.tsx` 的 `paintRatio()` 是按
+ *    `container.children[0]/[1]` **直接改 flexGrow** 的（避免每帧整树重绘），
+ *    多出来的那层 `display: contents` 顶上后，flexGrow 写到了**没有盒子**的包装层上
+ *    ⇒ 拖动不再改变布局（真机 C5/C6 探针 2/5、读数 `h=0`）。
+ *    ⇒ 现在的做法：**普通元素**由 `cloneElement` 直接打属性；**组件**由组件自己把
+ *      `data-hs-leaving` 这个 prop 转到它的根节点上（`ClipContextMenu` /
+ *      `FadeContextMenu` / `VerticalDualPanel` / `ClipRateEditor*` 都是这么做的）。
+ *      新增"根是 `role="menu"` 的组件"时，**记得转发这个 prop**，否则出场动画静默失效。
+ *
+ * ③ **portal 要"拆开再标记"**：`createPortal()` 返回的 `$$typeof` 是 `react.portal`，
+ *    `React.isValidElement()` 判它为 false（只认 `react.element`）⇒ 无法 cloneElement，
+ *    且 portal 的 DOM 挂在 `document.body`、**不在** React 父节点的 DOM 里。
+ *    所以要把 portal 拆开、标记它的 children 之后再 `createPortal` 回去
+ *    （时间线的右键菜单就是这条路径）。
+ *
+ * ④ 尊重 `body[data-hs-no-anim]` 与 `prefers-reduced-motion` ⇒ **立即卸载**，
+ *    与改造前逐字节一致（也是探针的"无动画"对照组；用户嫌晃眼时也能一键退回旧行为）。
+ *
+ * ⚠️ 时长必须与 `index.css` 的 `--hs-anim-dur-out-*` **手工保持一致**（下面 `OUT_MS` 即契约）。
+ */
+import { useLayoutEffect, useRef, useState } from "react";
+import * as React from "react";
+import { createPortal } from "react-dom";
+
+export type ExitAnim = "menu" | "pane" | "bar";
+
+/** 与 index.css 的 `--hs-anim-dur-out-menu/pane/bar` 逐一对应。 */
+const OUT_MS: Record<ExitAnim, number> = {
+    menu: 120,
+    pane: 160,
+    bar: 130,
+};
+
+const animDisabled = (): boolean => {
+    if (typeof document !== "undefined" && document.body.hasAttribute("data-hs-no-anim")) return true;
+    if (typeof window === "undefined" || typeof window.matchMedia !== "function") return false;
+    return window.matchMedia("(prefers-reduced-motion: reduce)").matches;
+};
+
+type PortalLike = { $$typeof?: symbol; children?: React.ReactNode; containerInfo?: Element; key?: string | null };
+const asPortal = (node: React.ReactNode): PortalLike | null => {
+    if (node === null || typeof node !== "object") return null;
+    const p = node as PortalLike;
+    return p.$$typeof === Symbol.for("react.portal") ? p : null;
+};
+
+/**
+ * 给快照里的**每个元素节点**打上 `data-hs-leaving`（Fragment 无属性位 ⇒ 向下递归；
+ * 数组逐项处理）。打在整个子树上是有意的：菜单的透明遮罩（backdrop 按钮）也在 children 里，
+ * 它同样需要"离开期间不吃点击"。
+ * 组件节点会被打上同名 **prop** —— 组件负责转到自己的根节点（见文件头约束②）。
+ */
+const markLeaving = (node: React.ReactNode): React.ReactNode => {
+    if (Array.isArray(node)) return node.map(markLeaving);
+    if (!React.isValidElement(node)) return node;
+    const el = node as React.ReactElement<{ children?: React.ReactNode }>;
+    if (el.type === React.Fragment) {
+        return React.cloneElement(el, { children: markLeaving(el.props.children) });
+    }
+    return React.cloneElement(el as React.ReactElement<{ "data-hs-leaving"?: string }>, {
+        "data-hs-leaving": "",
+    });
+};
+
+interface ExitPresenceProps {
+    /** 目标是否应当在场。false 时进入"离开"阶段（延迟 `OUT_MS[anim]` 后真正卸载）。 */
+    open: boolean;
+    anim?: ExitAnim;
+    children: React.ReactNode;
+}
+
+/**
+ * 用法：把原来的 `{cond ? <X/> : null}` 换成 `<ExitPresence open={cond}><X/></ExitPresence>`。
+ * children 要**无条件构造**（元素构造本身不渲染，零成本），闸门才有机会接管那次卸载。
+ */
+export function ExitPresence({ open, anim = "pane", children }: ExitPresenceProps): React.ReactElement {
+    /* 只用一个状态：**还挂着没有**。"正在离开"= `mounted && !open`，不需要第二个变量。 */
+    const [mounted, setMounted] = useState(open);
+    const snapshot = useRef<React.ReactNode>(children);
+
+    if (open) snapshot.current = children;
+
+    /* `useLayoutEffect` 而不是 `useEffect`：关闭那一帧要在**上屏之前**就把标记决定好 ——
+       否则会先画一帧"关掉的旧 UI"（动效关闭时更明显：那一帧就是纯残留）。 */
+    useLayoutEffect(() => {
+        if (open) {
+            setMounted(true);
+            return;
+        }
+        if (!mounted) return;
+        if (animDisabled()) {
+            /* 立即卸载：与改造前逐字节一致（探针的"无动画"对照组走这里） */
+            setMounted(false);
+            return;
+        }
+        const timer = window.setTimeout(() => setMounted(false), OUT_MS[anim]);
+        return () => window.clearTimeout(timer);
+    }, [open, mounted, anim]);
+
+    /* 关闭且已过出场时长 ⇒ 彻底不渲染（真正的那次卸载） */
+    if (!open && !mounted) return <></>;
+
+    /* ③：portal ⇒ 拆开、标记它的 children、再 portal 回去。
+       `snapshot.current` 在 open 期间恒等于 `children` ⇒ 两相走同一分支，结构稳定。 */
+    const portal = asPortal(snapshot.current);
+    if (portal) {
+        return createPortal(
+            open ? portal.children : markLeaving(portal.children),
+            portal.containerInfo as Element,
+            portal.key ?? undefined,
+        ) as unknown as React.ReactElement;
+    }
+
+    return <>{open ? children : markLeaving(snapshot.current)}</>;
+}
+
+/**
+ * 布局也"等出场走完"：`true` 立即生效，`false` 滞后 `ms`（默认与 `anim="pane"` 同长）。
+ *
+ * 为什么必须滞后：分屏是**两块按 `flexGrow` 分高**的。面板一关，另一块的 `flexGrow`
+ * 立刻从 `1 - ratio` 变成 `1` ⇒ 正在淡出的那块被**当场压扁**（真机实测 252px → 177px），
+ * 淡出期间内容还会按新高度重排一次。把"布局用的标志"滞后一个出场时长，
+ * 就是"先淡完、再收起来"（与 `ExitPresence` 保留快照的时长同源）。
+ *
+ * ⚠️ 只用于**布局计算**（`flexGrow` 之类），**不要**拿它当面板显隐的闸门 ——
+ * 显隐仍由 `ExitPresence` 的 `open` 决定，两者各管一段。
+ */
+export function useExitLayoutLag(flag: boolean, ms: number = OUT_MS.pane): boolean {
+    const [lagged, setLagged] = useState(flag);
+    useLayoutEffect(() => {
+        if (flag) {
+            setLagged(true);
+            return;
+        }
+        if (animDisabled()) {
+            setLagged(false);
+            return;
+        }
+        const timer = window.setTimeout(() => setLagged(false), ms);
+        return () => window.clearTimeout(timer);
+    }, [flag, ms]);
+    return flag ? true : lagged;
+}
