+                    // 固定浮层 + 从参数工具行下方开始 + 内部滚动，才能保证每一项都可见可点。
+                    position: "fixed",
+                    // 顶栏 44 + 参数工具行 40 + 4 间距
+                    top: 88,
+                    left: 4,
+                    right: 4,
+                    maxHeight: "calc(100vh - 196px)", // 再留出底栏 40 + 页签 56
+                    overflowY: "auto",
+                    zIndex: 41,
