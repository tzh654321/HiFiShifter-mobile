+}
+
+function App() {
+    return (
+        <PitchAnalysisProvider>
+            <PianoRollStatusProvider>
+                <AppInner />
+            </PianoRollStatusProvider>
+        </PitchAnalysisProvider>
+    );
+}
+
+export default App;
+
+/**
+ * E1/E21 的浮层宿主。
+ *
+ * 为什么要单独一个组件：直接把这些 state 放进 `MobileTopBar` 时，一点菜单项就整页卡死
+ * （排查见 docs/TASKS.md：shallowEqual、简化控件、自绘浮层都试过，仍卡 ⇒ 问题在 MobileTopBar 里
+ * setState 后的大重渲）。改成菜单项**派发窗口事件**、这里监听并渲染，就绕开了那条路径。
+ */
+function SettingsOverlays() {
+    const [projectOpen, setProjectOpen] = useState(false);
+    const [storageOpen, setStorageOpen] = useState(false);
+    /* G-2：^ 菜单里「吸附网格…」「分割过渡…」的长按 ⇒ 打开**原版那套**设置对话框。 */
+    const [snapGridOpen, setSnapGridOpen] = useState(false);
+    const [splitTransitionOpen, setSplitTransitionOpen] = useState(false);
+    /** 节拍器长按菜单（音量/细分/音色/强调重拍）。 */
+    const [metronomeOpen, setMetronomeOpen] = useState(false);
+    useEffect(() => {
+        const onOpen = (e: Event) => {
+            const which = (e as CustomEvent<{ which?: string }>).detail?.which;
+            if (which === "project") setProjectOpen(true);
+            else if (which === "storage") setStorageOpen(true);
+            else if (which === "snap-grid") setSnapGridOpen(true);
+            else if (which === "split-transition") setSplitTransitionOpen(true);
+            else if (which === "metronome") setMetronomeOpen(true);
+        };
+        window.addEventListener("hs-open-settings", onOpen);
+        return () => window.removeEventListener("hs-open-settings", onOpen);
+    }, []);
+    return (
+        <>
+            <ProjectSettingsDialog open={projectOpen} onOpenChange={setProjectOpen} />
+            <StorageSettingsDialog open={storageOpen} onOpenChange={setStorageOpen} />
+            <SnapGridSettingsDialog open={snapGridOpen} onOpenChange={setSnapGridOpen} />
+            <MetronomeSettingsOverlay open={metronomeOpen} onOpenChange={setMetronomeOpen} />
+            <SplitTransitionSettingsDialog
+                open={splitTransitionOpen}
+                onOpenChange={setSplitTransitionOpen}
+            />
+        </>
+    );
+}
