+                minHeight: 34,
+                minWidth: 44,
+                display: "inline-flex",
+                alignItems: "center",
+                justifyContent: "center",
+                borderRadius: 999,
+                border: `1px solid ${on ? "transparent" : "var(--qt-border, rgba(255,255,255,0.18))"}`,
+                color: on ? "var(--white-a12, #fff)" : "var(--accent-11, rgb(177, 169, 255))",
+                background: on ? "var(--accent-9, rgb(91, 91, 214))" : "transparent",
+                WebkitTapHighlightColor: "transparent",
