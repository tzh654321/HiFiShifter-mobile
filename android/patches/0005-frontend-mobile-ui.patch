+                    const shiftRangeAnchorClipId = doShiftRangeSelect
+                        ? rangeSelectAnchorClipId
+                        : null;
+                    const doCtrlToggleOnly = selectionMods.multiSelectToggleActive;
+                    const shouldPrimeSelection = selectionMods.shouldPrimeSelection;
