+    .rt-IconButton.rt-r-size-1::after {
+        content: "";
+        position: absolute;
+        left: -6px;
+        right: -6px;
+        top: -12px;
+        bottom: -12px;
+    }
+    [data-track-volume-knob] {
+        position: relative;
+    }
+    [data-track-volume-knob]::after {
+        content: "";
+        position: absolute;
+        inset: -6px;
+    }
+}
+
+/* ── 触摸目标与「横排工具行不许被 flex 压扁」（<1280px 统一，docs/04 §17）────
+   2026-09-22 起手机与平板共用一套布局，所以这组规则也统一到 1279px（原来只给
+   600–1279 的平板）。手机那条 `@media (max-width: 1279px)` 是把参数工具行
+   **整个隐藏**（功能搬进底栏 ∧ 浮层），两条规则不冲突：隐藏优先，剩下的可横滚。
+
+   实测（2026-09-20，CSS 800×1176，模拟器）：
+   · `.hs-param-head` 被 flex 压成 **109×80** 的窄柱，「参考轨道组 / 平滑度:」竖排成单字
+   · `.hs-param-toolbar`（675×32）里「共振峰/气声/张力/音量/声像」底部被裁 */
+@media (max-width: 1279px) {
+    /* 这两行（参数面板头部）整行可横滚，子块一律**不压缩**。
+       根因：`.hs-param-head` 带 `flex: 1 1 auto; min-width: 0`，800px 下被压到 109px，
+       其内容（含「平滑度」range 滑条）溢出到右侧工具栏上面 —— 实测滑条 120×14 里有
+       63px 被「参考轨道组」按钮盖住，只剩 57px 能拖。这正是用户报的
+       「参数界面滑条划动只能小幅划动」（2026-09-20 定位；上一轮误判为自绘滚动条）。 */
+    .hs-param-rows {
+        overflow-x: auto;
+        overflow-y: hidden;
+    }
+    .hs-param-head {
+        flex: 0 0 auto !important;
+        min-width: max-content !important;
+    }
+    .hs-param-head,
+    .hs-param-toolbar {
+        flex-wrap: nowrap;
+    }
+    .hs-param-head > *,
+    .hs-param-toolbar > * {
+        flex-shrink: 0;
+    }
+    .hs-param-toolbar button,
+    .hs-param-toolbar .param-pill,
+    .hs-param-head span,
+    .hs-param-head button {
+        white-space: nowrap;
+    }
+    /* 「平滑度」滑条命中区：视觉仍是 4px 槽 + 12px 滑块（槽/滑块由伪元素绘制，
+       与 input 自身高度无关——Chrome 把它们在 input 内垂直居中），但把 input 的
+       盒子从 14px 加到 28px，手指好抓。这是用户「滑条只能小幅划动」的第二半：
+       上一半是它被相邻按钮盖住（见上）。 */
+    .hs-param-head input.qt-range {
+        height: 28px;
+    }
+    /* 桌面工具栏（ActionBar）是按鼠标设计的：行高 32px，里面是 22–24px 的输入框/
+       下拉/图标按钮。平板也是手指操作，把整行抬到 44px、内部控件抬到 36px ——
+       图标视觉不变（ghost 无底色），但输入框/下拉的**可点区域**从 22px 变成 36px。
+       桌面（≥1280）不受影响。 */
+    .hs-actionbar {
+        height: 44px;
+    }
+    .hs-actionbar .rt-TextFieldInput,
+    .hs-actionbar .rt-SelectTrigger,
+    .hs-actionbar .rt-IconButton {
+        min-height: 36px;
+    }
+    /* 触摸目标：Radix size-1 图标按钮视觉 24px，用伪元素把命中区外扩到 44px。
+       数值与手机一致 —— 横向只外扩 6px，避免相邻按钮命中区互相覆盖。 */
+    .rt-IconButton.rt-r-size-1 {
+        position: relative;
+    }
+    .rt-IconButton.rt-r-size-1::after {
+        content: "";
+        position: absolute;
+        left: -6px;
+        right: -6px;
+        top: -12px;
+        bottom: -12px;
+    }
+}
+
+/* 手机按钮按压反馈（对齐原版 Radix 按钮的按压语义：按下整体变暗一档） */
+.hs-icon-btn:active {
+    filter: brightness(0.88);
+}
+
+/* 底栏按钮（MobileBottomBar）：命中区 40px、视觉 28px 的「内盒子」，
+   按压效果作用在内盒子上（与原版 IconButton 的按压变暗一致）。 */
+.hs-bar-btn:active .hs-bar-vis {
+    filter: brightness(0.88);
+}
+
+/* 无键盘设备上，长按/右键菜单里的快捷键列（Ctrl+C 等）是噪音 —— 隐藏。
+   覆盖两种菜单容器：Radix popper 版 与 EditContextMenu 的 fixed z-[9999] 版；
+   只命中各自容器内的 10px 灰字（shortcutClass），不影响其它位置的 10px 文本。
+   2026-09-22：断点随形态统一放宽到 1279px（平板也是触屏，同样无键盘）。 */
+@media (max-width: 1279px) {
+    [data-radix-popper-content-wrapper] span.text-\[10px\],
+    div.z-\[9999\] span.text-\[10px\] {
+        display: none;
+    }
+}
+
+/* ═══════════════════════════════════════════════════════════
+ * 外观设置面板（应用内嵌入模式，Android）—— 触摸目标口径
+ * ═══════════════════════════════════════════════════════════
+ * 面板本体是上游为**桌面独立窗口**写的（1421 行，控件全按鼠标口径排）。原样嵌进手机后
+ * 实测（`scripts/_probe-appearance.mjs`）：面板内 51 个可点元素里 **46 个**触摸目标 < 40px
+ * —— 分段 Tab 高 29、导入/导出高 31、调色板色块 24×24。
+ *
+ * 这里只按 `[data-hs-appearance-root="embedded"]` 收口，桌面窗口一行都不受影响。
+ * 刻意**不用媒体查询**：800px 宽的平板同样需要抬起命中区，而 599px 的断点会漏掉它。
+ */
+/* 「内框」：面板内容与卡片描边之间留一点空隙（2026-09-22 用户口径：屏幕边界 / 外框 /
+   内框各留一点）。外框（inset 8px + 圆角 + 描边）在 `AppearanceSettingsDialog.tsx` 里，
+   桌面独立窗口不带 `embedded` 属性，因此完全不受影响。 */
+[data-hs-appearance-root="embedded"] {
+    padding: 6px;
+}
+
+[data-hs-appearance-root="embedded"] button,
+[data-hs-appearance-root="embedded"] input,
+[data-hs-appearance-root="embedded"] select {
+    min-height: 40px;
+}
+
+/* ═══════════════════════════════════════════════════════════
+ * 对话框不许超出视口（2026-09-22）
+ * ═══════════════════════════════════════════════════════════
+ * 用户报「许多窗口宽度会超过屏幕，如导出音频」。上游那些对话框是按桌面排的
+ * （固定 `min-width` / `width`，如 `ExportAudioDialog`），360px 的手机上直接溢出屏幕，
+ * 左右两边各被切掉一截、按钮点不到。
+ *
+ * 这里对**所有** Radix Dialog 内容统一兜底（不动各自对话框的内部排版），
+ * 并且只作用于 <1280px —— desktop 保持原样。刻意**不加** `overflow: auto`：
+ * 各处对话框自己已经有滚动容器，这里再加一层会出现双滚动条。
+ * 外观面板的 `inset: 8` 与这里的 16px 正好是同一圈，两边不打架。 */
+@media (max-width: 1279px) {
+    [role="dialog"] {
+        max-width: calc(100vw - 16px) !important;
+        max-height: calc(100dvh - 16px) !important;
+    }
+}
+
+/* 调色板色块是**定边长的方按钮**：必须先给足宽高再谈最小高度，
+   否则上面的 `min-height: 40px` 会把它拉成 24×40 的长条。
+   视觉边长取 32（原 24）而不是 40：色块是成片密排的网格，抬到 40 会让调色板多出一倍行数。 */
+[data-hs-appearance-root="embedded"] button.w-6.h-6 {
+    width: 32px;
+    height: 32px;
+    min-height: 32px;
+    position: relative;
+}
+
+/* 再用伪元素把**命中区**补到 40×40，视觉仍保持 32。
+   色块的父容器是 `flex flex-wrap gap-1`（间距 4px），所以横向外扩 4px 与邻居**正好相切**、
+   不会互相偷点击 —— 与主界面那条「横向只扩 ±6px」的规矩同源（`docs/04 §5`）。 */
+[data-hs-appearance-root="embedded"] button.w-6.h-6::after {
+    content: "";
+    position: absolute;
+    inset: -4px;
+}
+
+/* 原生取色器（`input[type=color]`）是 `absolute inset-0` 盖在父容器上的，
+   自身尺寸完全等于父尺寸 ⇒ 要撑的是**父**（实测 20×40，宽度差一半）。 */
+[data-hs-appearance-root="embedded"] .relative.shrink-0:has(> input[type="color"]) {
+    min-width: 40px;
+}
+
+/* B1：参数药丸的前置图标（气声音量等）——与 label 同一行、垂直居中。 */
+.param-pill__leading-icon {
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    margin-right: 3px;
+    /* 跟随 label 的文字色（状态由右侧开关的强调色表达） */
+    color: currentColor;
+    flex-shrink: 0;
+}
+
+/* E24-①（2026-10-01）**工具菜单统一外壳**：`选择` 与 `绘制` 两套菜单共用这一份样式。
+ * 此前「选择」用类、`绘制` 用内联样式（字号/圆角/条目高/选中态/有无 ✔ 都不一样）⇒ 用户口径
+ * 「统一 选择 与 绘制 的菜单」。旧类名 `.hs-select-tool-menu*` 保留为**别名**（老探针还用着）。 */
+.hs-tool-menu,
+.hs-select-tool-menu {
+    display: flex;
+    flex-direction: column;
+    min-width: 112px;
+    padding: 4px;
+    border-radius: 8px;
+    border: 1px solid var(--qt-border);
+    background: var(--qt-window);
+    box-shadow: 0 8px 22px rgba(0, 0, 0, 0.28);
+    gap: 2px;
+}
+.hs-tool-menu__item,
+.hs-select-tool-menu__item {
+    display: flex;
+    align-items: center;
+    gap: 7px;
+    min-height: 34px;
+    padding: 7px 9px;
+    border: 0;
+    border-radius: 6px;
+    background: transparent;
+    color: var(--qt-text);
+    /* E36（#8）：工具菜单（选择/绘制）原来写死 12px，而手机顶栏菜单 13.5、底栏参数菜单 13
+       ⇒ 三个"同一家的菜单"三种字号。统一走令牌（13.5px）。 */
+    font-size: var(--hs-font-menu-item);
+    line-height: 1;
+    text-align: left;
+    cursor: pointer;
+}
+.hs-tool-menu__item:hover,
+.hs-select-tool-menu__item:hover {
+    background: color-mix(in oklab, var(--accent-9) 16%, transparent);
+}
+.hs-tool-menu__item[data-active="true"],
+.hs-select-tool-menu__item[data-active="true"] {
+    background: var(--accent-9);
+    color: var(--accent-contrast, #fff);
+}
+/* 标签占满剩余宽度 ⇒ ✔ 永远贴右边（两份菜单同款，条目再长也不会挤走勾） */
+.hs-tool-menu__label {
+    flex: 1 1 auto;
+}
+
+/*
+ * D1：参数工具行的按钮间距收紧。
+ *
+ * ⚠️ 不改 `BTN_BOX`（40px 是用户定过的**命中区下限**）——
+ * 这里用负 margin 只让元素框视觉重叠 4px，实际 width/height 不变，
+ * 所以命中区仍是 40px，手指按起来不缩水。
+ * 省下 8 个间隙 × 4px = 32px，让最右侧的「下移」不再贴屏幕边。
+ */
+.hs-param-toolrow .hs-bar-btn {
+    margin-inline: -2px;
+}
+
+/*
+ * 用户口径：D1 的 5 个选区编辑按钮**不进入 v 菜单**。
+ *
+ * 手机的 ∨ 菜单是把参数行整块重排成竖排浮层（往 body 打
+ * `data-hs-param-menu="open"`，见 docs/01 与此文件里的 .hs-param-rows 规则）。
+ * 编辑按钮加在工具行上，菜单一开就会跟着冒出来 ⇒ 这里在菜单打开时隐藏它们。
+ */
+body[data-hs-param-menu="open"] .hs-param-toolrow .hs-edit-btn {
+    /* ⚠️ 必须 !important：`BarButton` 的 display 是**内联样式**，优先级高于类选择器。 */
+    display: none !important;
+}
+
+/*
+ * E 组（flm 交互表，轨道头列）：**左划隐藏轨道头**（再左划一次展开）。
+ *
+ * 状态放在 `body` 属性上而不是 redux —— 纯展示开关，没有别处要读它；
+ * 以后若要暴露到菜单，再提升到 redux。
+ *
+ * ⚠️ 2026-09-26 修正：原为 `display: none`（整列藏掉）—— 过头了。
+ * 规格表写的是「左划隐藏轨道头，**只留轨道颜色线与电平条**，右划再展开」，
+ * 即收窄成一条窄边，保留颜色识别与电平指示。
+ *
+ * ⚠️ 2026-09-27 再修正（用户 TASKS.md C1）：收窄后**画面不对** —— 空灰框还在、
+ * 轨道区没跟着扩大。两条原因都在这里：
+ *   ① `[data-track-list-panel]` 只是"轨道头列表"的**滚动容器**，它上面还有一层
+ *      `TrackList` 的**外壳**（宽度由 flex 基线决定）既没被收窄也没被隐藏 ⇒
+ *      收窄的只是内层，外层仍占着原宽度，于是屏幕上留下一个**空的灰框**；
+ *   ② 时间线容器（`[data-timeline-scroller]`）的宽度由那个外壳的 flex 决定，
+ *      外壳没收 ⇒ 轨道区不会变宽。
+ * 修法：把同一组收窄规则**同时应用到外壳**（用 `:has(> [data-track-list-panel])`
+ * 选中它 —— 外壳没有专门的属性可用），并把内层面板的宽度让给时间线。
+ */
+/* 🔴 同一个"收窄"要作用在两个不同轴上，**弹性声明必须分开写**（2026-10-02 修的，
+   之前合在一起写 `flex: 0 0 auto` ⇒ 列表高度塌陷，用户口径「轨道头缩回…轨道与轨道头
+   没对齐高度」）：
+   · 内层 `[data-track-list-panel]`（列表本身）的父是 **column** 弹性盒
+     ⇒ `flex-basis` / `flex-grow` 管的是**高度**，所以**一个字都不能写**：
+     写 `flex: 0 0 26px` 会把列表压成 26px 高；写 `flex: 0 0 auto` 则把 `flex-1` 的
+     「撑满剩余高度」抹掉 ⇒ 高度塌成**内容高**（实测 284 → 112px，下方空出 172px），
+     轨道头列表区比右侧轨道区矮 ⇒ **纵向错位** —— 这正是用户报的那条。
+     宽度不用管 flex：它是交叉轴，由下面的 width/min/max 决定。
+     所以给回 `flex: 1 1 0%`（= 原来的 `flex-1`），只收宽度。
+   · 外壳 `div:has(> [data-track-list-panel])` 的父是 **row** 弹性盒
+     ⇒ `flex-basis` 管的是**宽度**，且它是"整条轨道头列"，**必须 `grow: 0`**
+     才不会去和时间线抢宽度。这里保留 `flex: 0 0 auto`（basis auto + width 26px ⇒ 26px 宽 ✓）。
+   ⚠️ 两者**不能互换**：外壳写成 `1 1 0%` 会与时间线平分宽度（各占一半），
+   内层写成 `0 0 auto` 就是本轮这个高度塌陷。 */
+body[data-hs-header-collapsed="1"] [data-track-list-panel] {
+    width: 26px !important;
+    min-width: 26px !important;
+    max-width: 26px !important;
+    /* = `flex-1`：撑满外壳里的剩余高度（与展开态逐像素一致）。 */
+    flex: 1 1 0% !important;
+    overflow: hidden;
+}
+body[data-hs-header-collapsed="1"] div:has(> [data-track-list-panel]) {
+    width: 26px !important;
+    min-width: 26px !important;
+    max-width: 26px !important;
+    /* 外壳 = 整条轨道头列，它的父（`[data-hs-surface="timeline"]`）是 **row**
+       ⇒ 这里的 flex-basis 管**宽度**。必须 `grow: 0`，否则会去和时间线抢宽度
+       （实测写成 `1 1 0%` 时两边各占一半）。宽度本身由上面 width/min/max 给定。 */
+    flex: 0 0 auto !important;
+    overflow: hidden;
+}
+
+/* 窄条里只留色块（颜色圆点 / 电平条）—— 文字与输入框让位。
+   ⚠️ **按钮不能全隐藏**：颜色圆点本身就是 button（实测 32×32），
+   藏掉按钮就没有颜色识别了；超出宽度的部分交给 overflow:hidden 裁。 */
+body[data-hs-header-collapsed="1"] [data-track-list-panel] .rt-Text,
+body[data-hs-header-collapsed="1"] [data-track-list-panel] input {
+    display: none !important;
+}
+
+/* 收起轨道头时（用户 E3，**覆盖 C2 的旧做法**）：
+   **只隐藏左上角的「拍数/秒数」读数**，但**保留这一行及其高度**，也保留其中的
+   速度映射键（✕ 是 App 层绝对定位的，本来就不在这一行里）。
+   ⚠️ 为什么不能整行 `display: none`：那一行有 `headerHeight` 的高度，
+   藏掉之后轨道行整体上移 ⇒ **轨道头与轨道不再对齐**（用户实测反馈）。
+   旧做法（C2）当时是为了"只留 ✕"，但代价是对齐崩掉 —— 现在按用户口径改。 */
+body[data-hs-header-collapsed="1"] [data-hs-tracklist-head-bar] .hs-tracklist-title,
+body[data-hs-header-collapsed="1"] [data-hs-tracklist-head-bar] [data-hs-tracklist-readout] {
+    display: none !important;
+}
+/* 这一行在窄条里要收紧内边距，避免速度映射键被裁掉。 */
+body[data-hs-header-collapsed="1"] [data-hs-tracklist-head-bar] {
+    padding-left: 2px !important;
+    padding-right: 2px !important;
+    gap: 0 !important;
+}
+
+/*
+ * 窄条里「只剩颜色线与电平条」（规格原文，用户 C1：「缩小后电平条被遮挡」）。
+ *
+ * 实测（`scripts/_dbg-header-collapse.mjs`，收起到 26px 时）：
+ *   `[data-hs-meter]` 的矩形是 `left=38, w=26` —— 行内**先**排着颜色圆点 + M/S
+ *   按钮 + 名称，26px 的窄条在 x=26 处就裁断了，电平条整条落在可视区之外（= "被遮挡"）。
+ * 所以收窄时不能再靠"横向排列 + overflow 裁"，要**改布局**：
+ *   · 颜色圆点被接管成贴左缘的 **4px 竖条**（它就是"轨道颜色线"，背景色是内联的）；
+ *   · 电平条绝对定位到竖条右侧，铺满剩余宽度（26 − 4 = 22px，够画峰值条）；
+ *   · 行内其余按钮 / 文本全部让位（收窄状态下它们本就没有可点空间）。
+ * 两者都用 `position: absolute` —— 行本身是 `relative`，行高不变（与时间线对齐是硬约束）。
+ */
+body[data-hs-header-collapsed="1"] [data-track-list-panel] [data-hs-track-row] {
+    padding: 0 !important;
+}
+body[data-hs-header-collapsed="1"]
+    [data-track-list-panel]
+    [data-hs-track-row]
+    [data-track-color-picker] {
+    position: absolute !important;
+    left: 0 !important;
+    top: 0 !important;
+    bottom: 0 !important;
+    width: 4px !important;
+    max-width: 4px !important;
+    z-index: 2;
+    /* 收窄态里它只是"颜色线"这一条**装饰**，不该抢触摸：
+       ⚠️ 实测教训——不给 `pointer-events: none` 时，窄条内的右划展开会失效
+       （触摸落在电平条 / 色条的盒子上，`TrackList` 那边的原生 touch 判定拿不到），
+       而"左划收起 / 右划展开"的手势正是挂在轨道列容器上的原生 touch 监听。 */
+    pointer-events: none !important;
+}
+body[data-hs-header-collapsed="1"]
+    [data-track-list-panel]
+    [data-hs-track-row]
+    [data-track-color-picker]
+    > button {
+    width: 100% !important;
+    height: 100% !important;
+    border-radius: 0 !important;
+    border: none !important;
+}
+body[data-hs-header-collapsed="1"] [data-track-list-panel] [data-hs-meter] {
+    position: absolute !important;
+    left: 4px !important;
+    right: 0 !important;
+    top: 0 !important;
+    bottom: 0 !important;
+    width: auto !important;
+    min-width: 0 !important;
+    max-width: none !important;
+    /* 同上：收窄态的电平条只是指示灯，触摸要能穿过去到轨道列容器。 */
+    pointer-events: none !important;
+}
+/* 其余按钮（M/S、旋钮、算法下拉…）在 26px 里没有落点，让位。
+   ⚠️ 颜色圆点必须排除在外：它就是"轨道颜色线"的来源。 */
+body[data-hs-header-collapsed="1"]
+    [data-track-list-panel]
+    [data-hs-track-row]
+    button:not([data-track-color-picker] > button) {
+    display: none !important;
+}
+
+/*
+ * E 组（音频块头尾控制点）：「长按 ⇒ 变速缩放」的**视觉提示**。
+ *
+ * `ClipEdgeHandles` 在长按达 500ms 时给控制点打 `data-hs-edge-long-press="1"`
+ * —— 这里据此高亮边缘并浮出「变速」字样。
+ *
+ * ⚠️ 规格原文是「下方出现**变速缩放图标**」；图标待画，当前先用文字气泡顶上。
+ *    用伪元素而非新增 DOM：控制点是绝对定位的细条，加子元素会改变它的命中区。
+ */
+[data-hs-edge-long-press="1"] {
+    box-shadow: inset 0 0 0 2px rgb(96 165 250 / 0.9);
+}
+[data-hs-edge-long-press="1"]::after {
+    content: "变速";
+    position: absolute;
+    top: 50%;
+    transform: translateY(-50%);
+    white-space: nowrap;
+    font-size: 10px;
+    line-height: 1;
+    padding: 3px 5px;
+    border-radius: 4px;
+    background: rgb(37 99 235);
+    color: #fff;
+    pointer-events: none;
+    z-index: 70;
+}
+
+/*
+ * #15：参数界面的关闭键（左上角 X）—— **只在手机显示**。
+ * 平板上参数行常显，没有"关闭"语义。
+ * 用 CSS 控制而不是 JS 判断：横竖屏切换时会自动跟上。
+ */
+.hs-param-close {
+    display: none;
+}
+@media (max-width: 599px) {
+    .hs-param-close {
+        display: inline-flex;
+    }
+    /* D1（用户口径「快捷键提示没删干净」）：**手机上不显示任何键盘快捷键提示**。
+       手机没有物理键盘，菜单里那些 `Ctrl+T` / `Ctrl+C` / `Ctrl+Delete` 只是噪音，
+       还把菜单项撑宽。给所有"快捷键提示"元素统一打 `hs-menu-shortcut`：
+         · `TrackList` 长按轨道菜单的 添加 / 克隆 / 删除 三项；
+         · `ClipContextMenu`（音频块右键菜单）；
+         · `EditContextMenu`（编辑菜单）。
+       ⚠️ 只隐藏**提示**，不动菜单项本身（`TimeRuler` 里那个同样样式的是"✓ 当前项"
+       标记，不是快捷键，**没有**打这个类，别误伤）。 */
+    .hs-menu-shortcut {
+        display: none !important;
+    }
+}
+
+/*
+ * #15/#16：分屏各面板的关闭键（**左上角**，用户口径）。
+ *
+ * 【用户三条要求】
+ * 1. 位置 = **左上角**；
+ * 2. **无底色、无边框**（裸 ✕）；
+ * 3. **任何菜单打开时不得挡在前面** —— 视觉与触控都要让开。
+ */
+.hs-panel-close {
+    position: absolute;
+    top: 2px;
+    left: 2px;
+    /* ⚠️ z-index 只到 20：浮层菜单（Radix portal 到 body）远高于它，
+       且绝不能用大值去压菜单 —— 用户要求"不挡在前面"。 */
+    z-index: 20;
+    width: 24px;
+    height: 24px;
+    display: inline-flex;
+    align-items: center;
+    justify-content: center;
+    /* 2. 无底色、无边框。 */
+    background: transparent;
+    border: none;
+    border-radius: 4px;
+    padding: 0;
+    font-size: 13px;
+    line-height: 1;
+    /* 半透明：不抢内容视线，但可见。 */
+    color: rgb(229 231 235 / 0.75);
+    /* 触屏点击不要被浏览器手势吃掉。 */
+    touch-action: none;
+    cursor: pointer;
+}
+.hs-panel-close:active {
+    color: #fff;
+}
+/*
+ * 3. **菜单打开时让开**（视觉 + 触控）。
+ *    Radix 的浮层菜单挂到 body 并带 `[data-radix-popper-content-wrapper]`
+ *    ⇒ 一旦存在，就把所有关闭键 `pointer-events: none` 并压暗，
+ *    保证点菜单时绝不会误触到它。
+ */
+body:has([data-radix-popper-content-wrapper]) .hs-panel-close,
+body:has([role="menu"]) .hs-panel-close {
+    pointer-events: none;
+    opacity: 0.15;
+}
+/* 平板 / 桌面不需要（分屏是手机形态的机制）。 */
+@media (min-width: 600px) {
+    .hs-panel-close {
+        display: none;
+    }
+}
+
+/* ───────────────────────────────────────────────────────────────────────────
+   D3（2026-09-27）：打开「同步参数编辑器水平位置与缩放」且**两块面板同屏**时，
+   界面上只留**一个顶部拍数栏**与**一个底部滑动条**。
+
+   同屏时才去重（`App.tsx` 里算 `paramEditorSyncTimeline && mobilePanels.params
+   && mobilePanels.timeline`，给 body 打 `data-hs-paramsync="on"`）——
+   只开一个面板时本来就只有一份，不该受影响。
+
+   保留谁（用户口径「一个顶部拍数栏 + 一个底部滑动条」的字面读法）：
+     · 顶部：留**时间线的**拍数栏（它是屏幕上最上面那条），隐藏参数面板那条；
+     · 底部：留**参数面板的**滑动条（它是屏幕上最下面那条），隐藏时间线那条。
+
+   依赖的两组钩子（都只在这里被消费）：
+     `data-hs-time-ruler="timeline|params"`（`TimeRuler.tsx` 的 `surface` prop）
+     `data-hs-sb="timeline|params"`（两个内核里自绘的 `hs-sb-h` 轨道）
+
+   ⚠️ 两条都是**自绘 overlay 滚动条**（原生条已被 `.hide-scrollbar` 隐藏），
+   所以 `display:none` 掉一条不会让内容少滚 —— 另一条与内核手势仍在。 */
+body[data-hs-paramsync="on"] [data-hs-time-ruler="params"] {
+    display: none !important;
+}
+body[data-hs-paramsync="on"] [data-hs-sb="timeline"] {
+    display: none !important;
+}
+
+/* E9（用户口径）：「轨道+参数分屏下**开启同步位置与缩放**后应**隐藏参数界面左上角的速度映射键**」。
+   `body[data-hs-paramsync="on"]` 正是"分屏 + 同步开启"这个状态（App.tsx 里按
+   `paramEditorSyncTimeline && mobilePanels.params && mobilePanels.timeline` 设置）。
+   两颗速度映射键在同步态下功能一体、且并排容易误按 ⇒ 参数侧那颗隐藏。 */
+body[data-hs-paramsync="on"] [data-hs-params-tempo-map] {
+    display: none !important;
+}
+
+/* ── 手机顶栏菜单按钮：**视觉 32px、命中区仍 44px**（2026-10-03，用户口径）──────
+   用户报「菜单栏离系统状态栏有点远」。实测三段叠加：系统状态栏 40 CSS + 原生侧多垫
+   刘海差 6.7 CSS + 页面这边"44px 命中区把文字顶到离顶 12px"（见 MobileTopBar 的
+   `MOBILE_TOP_BAR_HEIGHT` 注释）。前两段不是这里的事 ⇒ 把视觉高度收到 32，
+   **但触控高度不能跟着缩**（原审计就是判 36px 太小），于是用伪元素把命中区补回来：
+   上下各外扩 6px ⇒ 32 + 12 = 44。 */
+.hs-menubar-btn {
+    position: relative;
+}
+.hs-menubar-btn::after {
+    content: "";
+    position: absolute;
+    left: 0;
+    right: 0;
+    /* 上下各 6px ⇒ 命中高度 44（= 原来的 TOUCH 常量） */
+    top: -6px;
+    bottom: -6px;
+}
+
+/* ── 手机端分屏的两块（C5/C6）───────────────────────────────────────────────
+   `flex-basis: 0` **必须走类、不能只写内联样式**：
+   实测（真机 221deeb，2026-09-30）内联的 `flexBasis` 会在 React 的 style diff 里被漏写
+   —— 下方块的 `style` 属性只剩 `flex-grow: 0.299`、**没有 flex-basis**
+   ⇒ 它的高度改由**内容**决定（文件浏览器 / 钢琴窗的 min-content）⇒ 轨道块被压到 0，
+   正是用户报的「调整分屏高度有明显问题」。
+   放进类里之后无论内联样式怎么被漏写，`flex-basis: 0` 都稳定生效。
+   （拖动时 `paintRatio()` 只改内联 `flex-grow`，两者互不覆盖。） */
+.hs-mobile-split-pane {
+    flex-basis: 0;
+    min-height: 0;
+}
+
+/* ── E22 统一动效层（2026-09-30）─────────────────────────────────────────────
+ * 用户口径：「补充动画：弹出分屏动画、移动轨道动画、菜单展开动画、各种拖动操作的
+ * 平滑化/惯性化 等」，并明确「**统一做一套**」⇒ 这里给出**一套**变量 + 三条关键帧，
+ * 各表面只挑一条用，不再各写各的。
+ *
+ * 两条硬性约束（都是踩出来的）：
+ *  ① **含 `position: fixed` 后代的容器只能动 `opacity`**：任何 `transform` / `filter`
+ *     都会让该容器成为包含块，那些浮层会改成"相对容器"定位 —— 分屏块里有 fixed 浮层、
+ *     音频块浮条里就有一个 `position: fixed` 的实条（坐标是视口系的）⇒ 一动就飞。
+ *     所以：菜单可以 `translateY + scale`（内容只有普通项），面板/浮条只做淡入。
+ *  ② 必须尊重 `prefers-reduced-motion`，并留一个**全局开关** `body[data-hs-no-anim]`
+ *     —— 验收探针靠它做"有动画 / 无动画"的对照（也方便用户嫌晃眼时一键关掉）。
+ *
+ * 出场动画（面板收起、菜单关闭）**已补上**（2026-10-01，E22 第二刀之后）：
+ * 关键帧不能自己"等着被卸载"，所以配了一个**挂载闸门** `hooks/useExitPresence.tsx` ——
+ * `open` 变 false 后把**关门前的子树快照**多留一个出场时长，期间给节点打 `data-hs-leaving`，
+ * 由下面的规则跑 `hs-menu-out` / `hs-fade-out`。⚠️ 时长两边**手工保持一致**
+ * （`useExitPresence.tsx` 的 `OUT_MS` ↔ 下面的 `--hs-anim-dur-out-*`）。
+ */
+:root {
+    --hs-anim-dur-menu: 150ms;
+    --hs-anim-dur-pane: 190ms;
+    --hs-anim-ease: cubic-bezier(0.22, 1, 0.36, 1);
+    /* 出场（略快于入场：关门要干脆） */
+    --hs-anim-dur-out-menu: 120ms;
+    --hs-anim-dur-out-pane: 160ms;
+    --hs-anim-dur-out-bar: 130ms;
+    /* 拖动收尾（抬手后从"指尖最后的位置"滑到落位比例） */
+    --hs-anim-dur-settle: 180ms;
+}
+
+@keyframes hs-menu-in {
+    from {
+        opacity: 0;
+        transform: translateY(-4px) scale(0.98);
+    }
+    to {
+        opacity: 1;
+        transform: none;
+    }
+}
+
+@keyframes hs-fade-in {
+    from {
+        opacity: 0;
+    }
+    to {
+        opacity: 1;
+    }
+}
+
+/* 出场（由 `useExitPresence` 打 `data-hs-leaving` 触发）。
+ * 与入场同规：菜单可以位移+缩放，面板/浮条**只动 opacity**（它们内含 `position: fixed` 后代，
+ * 一旦有 transform 就会变成包含块 ⇒ 那些浮层当场飞走，见本段注释①）。 */
+@keyframes hs-menu-out {
+    from {
+        opacity: 1;
+        transform: none;
+    }
+    to {
+        opacity: 0;
+        transform: translateY(-4px) scale(0.98);
+    }
+}
+
+@keyframes hs-fade-out {
+    from {
+        opacity: 1;
+    }
+    to {
+        opacity: 0;
+    }
+}
+
+/* 离开期间一律不吃命中：否则"已经关掉的菜单"还能被点到（还会连带触发它下面的东西）。
+ * 遮罩按钮也在被标记的子树上 ⇒ 一并失效，正是我们要的。 */
+[data-hs-leaving] {
+    pointer-events: none !important;
+}
+
+/* ① 菜单展开（关闭时会卸载内容 ⇒ 这里只做进场）。
+ * `[role="menu"]` 这一条是**关键**：手机端的菜单**不是** Radix 弹层，而是各组件
+ * 自己渲染的 `div[role=menu]`（`MobileTopBar` / `MobileBottomBar` / `ClipContextMenu` /
+ * `FadeContextMenu` …）—— 只写 `.rt-*` 的话，用户日常点的那几个菜单**一个都不会动**
+ * （实测：Radix 类命中 0 个、`[role=menu]` 命中 1 个）。
+ * 用 role 选择器而不是类名：类的 Tailwind 样式随时会变，role 是语义契约。 */
+[role="menu"],
+.rt-DropdownMenuContent,
+.rt-ContextMenuContent,
+.rt-PopoverContent,
+.rt-SelectContent {
+    animation: hs-menu-in var(--hs-anim-dur-menu) var(--hs-anim-ease) both;
+}
+
+/* ② 手机面板弹出（**只淡入**：块内有 fixed 浮层）。
+ * 挂在 `[data-hs-pane]` 而不是 `.hs-mobile-split-pane`：后者是**两个容器块**，
+ * 而用户感知的"面板"是里面的 timeline / params / files / notes 四块 ——
+ * 切页时容器不换、只有内容换。四块都给了 React `key`（见 App.tsx），
+ * 于是每次出现都是**新节点**，`animation` 才会重新跑。 */
+[data-hs-pane] {
+    animation: hs-fade-in var(--hs-anim-dur-pane) var(--hs-anim-ease) both;
+}
+
+/* ③ 音频块浮动操作条（根节点是 absolute、内含 fixed 实条 ⇒ 同样只淡入） */
+[data-hs-clip-actions] {
+    animation: hs-fade-in calc(var(--hs-anim-dur-pane) * 0.8) var(--hs-anim-ease) both;
+}
+
+/* ④ 出场（`data-hs-leaving` 由 `hooks/useExitPresence.tsx` 打）。
+ * 选择器比上面各条**多一个属性**（0,2,0 > 0,1,0）⇒ 稳定压过入场动画。 */
+[role="menu"][data-hs-leaving],
+.rt-DropdownMenuContent[data-hs-leaving],
+.rt-ContextMenuContent[data-hs-leaving],
+.rt-PopoverContent[data-hs-leaving],
+.rt-SelectContent[data-hs-leaving] {
+    animation: hs-menu-out var(--hs-anim-dur-out-menu) var(--hs-anim-ease) both;
+}
+
+[data-hs-pane][data-hs-leaving] {
+    animation: hs-fade-out var(--hs-anim-dur-out-pane) var(--hs-anim-ease) both;
+}
+
+[data-hs-clip-actions][data-hs-leaving] {
+    animation: hs-fade-out var(--hs-anim-dur-out-bar) var(--hs-anim-ease) both;
+}
+
+/* ⚠️ 这里**没有**"后代选择器版"的规则 —— 曾经有过（`[data-hs-leaving-root] …`，
+ * 靠给子树套一层 `display: contents` 包装层来兜住"组件子节点"），但它会**顶掉分屏容器的
+ * 直接子元素**：`App.tsx` 的 `paintRatio()` 是按 `container.children[0]/[1]` 直接改
+ * `flexGrow` 的，多一层无盒子的包装 ⇒ 拖动分屏当场失效（真机 C5/C6 探针 2/5）。
+ * 现在的口径：**组件自己把 `data-hs-leaving` prop 转到根节点上**，见
+ * `hooks/useExitPresence.tsx` 文件头约束②。*/
+
+/* ⑤ 拖动收尾（E22 第四刀）：抬手后把"指尖最后落到的比例"**滑到**"落位比例"。
+ * 为什么需要：拖动期间 `paintRatio()` 是每帧直接写 DOM 的 `flexGrow`（不值当每帧重渲整树），
+ * 而抬手时 App 会 `clamp(ratio, 0.15, 0.85)` 再 `setMobileSplitRatio` —— 于是 0.93 会**瞬跳**
+ * 到 0.85，跨过塌陷阈值那一下更是直接跳成全屏。
+ * 为什么只在窗口内开过渡：拖动过程中如果带着 `transition`，每帧写一次 `flexGrow` 都会重启过渡
+ * ⇒ 变成橡皮筋、**跟手度直接崩**（用户 I-2 明确抱怨过"不跟手"）。所以由 App 在抬手时打
+ * `data-hs-split-settling`、窗口结束就摘掉。`flex-grow` 是数值属性，可以插值 ⇒ 布局逐帧过渡。 */
+[data-hs-mobile-split][data-hs-split-settling] > * {
+    transition: flex-grow var(--hs-anim-dur-settle) var(--hs-anim-ease);
+}
+
+body[data-hs-no-anim] [data-hs-mobile-split][data-hs-split-settling] > * {
+    transition: none !important;
+}
+
+@media (prefers-reduced-motion: reduce) {
+    [data-hs-mobile-split][data-hs-split-settling] > * {
+        transition: none !important;
+    }
+}
+
+/* ── E35 统一浮层的落地规则（2026-10-02）───────────────────────────────────
+ * 用户口径：「同类菜单/窗口用相同的打开动画、背景处理、控件样式、字号、描述词」，
+ * 并点名「**储存设置的窗口位置、背景模糊、层级顺序都有问题**，不要只做这一例」。
+ * 全量盘点见 `docs/19-设计一致性盘点.md`（48 个浮层 / 8 条不一致）。这里只落**令牌与规则**，
+ * 各处组件改成挂 `data-hs-*` 标记、不再各写一份内联。
+ *
+ * 外观令牌（背板 / 圆角 / 字号）：浮层只准用这些，别再写 `rgba(0,0,0,0.45)` 这类第三档。 */
+:root {
+    /* 背板：模态档（弹窗 + 全屏模态）统一用它 —— 与 Radix `.rt-DialogOverlay` 同源 */
+    --hs-backdrop: var(--qt-overlay);
+    --hs-backdrop-blur: blur(2px);
+    --hs-radius-modal: 12px;
+    --hs-radius-menu: 8px;
+    --hs-radius-pill: 999px;
+    --hs-font-menu-item: 13.5px;
+    --hs-font-menu-title: 12px;
+    /* 自绘弹窗（无 portal、无滚动锁 ⇒ 必须自己定位）的顶边基准与高度上限。
+       原来三处硬编码 `top:60` / `top:64` + `calc(100vh - 150px)` / `-140px`，互相不一致；
+       且横屏（视口 = 屏幕 − 刘海，见 docs/17 §E28）与竖屏（原生 padding 收窄视口）下
+       以像素为基准都不靠谱。改成令牌 + `dvh`，三处共用一套。 */
+    --hs-modal-top: 56px;
+    --hs-modal-max-h: calc(100dvh - var(--hs-modal-top) - 16px);
+}
+
+/*
+ * 自绘模态弹窗（`StorageSettingsDialog` / `ProjectSettingsDialog` / `MetronomeSettingsOverlay`）。
+ *
+ * ① 定位 / 层级 / 高度上限的**唯一**出处 —— 组件里只留 `left/right: 8` 与内边距。
+ * ② 🔴 选择器权重与 `@media (max-width: 1279px) [role="dialog"]`（上面的兜底）**相同**，
+ *    但本规则在文件里**更靠后** ⇒ 能压过它。不这么做就会出现"内层 `maxHeight` + 外层
+ *    `100dvh - 16px` **双上限打架**"：弹窗从 `top:60` 起、却允许长到 `dvh-16`
+ *    ⇒ **底部被切到屏幕外**（用户报的「窗口位置有问题」实测就是它）。
+ * ③ 入场**只做淡入**（不用 `hs-menu-in` 的 transform）：本弹窗内含 `position: fixed` 的背板，
+ *    容器一旦有 transform 就成了包含块 ⇒ 背板会缩到面板大小（E22 注释①的同一个坑）。 */
+[data-hs-modal] {
+    top: var(--hs-modal-top);
+    max-height: var(--hs-modal-max-h) !important;
+    z-index: var(--hs-z-modal) !important;
+    border-radius: var(--hs-radius-modal);
+    animation: hs-fade-in var(--hs-anim-dur-pane) var(--hs-anim-ease) both;
+}
+
+[data-hs-modal-backdrop] {
+    z-index: calc(var(--hs-z-modal) - 1);
+    background: var(--hs-backdrop);
+    backdrop-filter: var(--hs-backdrop-blur);
+}
+
+/* 全屏模态（`MenuBar` 的导入模式选择 / 多音轨媒体选择）：遮罩 + 卡片同款 */
+[data-hs-modal-scrim] {
+    z-index: var(--hs-z-modal);
+    background: var(--hs-backdrop);
+    backdrop-filter: var(--hs-backdrop-blur);
+}
+
+[data-hs-modal-card] {
+    border-radius: var(--hs-radius-modal);
+    animation: hs-fade-in var(--hs-anim-dur-pane) var(--hs-anim-ease) both;
+}
+
+/* 自绘弹窗的出场（`data-hs-leaving` 由 `hooks/useExitPresence.tsx` 打） */
+[data-hs-modal][data-hs-leaving] {
+    animation: hs-fade-out var(--hs-anim-dur-out-pane) var(--hs-anim-ease) both;
+}
+
+/* 开关：探针对照 / 用户嫌晃眼 */
+body[data-hs-no-anim] [role="menu"],
+body[data-hs-no-anim] .rt-DropdownMenuContent,
+body[data-hs-no-anim] .rt-ContextMenuContent,
+body[data-hs-no-anim] .rt-PopoverContent,
+body[data-hs-no-anim] .rt-SelectContent,
+body[data-hs-no-anim] [data-hs-pane],
+body[data-hs-no-anim] [data-hs-clip-actions],
+body[data-hs-no-anim] [data-hs-modal],
+body[data-hs-no-anim] [data-hs-modal-card],
+body[data-hs-no-anim] [data-hs-modal-scrim] {
+    animation: none !important;
+}
+
+@media (prefers-reduced-motion: reduce) {
+    [role="menu"],
+    .rt-DropdownMenuContent,
+    .rt-ContextMenuContent,
+    .rt-PopoverContent,
+    .rt-SelectContent,
+    [data-hs-pane],
+    [data-hs-clip-actions],
+    [data-hs-modal],
+    [data-hs-modal-card],
+    [data-hs-modal-scrim] {
+        animation: none !important;
+    }
+}
+
+/*
+ * ⑥ 轨道拖动排序（E33，用户口径「拖动轨道的动画需要松手前**纵向上始终跟手**，
+ *    类似浏览器标签页拖动排序的效果」）：被拖行**跟手**（`translateY(手指位移)`，
+ *    无过渡）、它经过的那几行**让位**一个行高（带过渡）。
+ *
+ * 过渡的时长/曲线由组件**内联**写在行上（它随拖动状态变化），所以这里只负责**开关**
+ * —— 与 ⑤ 的分屏收尾同款：`body[data-hs-no-anim]` 或系统「减弱动态效果」时一律关掉。
+ * ⚠️ 必须 `!important`：内联样式没有它，而 `!important` 的作者规则**能**盖过内联。
+ * （踩过：漏了这两条 ⇒ E22-F4 那类"置 `data-hs-no-anim` 后应当零动画"的对照判据变红。）
+ */
+body[data-hs-no-anim] [data-track-list-panel] [data-hs-track-row] {
+    transition: none !important;
+}
+
+@media (prefers-reduced-motion: reduce) {
+    [data-track-list-panel] [data-hs-track-row] {
+        transition: none !important;
+    }
+}
