+                minWidth: 44,
+                padding: "0 9px",
+                fontSize: 11.5,
+                borderRadius: 999,
+                border: `1px solid ${active ? "transparent" : "var(--qt-border, rgba(255,255,255,0.18))"}`,
+                color: active ? "var(--white-a12, #fff)" : "var(--accent-11, rgb(177, 169, 255))",
+                background: active ? "var(--accent-9, rgb(91, 91, 214))" : "transparent",
