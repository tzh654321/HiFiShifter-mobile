index 00000000..7f8c8ae5
--- /dev/null
+++ b/frontend/src/components/AppErrorBoundary.tsx
@@ -0,0 +1,120 @@
+/**
+ * AppErrorBoundary —— 应用级 React 错误边界。
+ *
+ * 【为什么必须存在（2026-09-30 实测坐实，E10-②）】
+ * 本工程此前**没有任何错误边界**。React 18 的默认行为是：渲染 / 生命周期 / 帧回调里
+ * 抛出的异常若无人接管，**整棵组件树被卸载** ⇒ `#root` 子节点变成 0 ⇒ 用户看到
+ * 「整页空白」（只有背景色，没有任何提示、也没有报错）。
+ *
+ * 实测证据：模拟器上拖分屏手柄反复切换「参数全屏 ⇄ 分屏」，`logs/android.log` 里
+ * 只留下**一条**未捕获异常，界面却整片空白：
+ *
+ * ```
+ * [frontend] Uncaught error: Uncaught Error: Canvas 2D is unavailable
+ *     at D.paint  (surfaceRenderer-*.js)     ← 波形渲染器（帧回调里 throw）
+ *     at D.render (surfaceRenderer-*.js)
+ *     at Object.current (main-*.js)
+ * ```
+ *
+ * 也就是说：**一个面板里的一个渲染帧抛错，代价是整个 App 消失**。这既让人无法自助
+ * 排障（看不到任何信息），也让用户以为"工程坏了"。
+ *
+ * 有边界之后：出错的那棵子树被替换成本组件（同一容器内、可读的报错界面 + 重新加载），
+ * 其余部分继续工作；同时把异常回传后端日志，和 `installGlobalErrorReporting()` 的
+ * 未捕获异常走同一条通道。
+ *
+ * 【边界在哪一层】
+ * 放在 `I18nProvider` / `AppThemeProvider` **之内**、`App` **之外**：
+ * 这样主题与文案都可用（能画出像样的界面），而 App 内部的任何渲染错误都会被接住。
+ * 提供者自身的错误不归它管（那时连主题变量都没有，画不出可靠界面）。
+ *
+ * 【不做的事】
+ * - 不自动重试 / 不自动重载：渲染错误若与数据有关，自动重试只会反复闪。由用户点。
+ * - 不吞掉异常：仍然 `console.error` + 回传后端日志（否则就成了"悄悄坏掉"）。
+ */
+import React from "react";
+
+import { useI18n } from "../i18n/I18nProvider";
+import { reportFrontendError } from "../services/frontendErrorLog";
+
+/** 边界界面所需的文案（由函数包装组件注入，类组件里用不了 Hook）。 */
+export interface AppErrorBoundaryLabels {
+    readonly title: string;
+    readonly hint: string;
+    readonly reload: string;
+}
+
+interface Props extends AppErrorBoundaryLabels {
+    readonly children: React.ReactNode;
+}
+
+interface State {
+    readonly error: Error | null;
+}
+
+class Boundary extends React.Component<Props, State> {
+    state: State = { error: null };
+
+    static getDerivedStateFromError(error: Error): State {
+        return { error };
+    }
+
+    componentDidCatch(error: Error, info: React.ErrorInfo): void {
+        // 与 `installGlobalErrorReporting()` 同一条通道（写后端统一日志）。
+        // 带组件栈，才能知道是哪个面板炸的。
+        console.error("[AppErrorBoundary] render error", error, info.componentStack);
+        reportFrontendError(
+            `Render error: ${error.message}`,
+            `${error.stack ?? ""}\n--- componentStack ---${info.componentStack ?? ""}`,
+        );
+    }
+
+    private readonly handleReload = (): void => {
+        try {
+            window.location.reload();
+        } catch {
+            /* WebView 极端情况下 reload 可能不可用：静默（界面仍在） */
+        }
+    };
+
+    render(): React.ReactNode {
+        const { error } = this.state;
+        if (error === null) return this.props.children;
+        return (
+            <div className="flex h-full w-full flex-col items-center justify-center gap-3 bg-qt-window p-6 text-qt-text">
+                <div className="text-[15px] font-medium">{this.props.title}</div>
+                <div className="max-w-[520px] text-center text-[12px] text-qt-text-muted">
+                    {this.props.hint}
+                </div>
+                {/* 原始错误直接给出来：排障时这是最有价值的一行，不给就只能靠猜。 */}
+                <pre
+                    className="max-h-[180px] w-full max-w-[560px] overflow-auto whitespace-pre-wrap break-all rounded border border-qt-border bg-qt-base p-2 text-[11px]"
+                    aria-label="error-detail"
+                >
+                    {String(error.message || error)}
+                </pre>
+                <button
+                    type="button"
+                    className="rounded border border-qt-border px-3 py-1 text-[12px] hover:bg-qt-base"
+                    onClick={this.handleReload}
+                >
+                    {this.props.reload}
+                </button>
+            </div>
+        );
+    }
+}
+
+/** 函数包装：取到 i18n 文案后交给类组件（类组件不能用 Hook）。 */
+export function AppErrorBoundary({ children }: { readonly children: React.ReactNode }) {
+    const { t } = useI18n();
+    return (
+        <Boundary
+            title={t("app_error_boundary_title")}
+            hint={t("app_error_boundary_hint")}
+            reload={t("app_error_boundary_reload")}
+        >
+            {children}
+        </Boundary>
+    );
+}
