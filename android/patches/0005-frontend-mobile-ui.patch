+/* ── 参数工具行（2026-09-21 新增）──────────────────────────────────────── */
+
+/** 参数工具行行高。视觉 32px 内容 + 上下各 4px 内边距（命中区仍由按钮自己保证 40/44）。 */
+export const MOBILE_PARAM_TOOL_ROW_HEIGHT = 40;
+
+/** 参数 id → i18n 键。**只作兜底**（正常情况下面板一挂载就会写入镜像
+    `window.__hsParamUiState`，标签直接来自算法侧的真实名称）。 */
+const PARAM_TABS: ReadonlyArray<[string, MessageKey]> = [
+    ["pitch", "pitch"],
+    ["formant_shift_cents", "clip_formant_title"],
+    ["breathiness", "breath"],
+    ["tension", "tension"],
+    ["volume", "volume_label"],
+    ["pan", "pan_label"],
+];
+
+/**
+ * 手机外壳 ↔ 参数面板的**状态镜像**（由 `PianoRollPanel` 写入 `window.__hsParamUiState`）。
+ *
+ * 为什么需要它：参数集合与「曲线显隐」「气声开关」的真值都长在 `PianoRollPanel` 内部
+ * （`processorParams` / `secondaryParamVisible` / `processorStaticValues` 都是它的局部
+ * state），而外壳在另一个组件树分支里。按 ADR-005 的最小侵入原则，用事件桥接而不是
+ * 把这些 state 一次性提升到 redux（会牵动上游大段代码）。
+ *
+ * 🕳️ 本轮踩到的坑：早先这里**硬编码**了一份参数表
+ * （`pitch/formant_shift_cents/breathiness/tension/volume/pan`），但参数 id 是**随算法**
+ * 变的 —— nsf-hifigan 下气声叫 `breath_gain`、张力叫 `hifigan_tension`，根本没有
+ * `breathiness`。于是「切换到气声」会去切一个不存在的参数（静默失效）。
+ * ⇒ 一律以镜像里的**真实 id** 为准。
+ */
+type ParamUiRow = {
+    id: string;
+    label: string;
+    secondary: boolean;
+    /** 该行是否附带「开启/关闭」（气声：`breath_enabled`） */
+    hasBreathSwitch?: boolean;
+    breathOn?: boolean;
+};
+
+type ParamUiState = {
+    editParam?: string;
+    overlaysVisible?: boolean;
+    params?: ParamUiRow[];
+};
+
+function readParamUiState(): ParamUiState {
+    return (window as unknown as { __hsParamUiState?: ParamUiState }).__hsParamUiState ?? {};
+}
+
+/** 镜像还没到位时的兜底（正常情况下面板一挂载就会写入镜像）。 */
+const paramUiFallback = (t: (k: MessageKey) => string): ParamUiRow[] =>
+    PARAM_TABS.map(([id, key]) => ({
+        id,
+        label: t(key),
+        secondary: false,
+    }));
+
+/**
+ * 竖排双功能面板（👁 菜单）。
+ *
+ * 用户口径：「眼睛菜单里的每项都有 切换到/显隐 两项功能，气声还有开启/关闭，
+ * 需要更改 ui 以支持所有功能，我建议竖排项，注意图标化」。
+ *
+ * 每行 = [图标] 参数名 + 右侧胶囊：
+ *   · 切换到 → 把参数编辑器切到该参数（真值 = 镜像里的 `params[].id`）
+ *   · 显隐   → 该参数曲线在参数编辑器里的可见性（真值 = PianoRollPanel 的
+ *              `secondaryParamVisible`，通过 `hs-set-secondary-param` 事件回写）
