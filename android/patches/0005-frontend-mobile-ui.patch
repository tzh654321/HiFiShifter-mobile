+                </Text>
+                <Text size="2" color="gray" style={{ display: "block", marginTop: 4 }}>
+                    {tAny("storage_settings_desc")}
+                </Text>
+
+                <Flex direction="column" gap="3" mt="3">
+                    <Flex direction="column" gap="1">
