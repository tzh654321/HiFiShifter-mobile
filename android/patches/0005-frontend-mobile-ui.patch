@@ -0,0 +1,211 @@
+/**
+ * MetronomeSettingsOverlay —— 节拍器长按菜单。
+ *
+ * 用户口径（2026-09-30）：「节拍器的菜单打不开，且需要的内容原软件有给出，按原软件制作：
+ *   音量 / 细分 / 跟随网格 / 仅每拍 / 仅小节首 / 音色 / 嗒声 / 木鱼 / 蜂鸣 / 强调重拍」。
+ *
+ * 这些项与 store 字段**一一对应**（不是我新造的）：
+ *   · 音量      ⇒ `metronomeGain`（0..1）
+ *   · 细分      ⇒ `metronomeMode`「grid(跟随网格) / beat(仅每拍) / bar(仅小节首)」
+ *   · 音色      ⇒ `metronomeSound`「click(嗒声) / woodblock(木鱼) / beep(蜂鸣)」
+ *   · 强调重拍  ⇒ `metronomeAccent`
+ *   · 另有「启用」⇒ `metronomeEnabled`（菜单里得能开关，否则长按菜单没法用）
+ *
+ * 一律走 `updateMetronome` thunk（它会同步引擎 + 持久化），不直接改 store。
+ * 形态沿用本项目自绘浮层（fixed 背板 + 内容自适应高度），无 portal / 无滚动锁。
+ */
+import React from "react";
+import { Button, Flex, Text } from "@radix-ui/themes";
+import { shallowEqual } from "react-redux";
+import { useAppDispatch, useAppSelector } from "../../app/hooks";
+import { useI18n } from "../../i18n/I18nProvider";
+import { ExitPresence } from "../../hooks/useExitPresence";
+import { updateMetronome } from "../../features/session/thunks/transportThunks";
+
+interface Props {
+    open: boolean;
+    onOpenChange: (open: boolean) => void;
+}
+
+const MODES = [
+    { key: "grid" as const, labelKey: "hs_mn_mode_grid" },
+    { key: "beat" as const, labelKey: "hs_mn_mode_beat" },
+    { key: "bar" as const, labelKey: "hs_mn_mode_bar" },
+];
+const SOUNDS = [
+    { key: "click" as const, labelKey: "hs_mn_sound_click" },
+    { key: "woodblock" as const, labelKey: "hs_mn_sound_woodblock" },
+    { key: "beep" as const, labelKey: "hs_mn_sound_beep" },
+];
+
+export function MetronomeSettingsOverlay({ open, onOpenChange }: Props) {
+    const { t } = useI18n();
+    const tAny = t as (key: string) => string;
+    const dispatch = useAppDispatch();
+    const s = useAppSelector(
+        (st) => ({
+            enabled: st.session.metronomeEnabled,
+            gain: st.session.metronomeGain,
+            mode: st.session.metronomeMode,
+            sound: st.session.metronomeSound,
+            accent: st.session.metronomeAccent,
+        }),
+        shallowEqual,
+    );
+    /** 更新节拍器配置：只传要改的字段，其余沿用当前值（走 thunk ⇒ 同步引擎 + 持久化）。 */
+    const patch = (p: {
+        enabled?: boolean;
+        gain?: number;
+        mode?: "grid" | "beat" | "bar";
+        sound?: "click" | "woodblock" | "beep";
+        accent?: boolean;
+    }) => {
+        void dispatch(
+            /* ⚠️ `updateMetronome` 的入参用的是 **store 字段名**（metronomeEnabled / metronomeGain …），
+               不是简写 —— 第一版写成 `enabled/gain/...` 直接被类型系统挡下。 */
+            updateMetronome({
+                metronomeEnabled: p.enabled ?? s.enabled,
+                metronomeGain: p.gain ?? s.gain,
+                metronomeMode: p.mode ?? s.mode,
+                metronomeSound: p.sound ?? s.sound,
+                metronomeAccent: p.accent ?? s.accent,
+            }),
+        );
+    };
+
+    const row = (label: string, children: React.ReactNode) => (
+        <Flex direction="column" gap="1">
+            <Text size="2" weight="bold">
+                {label}
+            </Text>
+            {children}
+        </Flex>
+    );
+
+    /* E35：与菜单/面板同规 —— 出场也要淡出，而不是「啪」地消失。
+       `anim="pane"` 与 `--hs-anim-dur-out-pane` 对齐（时长契约在 `useExitPresence`）。 */
+    return (
+        <ExitPresence open={open} anim="pane">
+            <>
+            <div
+                data-hs-metronome-backdrop
+                data-hs-modal-backdrop
+                className="fixed border-0 cursor-pointer"
+                /* E35：背板统一走 `--hs-backdrop` + `--hs-backdrop-blur`（与 Radix 弹窗同源）。
+                   原来是 `rgba(0,0,0,0.45)` 无模糊 ⇒ 与 Radix 弹窗的 `0.35 + blur(2px)` 不同档。 */
+                style={{ inset: 0 }}
+                onClick={() => onOpenChange(false)}
+            />
+            <div
+                data-hs-metronome-settings
+                data-hs-modal
+                role="dialog"
+                aria-label={tAny("mobile_metronome")}
+                className="fixed bg-qt-window border border-qt-border text-qt-text"
+                /* E35：定位 / 高度上限 / 层级 / 圆角全部收进 `index.css` 的 `[data-hs-modal]`
+                   （原来三处各写一份：top 60 vs 64、maxHeight −150 vs −140、z 60/61，
+                   且与 `@media(max-width:1279px) [role="dialog"]` 的兜底上限打架 ⇒ 底部被切）。 */
+                style={{ left: 8, right: 8, padding: 12, overflowY: "auto" }}
+            >
+                <Text size="4" weight="bold" style={{ display: "block" }}>
+                    {tAny("mobile_metronome")}
+                </Text>
+
+                <Flex direction="column" gap="3" mt="3">
+                    {/* 启用 */}
+                    <Flex align="center" justify="between" gap="2">
+                        <Text size="2" weight="bold">
+                            {tAny("hs_mn_enabled")}
+                        </Text>
+                        <Button
+                            size="1"
+                            variant={s.enabled ? "solid" : "soft"}
+                            onClick={() => patch({ enabled: !s.enabled })}
+                        >
+                            {s.enabled ? tAny("storage_state_on") : tAny("storage_state_off")}
+                        </Button>
+                    </Flex>
+
+                    {/* 音量 */}
+                    {row(
+                        tAny("hs_mn_volume"),
+                        <Flex align="center" gap="2">
+                            <Button
+                                size="1"
+                                variant="soft"
+                                onClick={() => patch({ gain: Math.max(0, Math.round((s.gain - 0.1) * 100) / 100) })}
+                            >
+                                −
+                            </Button>
+                            <Text size="2" data-hs-mn-gain>
+                                {`${Math.round((s.gain ?? 0) * 100)}%`}
+                            </Text>
+                            <Button
+                                size="1"
+                                variant="soft"
+                                onClick={() => patch({ gain: Math.min(1, Math.round((s.gain + 0.1) * 100) / 100) })}
+                            >
+                                +
+                            </Button>
+                        </Flex>,
+                    )}
+
+                    {/* 细分 */}
+                    {row(
+                        tAny("hs_mn_mode"),
+                        <Flex gap="1" wrap="wrap" data-hs-mn-mode>
+                            {MODES.map((m) => (
+                                <Button
+                                    key={m.key}
+                                    size="1"
+                                    variant={s.mode === m.key ? "solid" : "soft"}
+                                    onClick={() => patch({ mode: m.key })}
+                                >
+                                    {tAny(m.labelKey)}
+                                </Button>
+                            ))}
+                        </Flex>,
+                    )}
+
+                    {/* 音色 */}
+                    {row(
+                        tAny("hs_mn_sound"),
+                        <Flex gap="1" wrap="wrap" data-hs-mn-sound>
+                            {SOUNDS.map((v) => (
+                                <Button
+                                    key={v.key}
+                                    size="1"
+                                    variant={s.sound === v.key ? "solid" : "soft"}
+                                    onClick={() => patch({ sound: v.key })}
+                                >
+                                    {tAny(v.labelKey)}
+                                </Button>
+                            ))}
+                        </Flex>,
+                    )}
+
+                    {/* 强调重拍 */}
+                    <Flex align="center" justify="between" gap="2">
+                        <Text size="2" weight="bold">
+                            {tAny("hs_mn_accent")}
+                        </Text>
+                        <Button
+                            size="1"
+                            variant={s.accent ? "solid" : "soft"}
+                            onClick={() => patch({ accent: !s.accent })}
+                        >
+                            {s.accent ? tAny("storage_state_on") : tAny("storage_state_off")}
+                        </Button>
+                    </Flex>
+                </Flex>
+
+                <Flex justify="end" mt="4">
+                    <Button variant="soft" onClick={() => onOpenChange(false)}>
+                        {tAny("close")}
+                    </Button>
+                </Flex>
+            </div>
+            </>
+        </ExitPresence>
+    );
+}
