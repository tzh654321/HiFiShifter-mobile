diff --git a/frontend/src/i18n/locales.test.ts b/frontend/src/i18n/locales.test.ts
new file mode 100644
index 00000000..08cfda7e
--- /dev/null
+++ b/frontend/src/i18n/locales.test.ts
@@ -0,0 +1,66 @@
+/**
+ * i18n 语种完整性不变量（E36 新增）。
+ *
+ * 【背景】`i18n/I18nProvider.tsx` 的取值是 `localeMessages[key] ?? messages["en-US"][key]`
+ * —— **缺 key 时静默回退英文**。这很方便，但也意味着"某语种少翻译了几条"**永远不会报错**，
+ * 只会在那几处 UI 上突然冒出英文。实测 2026-10-02：`zh-TW` / `ja-JP` / `ko-KR` 各比
+ * `en-US` 少 8 个 key（`mobile_tool_select`、`menu_view_panel_*`、`ctx_paste` …），
+ * 全是前几轮新加文案时只补了 `en-US` + `zh-CN` 留下的。
+ *
+ * ⇒ 这里把"五语种 key 集合完全一致"钉成**不变量**：以后任何一轮加了新文案，
+ * 忘了补某个语种就会在单测里红。
+ *
+ * ⚠️ `MessageKey` 的类型取自 **`en-US`**（见 `i18n/messages.ts`），所以 en-US 是基准。
+ */
+import { describe, expect, it } from "vitest";
+import { messages, type Locale } from "./messages";
+
+const BASE: Locale = "en-US";
+const LOCALES = Object.keys(messages) as Locale[];
+
+describe("i18n 语种完整性", () => {
+    it("每个语种与 en-US 的 key 集合完全一致（缺/多都不许）", () => {
+        const baseKeys = Object.keys(messages[BASE]);
+        const problems: string[] = [];
+        for (const loc of LOCALES) {
+            if (loc === BASE) continue;
+            const keys = new Set(Object.keys(messages[loc]));
+            const missing = baseKeys.filter((k) => !keys.has(k));
+            const extra = Object.keys(messages[loc]).filter((k) => !(k in messages[BASE]));
+            if (missing.length > 0 || extra.length > 0) {
+                problems.push(
+                    `${loc}: 缺 ${missing.length} 个${missing.length ? ` [${missing.slice(0, 8).join(", ")}]` : ""}` +
+                        ` / 多 ${extra.length} 个${extra.length ? ` [${extra.slice(0, 8).join(", ")}]` : ""}`,
+                );
+            }
+        }
+        expect(problems.join("\n")).toBe("");
+    });
+
+    it("没有空字符串（空值会让 UI 静默变成空白，比缺 key 更难查）", () => {
+        const empty: string[] = [];
+        for (const loc of LOCALES) {
+            for (const [key, value] of Object.entries(messages[loc])) {
+                if (typeof value === "string" && value.trim() === "") empty.push(`${loc}.${key}`);
+            }
+        }
+        expect(empty.join("\n")).toBe("");
+    });
+
+    it("带占位符的 key：五个语种用的是同一个占位符集合", () => {
+        /* `ModelManagerDialog` 那类用 `tf(key, vars)` 做 `{name}` 替换 ⇒ 若某语种把
+           `{size}` 写成了别的名字，运行时会**静默留着一个 {size} 字面量**。 */
+        const ph = (s: string) => [...s.matchAll(/\{([a-zA-Z0-9_]+)\}/g)].map((m) => m[1]).sort().join(",");
+        const problems: string[] = [];
+        for (const [key, baseVal] of Object.entries(messages[BASE])) {
+            if (typeof baseVal !== "string" || !baseVal.includes("{")) continue;
+            const want = ph(baseVal);
+            for (const loc of LOCALES) {
+                if (loc === BASE) continue;
+                const got = ph(String(messages[loc][key as keyof (typeof messages)[typeof BASE]] ?? ""));
+                if (got !== want) problems.push(`${loc}.${key}: 期望 {${want}} 实得 {${got}}`);
+            }
+        }
+        expect(problems.join("\n")).toBe("");
+    });
+});
