@@ -0,0 +1,44 @@
+/**
+ * E33（用户口径：「拖动轨道的动画需要松手前**纵向上始终跟手**，类似浏览器标签页拖动排序」）
+ * —— 拖动排序的**纯几何**：把"目标槽位"翻译成"每一行的让位位移"。
+ *
+ * 抽成独立模块是为了能**用单测钉死**：这段映射一旦算错（方向反了 / 少算一行 /
+ * 嵌套层级漏了），表现是"行让位让到别处"或"抬手后顺序和看到的不一致"，
+ * 而在设备上很难一眼看出来。见 `trackReorder.test.ts`。
+ */
+
+/** 让位过渡的时长 / 曲线（与 FLIP 的 180ms 同源，手感一致）。 */
+export const REORDER_SHIFT_MS = 180;
+export const REORDER_SHIFT_EASING = "cubic-bezier(0.22, 1, 0.36, 1)";
+
+/**
+ * @param sibIds    同父兄弟的 id（**当前**顺序，即本次拖动开始前的顺序）
+ * @param fromIndex 被拖行在其中的下标
+ * @param toIndex   目标槽位的下标（= 被拖行视觉上落进哪一个位置）
+ * @param rowH      行高（px）
+ * @returns trackId → 纵向位移（px，正 = 下移）；**不含被拖行自己**（它用跟手位移）
+ */
+export function computeReorderShifts(
+    sibIds: readonly string[],
+    fromIndex: number,
+    toIndex: number,
+    rowH: number,
+): Record<string, number> {
+    const out: Record<string, number> = {};
+    if (fromIndex < 0 || toIndex < 0) return out;
+    if (fromIndex >= sibIds.length || toIndex >= sibIds.length) return out;
+    if (!(rowH > 0)) return out;
+    if (fromIndex === toIndex) return out;
+    const lo = Math.min(fromIndex, toIndex);
+    const hi = Math.max(fromIndex, toIndex);
+    /* 往下拖（toIndex > fromIndex）⇒ 被经过的那几行**上移**一行让出空槽；
+       往上拖则相反。两端（lo..hi）都是闭区间，但要跳过被拖行自己。 */
+    const dy = toIndex > fromIndex ? -rowH : rowH;
+    for (let k = lo; k <= hi; k += 1) {
+        if (k === fromIndex) continue;
+        const id = sibIds[k];
+        if (id === undefined) continue;
+        out[id] = dy;
+    }
+    return out;
+}
