index 00000000..80f8cc40
--- /dev/null
+++ b/frontend/src/components/layout/ProjectSettingsDialog.tsx
@@ -0,0 +1,295 @@
+/**
+ * ProjectSettingsOverlay —— E1 + G-3：「菜单栏-文件 → 工程设置…」。
+ *
+ * G-3（用户口径，2026-09-30）：「工程设置完全参考原软件的上工具栏设计，不要自己猜选项是什么、
+ * 是否有输入框，还缺 BPM」。据此调整：
+ *   · **加 BPM**（`set_transport({ bpm })`，与上工具栏一致：数值 + 步进）；
+ *   · **去掉我自己加的"网格手动输入框"** —— 那是猜出来的；网格间距在原版里属于
+ *     **「吸附网格设置」**（`SnapGridSettingsDialog`，含网格线/间距/最小像素间距/Swing/总开关），
+ *     这里只给一个入口按钮，不再自己造第二套；
+ *   · 保留上工具栏里确实有的：基准音阶、拍号（每小节拍数 / 分母）、撤销历史；
+ *   · 工程名 / 路径只读（改名走「另存为」：工程名即文件名，上游口径）。
+ *
+ * F4：高度按内容自适应（只留 top + maxHeight）。
+ */
+import React from "react";
+import { Button, Flex, Text } from "@radix-ui/themes";
+import { shallowEqual } from "react-redux";
+import { useAppSelector } from "../../app/hooks";
+import { useI18n } from "../../i18n/I18nProvider";
+import { ExitPresence } from "../../hooks/useExitPresence";
+import { webApi } from "../../services/webviewApi";
+
+interface Props {
+    open: boolean;
+    onOpenChange: (open: boolean) => void;
+}
+
+/** 与 `ScaleKey` 一致（♭ 记法）。 */
+const BASE_SCALES = ["C", "Db", "D", "Eb", "E", "F", "Gb", "G", "Ab", "A", "Bb", "B"] as const;
+/**
+ * 🔴 2026-10-03（用户口径）：「每小节拍数**分子换成输入框**、分母**添加 1 与 32**」。
+ * ⇒ 分子不再用固定档位（旧 `[2,3,4,5,6,7,8,9,12]` 覆盖不到 10/11/13…），改成自由输入；
+ *   分母补上 1（全音符为一拍）与 32（极细分）。
+ */
+const DENOMINATOR_OPTIONS = [1, 2, 4, 8, 16, 32] as const;
+
+export function ProjectSettingsDialog({ open, onOpenChange }: Props) {
+    const { t } = useI18n();
+    const tAny = t as (key: string) => string;
+    const s = useAppSelector(
+        (st) => ({
+            name: st.session.project.name,
+            path: st.session.project.path,
+            baseScale: st.session.project.baseScale,
+            saveUndoHistory: st.session.project.saveUndoHistory,
+            denominator: st.session.project.timeSignatureDenominator,
+            gridSize: st.session.project.gridSize,
+            beats: st.session.beats,
+            bpm: st.session.bpm,
+        }),
+        shallowEqual,
+    );
+    const [busy, setBusy] = React.useState(false);
+    /** BPM 输入框（受控，仅在本组件内）—— 应用时走 `set_transport`。 */
+    const [bpmInput, setBpmInput] = React.useState<string>(String(Math.round(s.bpm || 120)));
+    React.useEffect(() => {
+        setBpmInput(String(Math.round(s.bpm || 120)));
+    }, [s.bpm, open]);
+
+    const beatsPerBar = Math.max(1, Math.round(s.beats || 4));
+    const denominator = s.denominator || 4;
+    /** 每小节拍数（分子）的输入框 —— 受控，仅在本组件内（用户口径 2026-10-03：分子改输入框）。 */
+    const [beatsInput, setBeatsInput] = React.useState<string>(String(beatsPerBar));
+    React.useEffect(() => {
+        setBeatsInput(String(beatsPerBar));
+    }, [beatsPerBar, open]);
+
+    const applyBpm = (raw: string) => {
+        const v = Number(raw);
+        if (!Number.isFinite(v) || v <= 0) return;
+        setBusy(true);
+        void (webApi.setTransport({ bpm: v }) as Promise<unknown>).finally(() => setBusy(false));
+    };
+    const applyTimeline = (beats: number, den: number, grid: string) => {
+        setBusy(true);
+        void (webApi.setProjectTimelineSettings(beats, den, grid) as Promise<unknown>).finally(() =>
+            setBusy(false),
+        );
+    };
+    /**
+     * 提交"每小节拍数"（分子，输入框版）。
+     *
+     * 只接受正整数；非法输入**不提交也不清空**（输入框保留原样让用户改），
+     * 与 `applyBpm` 同一套口径。上限取 64：再大的拍号在后端也只是个整数，
+     * 但网格线会密到没意义。
+     */
+    const applyBeats = (raw: string) => {
+        const v = Number(raw);
+        if (!Number.isFinite(v) || v <= 0) return;
+        const clamped = Math.min(64, Math.max(1, Math.round(v)));
+        applyTimeline(clamped, denominator, s.gridSize || "1/4");
+    };
+
+    const infoRow = (label: string, value: string, title?: string) => (
+        <Flex align="center" justify="between" gap="3" style={{ minWidth: 0 }}>
+            <Text size="2" color="gray" style={{ flexShrink: 0 }}>
+                {label}
+            </Text>
+            <Text
+                size="2"
+                title={title ?? value}
+                style={{ whiteSpace: "nowrap", overflow: "hidden", textOverflow: "ellipsis", minWidth: 0 }}
+            >
+                {value}
+            </Text>
+        </Flex>
+    );
+
+    /* E35：与菜单/面板同规 —— 出场也要淡出，而不是「啪」地消失。
+       `anim="pane"` 与 `--hs-anim-dur-out-pane` 对齐（时长契约在 `useExitPresence`）。 */
+    return (
+        <ExitPresence open={open} anim="pane">
+            <>
+            <div
+                data-hs-project-backdrop
+                data-hs-modal-backdrop
+                className="fixed border-0 cursor-pointer"
+                /* E35：背板统一走 `--hs-backdrop` + `--hs-backdrop-blur`（与 Radix 弹窗同源）。
+                   原来是 `rgba(0,0,0,0.45)` 无模糊 ⇒ 与 Radix 弹窗的 `0.35 + blur(2px)` 不同档。 */
+                style={{ inset: 0 }}
+                onClick={() => onOpenChange(false)}
+            />
+            <div
+                data-hs-project-settings
+                data-hs-modal
+                role="dialog"
+                aria-label={tAny("menu_project_settings")}
+                className="fixed bg-qt-window border border-qt-border text-qt-text"
+                /* E35：定位 / 高度上限 / 层级 / 圆角全部收进 `index.css` 的 `[data-hs-modal]`
+                   （原来三处各写一份：top 60 vs 64、maxHeight −150 vs −140、z 60/61，
+                   且与 `@media(max-width:1279px) [role="dialog"]` 的兜底上限打架 ⇒ 底部被切）。 */
+                style={{ left: 8, right: 8, padding: 12, overflowY: "auto" }}
+            >
+                <Text size="4" weight="bold" style={{ display: "block" }}>
+                    {tAny("menu_project_settings")}
+                </Text>
+
+                <Flex direction="column" gap="2" mt="3">
+                    {infoRow(tAny("project_name_label"), s.name || "Untitled")}
+                    {infoRow(tAny("project_path_label"), s.path ?? tAny("project_unsaved_short"), s.path ?? undefined)}
+                </Flex>
+
+                {/* BPM（G-3：上工具栏里有，之前缺）*/}
+                <Flex direction="column" gap="1" mt="3">
+                    <Text size="2" weight="bold">
+                        BPM
+                    </Text>
+                    <Flex gap="2" align="center">
+                        <Button
+                            size="1"
+                            variant="soft"
+                            disabled={busy}
+                            onClick={() => applyBpm(String(Math.max(1, Math.round(s.bpm || 120) - 1)))}
+                        >
+                            −1
+                        </Button>
+                        <input
+                            data-hs-project-bpm-input
+                            value={bpmInput}
+                            onChange={(e) => setBpmInput(e.target.value)}
+                            onKeyDown={(e) => {
+                                e.stopPropagation();
+                                if (e.key === "Enter") applyBpm(bpmInput.trim());
+                            }}
+                            inputMode="decimal"
+                            className="text-xs rounded px-2 py-1 outline-none bg-qt-base text-qt-text border border-qt-border"
+                            style={{ width: 72 }}
+                        />
+                        <Button
+                            size="1"
+                            variant="soft"
+                            disabled={busy}
+                            onClick={() => applyBpm(String(Math.round(s.bpm || 120) + 1))}
+                        >
+                            +1
+                        </Button>
+                        <Button size="1" disabled={busy || !bpmInput.trim()} onClick={() => applyBpm(bpmInput.trim())}>
+                            {tAny("storage_save")}
+                        </Button>
+                    </Flex>
+                </Flex>
+
+                {/* 基准音阶（E1 要求可调）*/}
+                <Flex direction="column" gap="1" mt="3">
+                    <Text size="2" weight="bold">
+                        {tAny("base_scale")}
+                    </Text>
+                    <Flex gap="1" wrap="wrap" data-hs-project-base-scale-group>
+                        {BASE_SCALES.map((k) => (
+                            <Button
+                                key={k}
+                                size="1"
+                                variant={s.baseScale === k ? "solid" : "soft"}
+                                disabled={busy}
+                                onClick={() => {
+                                    setBusy(true);
+                                    void (webApi.setProjectBaseScale(k) as Promise<unknown>).finally(() =>
+                                        setBusy(false),
+                                    );
+                                }}
+                            >
+                                {k}
+                            </Button>
+                        ))}
+                    </Flex>
+                </Flex>
+
+                {/* 拍号 */}
+                <Flex direction="column" gap="1" mt="3">
+                    <Text size="2" weight="bold">
+                        {tAny("beats_per_bar")}
+                    </Text>
+                    {/* 分子（每小节拍数）：**输入框**。用户口径 2026-10-03 —— 旧按钮组
+                        档位 `[2..12]` 覆盖不到 10/11/13…；这里与 BPM 同款（Enter 或「保存」提交）。 */}
+                    <Flex align="center" gap="2">
+                        <input
+                            data-hs-project-beats-input
+                            value={beatsInput}
+                            onChange={(e) => setBeatsInput(e.target.value)}
+                            onKeyDown={(e) => {
+                                e.stopPropagation();
+                                if (e.key === "Enter") applyBeats(beatsInput.trim());
+                            }}
+                            inputMode="numeric"
+                            className="text-xs rounded px-2 py-1 outline-none bg-qt-base text-qt-text border border-qt-border"
+                            style={{ width: 72 }}
+                        />
+                        <Button
+                            size="1"
+                            disabled={busy || !beatsInput.trim()}
+                            onClick={() => applyBeats(beatsInput.trim())}
+                        >
+                            {tAny("storage_save")}
+                        </Button>
+                    </Flex>
+                    <Text size="1" weight="bold" mt="1">
+                        {tAny("time_signature_denominator")}
+                    </Text>
+                    <Flex gap="1" wrap="wrap">
+                        {DENOMINATOR_OPTIONS.map((n) => (
+                            <Button
+                                key={n}
+                                size="1"
+                                variant={denominator === n ? "solid" : "soft"}
+                                disabled={busy}
+                                onClick={() => applyTimeline(beatsPerBar, n, s.gridSize || "1/4")}
+                            >
+                                {String(n)}
+                            </Button>
+                        ))}
+                    </Flex>
+                </Flex>
+
+                {/* 网格：只给入口，不自己造第二套（G-3）*/}
+                <Flex direction="column" gap="1" mt="3">
+                    <Text size="2" weight="bold">
+                        {tAny("proj_grid_label")}
+                    </Text>
+                    <Flex align="center" gap="2">
+                        <Text size="2" data-hs-project-grid-value>
+                            {s.gridSize || "1/4"}
+                        </Text>
+                        <Button
+                            size="1"
+                            variant="soft"
+                            onClick={() => {
+                                window.dispatchEvent(
+                                    new CustomEvent("hs-open-settings", { detail: { which: "snap-grid" } }),
+                                );
+                                onOpenChange(false);
+                            }}
+                        >
+                            {tAny("menu_snap_grid_settings")}
+                        </Button>
+                    </Flex>
+                </Flex>
+
+                {/* 撤销历史（只读展示；其开关在原版属于工程保存设置）*/}
+                <Flex direction="column" gap="1" mt="3">
+                    {infoRow(
+                        tAny("proj_undo_label"),
+                        s.saveUndoHistory ? tAny("storage_state_on") : tAny("storage_state_off"),
+                    )}
+                </Flex>
+
+                <Flex justify="end" mt="4">
+                    <Button variant="soft" onClick={() => onOpenChange(false)}>
+                        {tAny("close")}
+                    </Button>
+                </Flex>
+            </div>
+            </>
+        </ExitPresence>
+    );
+}
