+                                            </div>
+                                            {(
+                                                [
+                                                    ["world_dll", "world"],
+                                                    ["nsf_hifigan_onnx", "nsf-hifigan"],
+                                                    ["vslib", "vslib"],
+                                                    ["none", t("none")],
+                                                ] as ReadonlyArray<[string, string]>
+                                            ).map(([value, label]) => {
+                                                const current =
+                                                    ctxTrack.pitchAnalysisAlgo === value ||
+                                                    (!ctxTrack.pitchAnalysisAlgo &&
+                                                        value === "nsf_hifigan_onnx");
+                                                return (
+                                                    <button
+                                                        key={value}
+                                                        className="w-full text-left px-3 py-1.5 text-sm hover:bg-qt-button-hover transition-colors"
