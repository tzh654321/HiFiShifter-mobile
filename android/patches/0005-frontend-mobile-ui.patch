+        /* E22：手指再次落下 ⇒ 立刻停住上一次的甩动（否则"按住了还在跑"）。 */
+        this.inertiaVel = null;
+        // 1→2 过渡：先存在的单指拖拽必须干净中止（docs/08 §4.1）。
+        if (this.pointers.size === 1) {
+            for (const id of this.pointers.keys()) this.abortPointer(id);
+            // 额外表面（拍数栏/琴键轴）上的单指平移：自行退出（见 PianoRollPanel 的
+            // singleFingerBail 判定）——合成 pointercancel 只在 window 上派发，
+            // 绑在元素上的单指处理器收不到，故以手势标志位协同。
+        }
+        this.pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
+        // 一致性自愈：已经有 ≥2 个指针在案却没有会话，说明上一轮有 pointerup 没送到
+        // 我们手上（多表面 + 合成 pointercancel 的时序残留），陈旧指针会让后续所有
+        // 手势永远判不出"两指"。此时清空重建，以本次指针为准。
+        if (this.pointers.size >= 3 && this.session === null) {
+            this.pointers.clear();
+            this.pointerSurface.clear();
+            this.pointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
+        }
+        const surface = (e.currentTarget ?? this.target) as HTMLElement;
+        this.pointerSurface.set(e.pointerId, surface);
+        if (this.pointers.size === 2) {
+            // 第二指落下才捕获指针（2026-09-19 修复）：单指期间绝不能 capture——
+            // 捕获态会让 WebView 不合成原生 long-press → contextmenu，参数面板等
+            // 把 onContextMenu 绑在内部元素上的菜单就再也弹不出来（时间线的菜单
+            // 绑在容器层所以之前没暴露）。双指期间捕获把 move 锁到各自表面。
+            for (const id of this.pointers.keys()) {
+                try {
+                    this.pointerSurface.get(id)?.setPointerCapture(id);
+                } catch {
+                    /* 某些环境下 capture 可能失败，忽略即可 */
+                }
+            }
+            e.preventDefault();
+            e.stopPropagation();
+            this.beginSession();
+            this.setActiveFlag(true);
+        }
+    };
+
+    private readonly onPointerMove = (e: PointerEvent): void => {
+        if (e.pointerType === "mouse") return;
+        const p = this.pointers.get(e.pointerId);
+        if (p === undefined) return; // 冷却期/非手势指针：忽略
+        p.x = e.clientX;
+        p.y = e.clientY;
+        // 【自愈】两指在案却没有会话 ⇒ 立刻补建。
+        // 为什么需要：本控制器现在由**多个表面**（滚动容器 + 拍数栏 + 琴键轴）共同喂事件，
+        // 序列可能是「第一指在某表面落下 → 第二指落另一表面」，也可能被合成
+        // pointercancel/pointerup（1→2 过渡时中止单指拖拽用的）穿插，导致某一对指针
+        // 落齐而 beginSession 没走到。实测：拍数栏起手的双指能看到两指事件、也派发了
+        // 中止合成事件，却没有会话 ⇒ 手势整体无反应。这里以「状态」为准而不是以
+        // 「某一次 down 的时序」为准，任何后续 move 都能把会话补起来。
+        if (this.pointers.size >= 2 && this.session === null && this.now() >= this.cooldownUntil) {
+            this.beginSession();
+            this.setActiveFlag(true);
+        }
+        if (this.pointers.size < 2) return; // 仍在冷却的单指：忽略
+        e.preventDefault();
+        if (this.now() < this.cooldownUntil) return; // 2→1 冷却期
+        this.update();
+    };
+
+    private readonly onPointerUp = (e: PointerEvent): void => {
+        this.endPointer(e.pointerId);
+    };
+
+    private readonly onPointerCancel = (e: PointerEvent): void => {
+        this.endPointer(e.pointerId);
+    };
+
+    private endPointer(id: number): void {
+        if (!this.pointers.has(id)) return;
+        this.pointers.delete(id);
+        try {
+            this.pointerSurface.get(id)?.releasePointerCapture(id);
+        } catch {
+            /* ignore */
+        }
+        this.pointerSurface.delete(id);
+        if (this.pointers.size < 2) {
+            // 2→1：进入冷却期（docs/08 §4.2），期间忽略单指事件。
+            if (this.session !== null) {
+                this.cooldownUntil = this.now() + this.cooldownMs;
+                this.session = null;
+                /* E22：抬手惯性 —— 用最后一次速度把目标继续推下去。进入惯性期间
+                   活动标志**保持为真**（单指处理器必须继续让位），收尾由循环负责。 */
+                if (!this.startInertia()) this.setActiveFlag(false);
+            }
+            if (this.pointers.size === 0 && this.inertiaVel === null) {
+                this.cooldownUntil = 0;
+                this.viewport.reclamp();
+            }
+        }
+    }
+
+    /**
+     * 抬手惯性（E22）：把最后一次采到的「每毫秒速率」交给循环继续推目标，
+     * 各字段按自己的阈值判定（低于阈值视为 0 ⇒ 那一路不甩）。
+     *
+     * @returns 是否真的进入了惯性（调用方据此决定「活动标志」要不要立刻放下）。
+     */
+    private startInertia(): boolean {
+        const r = this.velPrevRate;
+        this.velPrevRate = null;
+        this.velPrev = null;
+        if (!this.inertiaEnabled || r === null) return false;
+        const pick = (v: number, eps: number): number =>
+            Math.abs(v) > eps ? clamp(v, -INERTIA_V_MAX, INERTIA_V_MAX) : 0;
+        const vel: ViewportSnapshot = {
+            pxPerSec: pick(r.pxPerSec, 0.02),
+            scrollLeft: pick(r.scrollLeft, 0.25),
+            rowHeight: pick(r.rowHeight, 0.02),
+            scrollTop: pick(r.scrollTop, 0.25),
+        };
+        if (vel.pxPerSec === 0 && vel.scrollLeft === 0 && vel.rowHeight === 0 && vel.scrollTop === 0) {
+            return false;
+        }
+        this.inertiaVel = vel;
+        this.schedule();
+        this.setActiveFlag(true);
+        return true;
+    }
+
+    /**
+     * 中止一个既有单指拖拽：复用既有收尾路径——单指拖拽的 finish 挂在 window 的
+     * pointercancel / pointerup 上（见 gestureFocusGuard），派发这两个事件即触发收尾。
+     *
+     * 注意：只 abort「既有的、非本手势追踪的」指针；本手势正在追踪的指针绝不能 cancel，
+     * 否则浏览器会停止向它们派发后续 move 事件。
+     */
+    private abortPointer(id: number): void {
+        for (const type of ["pointercancel", "pointerup"] as const) {
+            const ev = new PointerEvent(type, {
+                pointerId: id,
+                bubbles: true,
+                cancelable: true,
+                pointerType: "touch",
+            });
+            window.dispatchEvent(ev);
+        }
+    }
+
+    /** 刷新容器在视口中的偏移（手势开始时、以及解除死区时各取一次）。 */
+    private refreshRect(): void {
+        const r = this.target.getBoundingClientRect();
+        this.rectLeft = r.left;
+        this.rectTop = r.top;
+    }
+
+    /** 两指中点，换算到**容器坐标系**（与 scrollLeft / scrollTop 同域）。 */
+    private midInContainer(a: ActivePointer, b: ActivePointer): { x: number; y: number } {
+        const m = midpoint(a, b);
+        return { x: m.x - this.rectLeft, y: m.y - this.rectTop };
+    }
+
+    private beginSession(): void {
+        const pts = [...this.pointers.values()];
+        const a = pts[0];
+        const b = pts[1];
+        this.refreshRect();
+        const mid = this.midInContainer(a, b);
+        const span = spanOf(a, b);
+        const v = this.viewport.get();
+        /* 新手势从零开始：清掉上一次残留的目标 / 平滑值 / 速度 / 惯性。 */
+        this.smoothTarget = null;
+        this.smoothApplied = null;
+        this.inertiaVel = null;
+        this.velPrev = null;
+        this.velPrevRate = null;
+        this.session = {
+            mid0: mid,
+            span0: span,
+            scrollLeft0: v.scrollLeft,
+            scrollTop0: v.scrollTop,
+            pxPerSec0: v.pxPerSec,
+            rowHeight0: v.rowHeight,
+            axisLockX: span.x < this.axisLockPx,
+            axisLockY: span.y < this.axisLockPx,
+            zoomArmed: false,
+            axis: this.axisForSession(),
+        };
+    }
+
+    private update(): void {
+        const s = this.session;
+        if (s === null) return;
+        const pts = [...this.pointers.values()];
+        const a = pts[0];
+        const b = pts[1];
+        const mid = this.midInContainer(a, b);
+        const span = spanOf(a, b);
+
+        // 超过死区才允许缩放，并把基准重置到当前，避免跳变（docs/08 §3.1）。
+        if (!s.zoomArmed) {
+            const ddx = span.x - s.span0.x;
+            const ddy = span.y - s.span0.y;
+            if (Math.hypot(ddx, ddy) >= this.deadZonePx) {
+                s.zoomArmed = true;
+                s.mid0 = mid;
+                s.span0 = span;
+                const v = this.viewport.get();
+                s.scrollLeft0 = v.scrollLeft;
+                s.scrollTop0 = v.scrollTop;
+                s.pxPerSec0 = v.pxPerSec;
+                s.rowHeight0 = v.rowHeight;
+            }
+        }
+
+        const multiFinger = this.pointers.size >= 3;
+        // 轴向策略（会话开始时由「两指落在哪个表面」定，见 `axisForSession`）：
+        // 被禁的那一轴**既不缩放也不平移** —— 拍数栏下方没有内容、琴键列右侧也不是
+        // 时间轴，在这些窄条上顺手动另一轴只会让画面莫名其妙地跑偏（用户实测反馈）。
+        const axisLockedX = s.axisLockX || multiFinger || s.axis === "y";
+        const axisLockedY = s.axisLockY || multiFinger || s.axis === "x";
+        const allowX = s.axis !== "y";
+        const allowY = s.axis !== "x";
+
+        /* ── E18 逐帧轴死区（用户口径：「某轴双指坐标过近 ⇒ 该轴缩放算作 0」）─────
+         * 同一轴上两指几乎重合时，那一点点分离度的**相对**变化毫无意义
+         * （5px ↔ 9px 就能算出 1.8×），单轴缩放（最常见用法）还会被顺带成双轴。
+         * 逐帧判：当前分离度 < axisNearPx ⇒ 本帧该轴不缩放，**且把该轴基线重置到当前**
+         * —— 跨过阈值后从「刚跨过的那一点」开始计，不积累出跳变。 */
+        this.nearX = span.x < this.axisNearPx;
+        this.nearY = span.y < this.axisNearPx;
+        if (this.nearX) s.span0.x = span.x;
+        if (this.nearY) s.span0.y = span.y;
+
+        /* ── E18 绝对缩放律：每 1px 分离度变化 ⇒ 缩放 ×e^(zoomPerPx) ─────────────
+         * 与起始分离度**无关**（同一次「张开 60px」永远是同一倍数）⇒ 不再出现
+         * 「起始两指太近 ⇒ 巨大缩放」；也天然对称（远离 k、靠近 1/k），不会像线性律
+         * 那样在窄屏幕上被下界截断。 */
+        const zoomK = (delta: number): number =>
+            Math.exp(clamp(delta, -600, 600) * this.zoomPerPx);
+        const kx = s.zoomArmed && !axisLockedX && !this.nearX ? zoomK(span.x - s.span0.x) : 1;
+        const ky = s.zoomArmed && !axisLockedY && !this.nearY ? zoomK(span.y - s.span0.y) : 1;
+
+        /* 目标值一律**从会话基线**推出（不读「当前视口」）⇒ 平滑滞后不会污染解算。 */
+        const cur = this.viewport.get();
+        const next: ViewportSnapshot =
+            this.smoothTarget ?? {
+                pxPerSec: cur.pxPerSec,
+                scrollLeft: cur.scrollLeft,
+                rowHeight: cur.rowHeight,
+                scrollTop: cur.scrollTop,
+            };
+
+        // 水平：秒锚定（docs/08 §2.2）。先 clamp 再代入，避免锚点漂移。
+        if (allowX) {
+            /* D6：优先走**面板提供的权威解算**（与拍数栏/滚轮同一条
+               `resolveHorizontalWheelZoom`）。拿不到才退回本地算法 —— 本地算法的
+               pxPerSec 上下限是写死的窗口，与落库时的钳制口径不一致，碰边界就会卡。 */
+            const authoritative =
+                kx !== 1 && this.viewport.resolveHorizontalZoom !== undefined
+                    ? this.viewport.resolveHorizontalZoom({
+                          factor: kx,
+                          basePxPerSec: s.pxPerSec0,
+                          baseScrollLeft: s.scrollLeft0,
+                          anchorXInContainer: s.mid0.x,
+                      })
+                    : null;
+            if (authoritative !== null && authoritative !== undefined) {
+                next.pxPerSec = authoritative.pxPerSec;
+                next.scrollLeft = authoritative.scrollLeft;
+            } else {
+                const pxBounds = this.viewport.getPxPerSecBounds();
+                const secAtMid0 = (s.scrollLeft0 + s.mid0.x) / s.pxPerSec0;
+                const targetPxPerSec = clamp(s.pxPerSec0 * kx, pxBounds.min, pxBounds.max);
+                next.pxPerSec = targetPxPerSec;
+                next.scrollLeft = secAtMid0 * targetPxPerSec - mid.x;
+            }
+        }
+
+        // 竖直：行锚定（docs/08 §2.3）。verticalZoom=false 的内核（参数编辑器早期版本：
+        // 纵向缩放入口 valueDomain.span 尚未落地）纵向捏合退化为纯平移 —— 行高恒定时
+        // newScrollTop = scrollTop0 - dy，与行数换算自然退化，无 NaN。
+        if (allowY) {
+            const rhBounds = this.viewport.getRowHeightBounds();
+            const targetRowH = this.verticalZoom
+                ? clamp(s.rowHeight0 * ky, rhBounds.min, rhBounds.max)
+                : s.rowHeight0;
+            const rowAtMid0 = (s.scrollTop0 + s.mid0.y) / s.rowHeight0;
+            next.rowHeight = targetRowH;
+            next.scrollTop = rowAtMid0 * targetRowH - mid.y;
+        }
+
+        /* 速度采样（抬手惯性用）：相邻两次目标的差分 ÷ 时间差。
+         *
+         * ⚠️ 时间差必须有**下限**：一次 `touchMove` 会拆成两个 `pointermove`（每指一个），
+         * 两者相隔 ~1ms ⇒ 用它们算速度会得到一个荒唐的大数（实测把慢速拖动也判成"甩"，
+         * 抬手后莫名其妙地继续滑）。所以只接受 ≥ 8ms 的采样对；> 120ms 视为断点。 */
+        const ts = this.now();
+        if (this.velPrev !== null && ts - this.velPrev.t >= 8 && ts - this.velPrev.t <= 120) {
+            const dts = ts - this.velPrev.t;
+            this.velPrevRate = {
+                pxPerSec: (next.pxPerSec - this.velPrev.s.pxPerSec) / dts,
+                scrollLeft: (next.scrollLeft - this.velPrev.s.scrollLeft) / dts,
+                rowHeight: (next.rowHeight - this.velPrev.s.rowHeight) / dts,
+                scrollTop: (next.scrollTop - this.velPrev.s.scrollTop) / dts,
+            };
+        } else {
+            this.velPrevRate = null;
+        }
+        this.velPrev = { t: ts, s: { ...next } };
+
+        this.smoothTarget = next;
+        this.schedule();
+
+        // 调试钩子（CDP 验收用）：暴露"为什么这一轴没动"的中间量 ——
+        // axis / 轴锁 / 多指 / 过近判定 / 缩放因子 / 缩放律系数 / 行高前后值。
+        // 只写基本类型字段，不给每帧分配大对象（move 频率高）。
+        const dbg = window as unknown as { __hsGestureDebug?: unknown };
+        dbg.__hsGestureDebug = {
+            axis: s.axis,
+            allowX,
+            allowY,
+            lockX: axisLockedX,
+            lockY: axisLockedY,
+            multi: multiFinger,
+            armed: s.zoomArmed,
+            nearX: this.nearX,
+            nearY: this.nearY,
+            /** 当前分离度与**会话基线**（探头据此精确复算期望倍数）。 */
+            sx: +span.x.toFixed(2),
+            sy: +span.y.toFixed(2),
+            sx0: +s.span0.x.toFixed(2),
+            sy0: +s.span0.y.toFixed(2),
+            /** 两指中点在**容器坐标系**（与 scrollLeft 同域）。 */
+            mx: +mid.x.toFixed(2),
+            my: +mid.y.toFixed(2),
+            law: this.zoomPerPx,
+            kx: +kx.toFixed(4),
+            ky: +ky.toFixed(4),
+            vZoom: this.verticalZoom,
+            rowH0: +s.rowHeight0.toFixed(3),
+            rowH: +this.viewport.get().rowHeight.toFixed(3),
+            inertia: this.inertiaVel !== null,
+        };
+    }
+
+    /** 请求下一帧（幂等）。E22：平滑与惯性共用同一条 rAF 循环。 */
+    private schedule(): void {
+        if (this.rafId !== null) return;
+        this.rafId = requestAnimationFrame(this.loop);
+    }
+
+    /**
+     * 平滑 / 惯性循环（E18 + E22）。
+     *
+     * 每一帧做三件事：① 惯性把「目标」继续推下去并按指数衰减；② 让「当前值」
+     * 按 `1 − e^(−dt/τ)` 追目标；③ 只在**真的变了**的时候提交给视口
+     * （避免每帧 no-op 地打内核入口）。没有活会话、没有惯性、且已追上 ⇒ 收尾
+     * （`reclamp()` + 清活动标志）。
+     */
+    private readonly loop = (): void => {
+        this.rafId = null;
+        const now = this.now();
+        const dt = Math.max(1, Math.min(64, now - (this.lastFrameTs || now)));
+        this.lastFrameTs = now;
+
+        const cur = this.viewport.get();
+        if (this.smoothApplied === null) {
+            this.smoothApplied = {
+                pxPerSec: cur.pxPerSec,
+                scrollLeft: cur.scrollLeft,
+                rowHeight: cur.rowHeight,
+                scrollTop: cur.scrollTop,
+            };
+        }
+        if (this.smoothTarget === null) this.smoothTarget = { ...this.smoothApplied };
+
+        if (this.inertiaVel !== null) {
+            const v = this.inertiaVel;
+            this.smoothTarget.pxPerSec += v.pxPerSec * dt;
+            this.smoothTarget.scrollLeft += v.scrollLeft * dt;
+            this.smoothTarget.rowHeight += v.rowHeight * dt;
+            this.smoothTarget.scrollTop += v.scrollTop * dt;
+            const decay = Math.exp(-INERTIA_FRICTION_PER_MS * dt);
+            v.pxPerSec *= decay;
+            v.scrollLeft *= decay;
+            v.rowHeight *= decay;
+            v.scrollTop *= decay;
+            if (
+                Math.abs(v.scrollLeft) < 0.02 &&
+                Math.abs(v.scrollTop) < 0.02 &&
+                Math.abs(v.pxPerSec) < 0.002 &&
+                Math.abs(v.rowHeight) < 0.003
+            ) {
+                this.inertiaVel = null;
+            }
+        }
+
+        const ap = this.smoothApplied;
+        const a = this.smoothTauMs <= 0 ? 1 : 1 - Math.exp(-dt / this.smoothTauMs);
+        ap.pxPerSec += (this.smoothTarget.pxPerSec - ap.pxPerSec) * a;
+        ap.scrollLeft += (this.smoothTarget.scrollLeft - ap.scrollLeft) * a;
+        ap.rowHeight += (this.smoothTarget.rowHeight - ap.rowHeight) * a;
+        ap.scrollTop += (this.smoothTarget.scrollTop - ap.scrollTop) * a;
+
+        const movedH =
+            Math.abs(ap.pxPerSec - cur.pxPerSec) > 1e-6 ||
+            Math.abs(ap.scrollLeft - cur.scrollLeft) > 1e-3;
+        const movedV =
+            Math.abs(ap.rowHeight - cur.rowHeight) > 1e-6 ||
+            Math.abs(ap.scrollTop - cur.scrollTop) > 1e-3;
+        if (movedH) this.viewport.setHorizontal(ap.pxPerSec, ap.scrollLeft);
+        if (movedV) this.viewport.setVertical(ap.rowHeight, ap.scrollTop);
+
+        const converging =
+            Math.abs(this.smoothTarget.scrollLeft - ap.scrollLeft) > 0.4 ||
+            Math.abs(this.smoothTarget.scrollTop - ap.scrollTop) > 0.4 ||
+            Math.abs(this.smoothTarget.pxPerSec - ap.pxPerSec) > 0.4 ||
+            Math.abs(this.smoothTarget.rowHeight - ap.rowHeight) > 0.04;
+        if (this.session !== null || this.inertiaVel !== null || converging) {
+            this.schedule();
+            return;
+        }
+        this.smoothTarget = null;
+        this.smoothApplied = null;
+        this.velPrev = null;
+        this.velPrevRate = null;
+        /* ⚠️ **不要**在这里清 `cooldownUntil`：它是 2→1 过渡的防误触窗口
+           （docs/08 §4.2），归零会让"第二指刚抬起时的那一下单指事件"立刻被当成
+           新的单指手势。冷却由 `endPointer` 负责，自己会到期。 */
+        this.viewport.reclamp();
+        this.setActiveFlag(false);
+    };
+
+    private setActiveFlag(on: boolean): void {
+        const w = window as unknown as { __hsGestureActive?: boolean };
+        w.__hsGestureActive = on;
+    }
+
+    private now(): number {
+        return typeof performance !== "undefined" ? performance.now() : Date.now();
+    }
+}
diff --git a/frontend/src/components/mobile/BottomTabs.tsx b/frontend/src/components/mobile/BottomTabs.tsx
new file mode 100644
index 00000000..956a8bb5
--- /dev/null
+++ b/frontend/src/components/mobile/BottomTabs.tsx
@@ -0,0 +1,64 @@
+/**
+ * BottomTabs — 手机形态的底部页签（`docs/04` §3.2）。
+ *
+ * 手机上时间线（~250px 有效高）与参数面板（~300px）在竖屏放不下，因此二者**互斥**，
+ * 由底部页签切换，而不是像桌面那样上下并排。
+ *
+ * 触摸目标 ≥ 56px（Material 要求 48dp，这里留出富余）；字号 16px 起。
+ * 颜色一律继承主题（用 `currentColor`），不硬编码，自动适配明暗主题。
+ *
+ * 底部安全区不在本组件处理：`App.tsx` 根容器统一加 `padding-bottom:
+ * env(safe-area-inset-bottom)`，这里再加会翻倍。
+ */
+
+import { useI18n } from "../../i18n/I18nProvider";
+import type { MessageKey } from "../../i18n/messages";
+
+export type MobileTab = "timeline" | "params" | "files" | "notes";
+
+interface BottomTabsProps {
+    active: MobileTab;
+    onChange: (tab: MobileTab) => void;
+}
+
+const TABS: ReadonlyArray<{ id: MobileTab; labelKey: MessageKey }> = [
+    { id: "timeline", labelKey: "mobile_tab_timeline" },
+    { id: "params", labelKey: "mobile_tab_params" },
+    { id: "files", labelKey: "mobile_tab_files" },
+    { id: "notes", labelKey: "mobile_tab_notes" },
+];
+
+export const MOBILE_TAB_HEIGHT = 56;
+
+export function BottomTabs({ active, onChange }: BottomTabsProps) {
+    const { t } = useI18n();
+    return (
+        <nav
+            className="shrink-0 flex bg-qt-window border-t border-qt-border"
+            aria-label={t("mobile_tab_switcher")}
+        >
+            {TABS.map((tab) => {
+                const selected = tab.id === active;
+                return (
+                    <button
+                        key={tab.id}
+                        type="button"
+                        onClick={() => onChange(tab.id)}
+                        aria-current={selected ? "page" : undefined}
+                        className="flex-1 flex items-center justify-center bg-transparent border-0 cursor-pointer"
+                        style={{
+                            minHeight: MOBILE_TAB_HEIGHT,
+                            fontSize: 16,
+                            fontWeight: selected ? 600 : 400,
+                            opacity: selected ? 1 : 0.6,
+                            borderTop: selected ? "2px solid currentColor" : "2px solid transparent",
+                            WebkitTapHighlightColor: "transparent",
+                        }}
+                    >
+                        {t(tab.labelKey)}
+                    </button>
+                );
+            })}
+        </nav>
+    );
+}
diff --git a/frontend/src/components/mobile/ClipControlPoints.tsx b/frontend/src/components/mobile/ClipControlPoints.tsx
new file mode 100644
index 00000000..7776c34e
--- /dev/null
+++ b/frontend/src/components/mobile/ClipControlPoints.tsx
@@ -0,0 +1,321 @@
+/**
+ * 音频块左右「控制点」—— E5 重做（用户口径）：
+ *
+ *   「音频块两侧的控制点画成**音频块外面的圆点**（类似 flm），按下控制点后**隐藏临时的常用功能菜单**，
+ *     圆点**能跟手**，**上下移动后圆点的样式会带有对应的功能的图标**，
+ *     再开始左右拖动时**圆点始终存在直至松手**」。
+ *
+ * 与旧实现的差别：
+ *   · 旧版画的是**块内侧的竖条**（`GRIP_VISUAL_WIDTH` 4px 宽、贴着边缘）；
+ *   · 新版画**块外侧的圆点**（`pointer-events: none` 的浮层，不吃内核命中区 —— 这一条是**架构约束**：
+ *     内核的左右边缘命中带就在块内侧，浮层一旦可命中就会像当年 `ClipQuickActions` 那样把命中区压死；
+ *     把圆点放到**块外**正好顺带解决了这个冲突）。
+ *
+ * 为什么不做成"可点中的按钮"：那必然要 `pointer-events: auto` ⇒ 盖住内核命中区 ⇒
+ * 「调整音频块边界」失效。所以这里改用**全局指针旁听**：手指按在"块外侧、控制点附近"时进入
+ * **跟手模式**（纯视觉），数值改动照旧由内核处理 —— 看得见的是我们，摸得着的仍是内核。
+ *
+ * 上下移动 ⇒ 切换图标，语义与内核一致（`timelineKernelHost` 的 `pending-select`）：
+ *   · 向上 = 淡入淡出（fade）；
+ *   · 向下 = 变速（rate）。
+ */
+import React from "react";
+import { useClipOverlayGeometry } from "./useClipOverlayGeometry";
+import { dispatchClipEdgeLongPressHint } from "./ClipEdgeLongPressHint";
+
+/** 圆点半径（直径 14），比旧版竖条更接近 flm 的抓手观感。 */
+const DOT_R = 7;
+/**
+ * 与内核命中带**逐像素对齐**的两个量（`hitTest.ts` 的 `OUTSIDE_EDGE_SLACK_PX` /
+ * `EDGE_WIDTH_PX`）。浮层只负责"看得见"，所以它的判定范围必须与内核一致：
+ *   左控制点可点范围 = `[边 − 18, 边 + 10]`，右控制点对称。
+ *
+ * 🔴 原先这里用的是"以块外圆点中心 ±40"，比内核宽得多 ⇒ **内核不认的按下也会点亮
+ * "抓住了"的假反馈**，而真正按在圆点正中时内核又落空（圆点在块外，内核只认块内 10px）
+ * ⇒ 用户看到「视觉位置与点击位置有偏差；按控制点却把块拖走」。内核那侧同步外扩后
+ * 才是"看得见就按得中"。
+ */
+const OUTSIDE_EDGE_SLACK_PX = 18;
+const INNER_EDGE_PX = 10;
+/** 纵向容差：内核要求严格落在边缘竖直带内，浮层给一点手指粗度。 */
+const VERTICAL_SLACK_PX = 12;
+/** 纵向移动超过这个距离才算"选了功能"（避免手抖就换图标）。 */
+const MODE_THRESHOLD_PX = 18;
+/**
+ * 「那一竖」的宽度：还压在这个横向范围内才算"没离开竖轨"，此时才允许上下换档。
+ * 与下面的 `MODE_THRESHOLD_PX` 一起构成"王"字的连通规则（见 `onMove`）。
+ */
+const VERTICAL_CORRIDOR_PX = 14;
+/**
+ * 三条**横轨**之间的间距（≈ 一行轨道高）：中间那条是块的中线，
+ * 上/下两条分别落到上一行 / 下一行 —— 也就是"王"字的上横与下横。
+ * 与 `DOT_FOLLOW_MARGIN_PX` 取同一个值：那个余量本来就是"一行轨道"的尺度。
+ */
+const RAIL_DISTANCE_PX = 44;
+/** 判定为"左右拖动"的横向位移。 */
+const DRAG_THRESHOLD_PX = 6;
+/** E24-④（用户 2026-10-01 口径：「**限制圆点的显示，让它在音频块附近**」）：
+ *  圆点"跟手"是规格要求（`docs/15`：圆点能跟手），但**不钳制**时手指划到屏幕另一头、
+ *  圆点也跟着飞出去 —— 既看不出在调哪条边，又挡住别处的 UI。这里把**绘制位置**钳在
+ *  「块矩形 + 一圈余量」内再与容器求交：横向左右各留这么多，纵向上下各留这么多
+ *  （竖向余量 ≥ `MODE_THRESHOLD_PX` 才够显示"上=fade / 下=rate"的换图标反馈）。 */
+const DOT_FOLLOW_MARGIN_PX = 44;
+
+type Mode = "none" | "fade" | "rate";
+
+/** 淡入淡出图标：三角形的淡变楔形。 */
+const FadeGlyph = () => (
+    <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden>
+        <path d="M1 11 L11 1 L11 11 Z" fill="currentColor" opacity="0.9" />
+    </svg>
+);
+/** 变速图标：双箭头（左右各一），与"横向滑动改变速度"对应。 */
+const RateGlyph = () => (
+    <svg width="12" height="12" viewBox="0 0 12 12" aria-hidden>
+        <path d="M1 6 L4 3.5 L4 8.5 Z" fill="currentColor" />
+        <path d="M11 6 L8 3.5 L8 8.5 Z" fill="currentColor" />
+        <rect x="4.5" y="5.4" width="3" height="1.2" fill="currentColor" />
+    </svg>
+);
+
+export function ClipControlPoints() {
+    const g = useClipOverlayGeometry();
+    /** 正在被抓住的那一侧（null = 没抓）。 */
+    const [grab, setGrab] = React.useState<{
+        side: "left" | "right";
+        x: number;
+        y: number;
+        /** **起手点** —— 判"上=fade / 下=rate"与"那一竖在哪"都必须与它比。 */
+        startX: number;
+        startY: number;
+        mode: Mode;
+        dragging: boolean;
+    } | null>(null);
+    /** 几何放进 ref：指针旁听器只挂一次，不能每帧重挂。 */
+    const geomRef = React.useRef(g);
+    geomRef.current = g;
+
+    /**
+     * 🔴 2026-10-03（用户口径）：「淡出与变速这两个**临时窗口**应该**滑动到"王"的上下边后
+     * 就消失**」。
+     *
+     * 那个提示窗（`ClipEdgeLongPressHint`，两个 pill）的使命是"告诉用户往上 / 往下各有什么"，
+     * 属于两段式手势的**第一段**反馈。一旦圆点真的滑进了上横轨（fade）或下横轨（rate），
+     * 用户已经从圆点自身的图标态看到结果 ⇒ 提示应当退场，别再一直占着轨道上方 / 下方。
+     *
+     * 实现放在 `useEffect` 里（而不是 `onMove` 的 setState updater 内）：
+     * updater 必须是纯函数（StrictMode 会双调），而且它**异步执行**，在里面做副作用
+     * 既可能重发、也可能读到还没提交的值。这里只比较"上一帧 mode → 本帧 mode"。
+     */
+    const prevModeRef = React.useRef<Mode>("none");
+    React.useEffect(() => {
+        const m: Mode = grab?.mode ?? "none";
+        if (m !== "none" && prevModeRef.current === "none") {
+            dispatchClipEdgeLongPressHint(null);
+        }
+        prevModeRef.current = m;
+    }, [grab?.mode]);
+
+    // 全局旁听：按下时判断"是否抓在块外侧的控制点附近"。
+    React.useEffect(() => {
+        const onDown = (e: PointerEvent) => {
+            const geo = geomRef.current;
+            if (!geo || !geo.isPhone || geo.multiSelectedCount > 1 || !geo.horizontallyVisible) return;
+            // 只认主指针（多指手势交给内核的缩放/平移）。
+            if (!e.isPrimary) return;
+            const yTop = geo.edgeBandTop;
+            const yBottom = yTop + Math.max(8, geo.edgeBandHeight);
+            if (e.clientY < yTop - VERTICAL_SLACK_PX || e.clientY > yBottom + VERTICAL_SLACK_PX) {
+                return;
+            }
+            /* 与内核命中带**逐像素对齐**（见上面两个常量的说明）：
+               左控制点 = [边−18, 边+10]，右控制点对称。 */
+            const leftHit =
+                e.clientX >= geo.left - OUTSIDE_EDGE_SLACK_PX &&
+                e.clientX <= geo.left + INNER_EDGE_PX;
+            const rightHit =
+                e.clientX >= geo.left + geo.width - INNER_EDGE_PX &&
+                e.clientX <= geo.left + geo.width + OUTSIDE_EDGE_SLACK_PX;
+            if (!leftHit && !rightHit) return;
+            const side: "left" | "right" = leftHit ? "left" : "right";
+            /* 🔴 2026-10-03 用户口径（第二次报）：「触摸到控制点后**常用功能临时菜单**
+               就应该隐藏了」。
+               原先这条广播放在下面"圆点是否可点"判定**之后** ⇒ 只有圆点**画出来**时才隐藏。
+               而圆点在贴容器边缘时是**不画**的（`dotPressable`，规格如此），可用户手指按的
+               正是**块边缘那条命中带**（圆点本来就贴在边缘上）—— 此时浮条照旧挡在那儿
+               ⇒ 用户看到的就是"触摸了控制点但浮条没消失"。
+               ⇒ **广播提前**：只要按进左右控制点的命中带就隐藏浮条；
+                  `setGrab`（点亮圆点的视觉反馈）继续受 `dotPressable` 约束。
+               另外补一个"手势结束"通知，让浮条在**整段手势期间**都不许自己回来
+               （只靠时间窗在长按拖动时会漏，见 `ClipQuickActions` 的 `grabActiveRef`）。 */
+            window.dispatchEvent(new CustomEvent("hs-hide-clip-actions"));
+            /* 与渲染同一条判据：按不到的圆点不参与反馈（否则又变成"有反馈、没效果"）。 */
+            const baseX = side === "left" ? geo.left - DOT_R - 3 : geo.left + geo.width + DOT_R + 3;
+            if (baseX < geo.container.left + DOT_R || baseX > geo.container.left + geo.container.width - DOT_R) {
+                return;
+            }
+            setGrab({
+                side,
+                x: e.clientX,
+                y: e.clientY,
+                /* 🔴 位移基准 = **起手点**。原实现判 mode 用的是 `e.clientY - prev.y`，
+                   而 `prev.y` 每个 move 都被刷成当前值 ⇒ 那其实是"**每帧增量**"：
+                   真机每次 move 只有几像素，几乎永远够不到 18px 的门槛
+                   ⇒ **图标根本不换** —— 用户报的「之前版本做的控制点的图标变化没了」
+                   （之前偶尔能看到，是快速大跨度划动时单帧增量超了阈值）。
+                   现在与起手点比，慢速划动也能稳定进入上/下横轨。 */
+                startX: e.clientX,
+                startY: e.clientY,
+                mode: "none",
+                dragging: false,
+            });
+        };
+        const onMove = (e: PointerEvent) => {
+            setGrab((prev) => {
+                if (!prev) return prev;
+                /* ── 王字型轨道（用户口径：「控制在"王"字型轨道没做到……想象弹珠在
+                   王字型凹槽内滚动的样子，控制点上划进入上方一横，想回到中下轨
+                   只能从那一竖回来」）────────────────────────────────────────────
+                   三横：上一行 = fade、本行 = 中、下一行 = rate；
+                   一竖：**起手点那一列**。
+                   ⇒ 只有还压在那一竖上（|dx| ≤ `VERTICAL_CORRIDOR_PX`）才允许上下换档；
+                     已经在横轨上横向划开了，就**必须先回到那一竖**才能再回到中/下横轨。
+                   ⇒ 想从 fade 直接跳到 rate 也不行：`|dy| < MODE_THRESHOLD_PX` 时
+                     mode 必然回到 `none`（= 中轨），必须先"回到中轨"这一步。 */
+                const dx = e.clientX - prev.startX;
+                const dy = e.clientY - prev.startY;
+                const onVertical = Math.abs(dx) <= VERTICAL_CORRIDOR_PX;
+                let mode: Mode = prev.mode;
+                if (onVertical) {
+                    mode =
+                        Math.abs(dy) >= MODE_THRESHOLD_PX ? (dy < 0 ? "fade" : "rate") : "none";
+                }
+                const dragging = prev.dragging || Math.abs(dx) >= DRAG_THRESHOLD_PX;
+                // 「圆点能跟手」：位置跟随当前指针；纵向的"吸附到哪条横轨"在渲染侧按 mode 决定。
+                return { ...prev, x: e.clientX, y: e.clientY, mode, dragging };
+            });
+        };
+        const onUp = () => {
+            /* 整段控制点手势结束 ⇒ 通知浮条"可以恢复按常理判断了"
+               （它靠这个把 `grabActive` 放下，见 `ClipQuickActions`）。 */
+            window.dispatchEvent(new CustomEvent("hs-control-point-grab-end"));
+            setGrab(null);
+        };
+        window.addEventListener("pointerdown", onDown, true);
+        window.addEventListener("pointermove", onMove, true);
+        window.addEventListener("pointerup", onUp, true);
+        window.addEventListener("pointercancel", onUp, true);
+        return () => {
+            window.removeEventListener("pointerdown", onDown, true);
+            window.removeEventListener("pointermove", onMove, true);
+            window.removeEventListener("pointerup", onUp, true);
+            window.removeEventListener("pointercancel", onUp, true);
+        };
+    }, []);
+
+    if (g === null || !g.isPhone) return null;
+    /**
+     * 圆点中心是否落在**时间线容器内**（能按到的范围）。
+     *
+     * 块外圆点会被推到容器之外：块左缘正好贴容器左缘时（scrollLeft = 0 且 startSec = 0），
+     * 左圆点中心 = `容器左 − 10` ⇒ **落进左侧的轨道头列**。那里按下去归轨道头管，
+     * 圆点成了"看得见按不到"的死区（实测真机：`dotLeft.x = 122`，而时间线从 132 才开始）。
+     * ⇒ 按不到就**不画**。内核"块内 10px"的命中带仍在，需要裁切时按边缘内侧即可。
+     */
+    const dotPressable = (x: number): boolean =>
+        x >= g.container.left + DOT_R && x <= g.container.left + g.container.width - DOT_R;
+    const baseXOf = (side: "left" | "right"): number =>
+        side === "left" ? g.left - DOT_R - 3 : g.left + g.width + DOT_R + 3;
+    if (g.multiSelectedCount > 1) return null;
+    if (!g.horizontallyVisible) return null;
+
+    const height = Math.max(8, g.edgeBandHeight);
+    const centerY = g.edgeBandTop + height / 2;
+
+    /** 圆点：默认贴在**块外侧**（左点再往左偏一个半径，右点往右）。 */
+    const dot = (side: "left" | "right"): React.ReactNode => {
+        const grabbed = grab?.side === side;
+        const baseX = baseXOf(side);
+        /* 跟手 + **不许跑离块附近**（E24-④）：先按"块矩形 ± 余量"钳，再与容器求交
+           （取交集的下/上界，保证既不出屏也不脱离块）。 */
+        const minX = Math.max(g.container.left + DOT_R, g.left - DOT_FOLLOW_MARGIN_PX);
+        const maxX = Math.min(
+            g.container.left + g.container.width - DOT_R,
+            g.left + g.width + DOT_FOLLOW_MARGIN_PX,
+        );
+        /* 🔴 2026-10-03 **王字型轨道**（取代 E24-⑤ 的"纵向一律夹在本行内"）：
+           用户口径「控制在"王"字型轨道没做到……控制点上划**进入上方一横**……
+           想回到中下轨只能从那一竖回来」。
+           纵向**只有三条横轨**（彼此相距 `RAIL_DISTANCE_PX`）：
+             上 = fade（落进上一行）/ 中 = 本行 / 下 = rate（落进下一行）；
+           停哪条由 `mode` 决定，而 `mode` **只在起手那一竖上才会变**（见 `onMove`）
+           ⇒ "已在横轨上就必须先回那一竖"这个约束自然成立。
+           横向仍跟手（横向才是"拖边界"的方向），只受"块附近 ±`DOT_FOLLOW_MARGIN_PX`"
+           与容器求交的约束。
+           ⚠️ 原先把纵向夹在 `[g.top, g.top + g.clipHeight]` —— 那样圆点**永远进不了上一横**，
+              用户看到的"没有上下轨道"就是这个。 */
+        const minY = Math.max(g.container.top + DOT_R, centerY - DOT_FOLLOW_MARGIN_PX);
+        const maxY = Math.min(
+            g.container.top + g.container.height - DOT_R,
+            centerY + DOT_FOLLOW_MARGIN_PX,
+        );
+        const clamp = (v: number, lo: number, hi: number) =>
+            Math.min(Math.max(v, Math.min(lo, hi)), Math.max(lo, hi));
+        const x = grabbed ? clamp(grab.x, minX, maxX) : baseX;
+        const mode: Mode = grabbed ? grab.mode : "none";
+        const railY =
+            mode === "fade"
+                ? centerY - RAIL_DISTANCE_PX
+                : mode === "rate"
+                  ? centerY + RAIL_DISTANCE_PX
+                  : centerY;
+        const y = grabbed ? clamp(railY, minY, maxY) : centerY;
+        return (
+            <div
+                key={side}
+                data-hs-clip-control-point={side}
+                data-hs-control-mode={mode}
+                data-hs-control-dragging={grabbed && grab.dragging ? "1" : undefined}
+                style={{
+                    position: "fixed",
+                    left: x,
+                    top: y,
+                    width: DOT_R * 2,
+                    height: DOT_R * 2,
+                    transform: "translate(-50%, -50%)",
+                    borderRadius: 999,
+                    display: "flex",
+                    alignItems: "center",
+                    justifyContent: "center",
+                    // 被抓住时变大一点，并换成强调色 —— 明确"现在归我控制"。
+                    background: grabbed ? "var(--accent-9, rgb(91, 91, 214))" : "rgba(255,255,255,0.92)",
+                    color: grabbed ? "#fff" : "rgba(0,0,0,0.75)",
+                    border: "1px solid rgba(0,0,0,0.45)",
+                    boxShadow: "0 1px 4px rgba(0,0,0,0.5)",
+                    scale: grabbed ? "1.35" : "1",
+                    /* 横向必须**零延迟**跟手（那是"拖边界"）；纵向给一点缓动 ⇒
+                       吸附到上/下横轨时像"弹珠滚进凹槽"（用户口径的观感）。 */
+                    transition: grabbed
+                        ? "top 110ms ease-out, scale 120ms ease"
+                        : "left 120ms ease, top 120ms ease, scale 120ms ease",
+                    pointerEvents: "none",
+                }}
+            >
+                {/* 上下移动后带对应功能的图标（fade = 淡入淡出 / rate = 变速）。 */}
+                {mode === "fade" ? <FadeGlyph /> : mode === "rate" ? <RateGlyph /> : null}
+            </div>
+        );
+    };
+
+    return (
+        <div
+            data-hs-clip-control-points
+            /* 🔴 2026-10-03（用户口径）：三个手机浮层要**盖住轨道头 / 拍数栏**
+               ⇒ 原来裸数字 25 与拍数栏同档 ⇒ 改用设计令牌 `--hs-z-transient`（60）。 */
+            style={{ position: "absolute", left: 0, top: 0, zIndex: "var(--hs-z-transient)", pointerEvents: "none" }}
+        >
+            {dotPressable(baseXOf("left")) ? dot("left") : null}
+            {dotPressable(baseXOf("right")) ? dot("right") : null}
+        </div>
+    );
+}
