+    current: string;
+    onPick: (mode: string) => void;
+    onClose: () => void;
+    label: string;
+    /** 锚点元素选择器；不传则退回 `offsetParent` / 父元素。 */
+    anchorSelector?: string;
+    /** 兼容旧探针的额外 data 属性。 */
+    extraAttrs?: Record<string, string>;
