+            <ExportAudioDialog open={exportOpen} onOpenChange={setExportOpen} />
+            <AppearanceSettingsDialog open={appearanceOpen} onOpenChange={setAppearanceOpen} />
+            {autoBackupSettings ? (
+                <AutoBackupDialog
+                    open={autoBackupOpen}
+                    settings={autoBackupSettings}
+                    onOpenChange={setAutoBackupOpen}
+                    onSettingsSaved={(next) => onAutoBackupSettingsSaved?.(next)}
+                />
+            ) : null}
+            <RecordingSettingsDialog open={recordingOpen} onOpenChange={setRecordingOpen} />
+            <SnapGridSettingsDialog open={snapOpen} onOpenChange={setSnapOpen} />
+            <TimelineDisplaySettingsDialog open={timeDisplayOpen} onOpenChange={setTimeDisplayOpen} />
