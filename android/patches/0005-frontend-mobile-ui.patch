-            (resolve) => {
-                setAwaitingConflictDecision(true);
-                conflictResolverRef.current = (value) => {
-                    setAwaitingConflictDecision(false);
-                    resolve(value);
-                };
-                setConflictDialog({ open: true, path, applyAll: false, kind });
-            },
-        );
-    }
