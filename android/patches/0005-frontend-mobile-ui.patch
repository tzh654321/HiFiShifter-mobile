--- /dev/null
+++ b/frontend/src/components/layout/StorageSettingsDialog.tsx
@@ -0,0 +1,222 @@
+/**
+ * StorageSettingsOverlay —— E21：「选项 → 存储设置」。
+ *
+ * 用户口径（TASKS.md E21）：
+ *   · 默认存储目录 = `storage/emulated/0/HiFiShifter`（录音、工程等），未授权时回退 android/data；
+ *   · 这一栏要能**查看并跳转三种授权的生效情况**。
+ *
+ * 🔴 为什么**不用 radix `Dialog`**：真机实测"点开即整页卡死"（CDP 求值全部 30s 超时、
+ *    进程存活、logcat **没有任何 console 错误**）⇒ 是**同步阻塞**而不是抛异常。
+ *    与工作正常的 `ExportAudioDialog`（同样用 radix Dialog）对比后，怀疑是 radix Dialog 的
+ *    滚动锁 / 聚焦陷阱在我们这种超大 DOM 上打转（它们都要遍历页面）。
+ *    本项目里 `SelectToolMenu` / `DrawToolMenu` 这类浮层一律**自绘**（fixed 定位 + 量锚点 +
+ *    夹进视口）⇒ 这里沿用同一手法：一个 `fixed inset-0` 的背板 + 居中的面板，
+ *    没有 portal、没有滚动锁、没有聚焦陷阱，行为完全可控。
+ */
+import React from "react";
+import { Button, Flex, Text } from "@radix-ui/themes";
+import { useI18n } from "../../i18n/I18nProvider";
+import { useAppDispatch } from "../../app/hooks";
+import { fileBrowserApi } from "../../services/api/fileBrowser";
+import { loadDirectory } from "../../features/fileBrowser/fileBrowserSlice";
+import { ExitPresence } from "../../hooks/useExitPresence";
+import { showMobilePanel } from "../../features/session/sessionSlice";
+
+interface StorageReport {
+    ok: boolean;
+    customRoot: string;
+    defaultRoot: string;
+    effectiveRoot: string;
+    fallbackRoot: string;
+    usingFallback: boolean;
+    access: { allFiles: boolean; safTree: boolean; safPrefix: string; shizuku: boolean };
+}
+
+interface Props {
+    open: boolean;
+    onOpenChange: (open: boolean) => void;
+}
+
+export function StorageSettingsDialog({ open, onOpenChange }: Props) {
+    const { t } = useI18n();
+    const tAny = t as (key: string) => string;
+    const dispatch = useAppDispatch();
+    const [report, setReport] = React.useState<StorageReport | null>(null);
+    const [busy, setBusy] = React.useState(false);
+
+    const refresh = React.useCallback(async () => {
+        const r = (await fileBrowserApi
+            .storageSettingsState()
+            .catch(() => null)) as StorageReport | null;
+        setReport(r);
+    }, []);
+
+    React.useEffect(() => {
+        if (!open) return;
+        void refresh();
+    }, [open, refresh]);
+
+    /** 「跳转」= 在**应用内**文件浏览器打开该目录（不依赖各 ROM 的文件管理器 Intent）。 */
+    const openInApp = (path: string) => {
+        if (!path) return;
+        void dispatch(loadDirectory(path));
+        dispatch(showMobilePanel("files"));
+        onOpenChange(false);
+    };
+
+    const row = (
