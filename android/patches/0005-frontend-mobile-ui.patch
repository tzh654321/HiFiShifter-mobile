--- a/frontend/src/features/fileBrowser/audioPreview.ts
+++ b/frontend/src/features/fileBrowser/audioPreview.ts
@@ -135,3 +135,20 @@ class AudioPreviewEngine {
 
 /** 全局单例 */
 export const audioPreview = new AudioPreviewEngine();
+
+/* 调试钩子（与 `__hsViewport` / `__hsParamViewport` 同一约定）：
+   试听走 WebAudio，DOM 上没有"正在响"的可观测量 —— 要验
+   「传输栏按停止能不能停掉试听」只能问引擎自己。只读 + 一个 stop，不改行为。
+
+   ⚠️ **必须判环境**：本模块现在被 `transportThunks` import（"按停止也停试听"那条修复），
+   而 sessionSlice → transportThunks 这条链会被**大量单元测试**导入 ——
+   在 Node（vitest 的无 DOM 用例）里没有 `window`，模块顶层直接访问会让整个套件加载失败
+   （实测：9 个套件 Failed Suites、少跑 21 个用例）。 */
+if (typeof window !== "undefined") {
+    (
+        window as unknown as { __hsAudioPreview?: { playing: () => boolean; stop: () => void } }
+    ).__hsAudioPreview = {
+        playing: () => audioPreview.isPlaying(),
+        stop: () => audioPreview.stop(),
+    };
+}
