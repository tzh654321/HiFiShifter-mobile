+                minWidth: 44,
+                display: "inline-flex",
+                alignItems: "center",
+                justifyContent: "center",
+                borderRadius: 999,
+                border: `1px solid ${visible ? "transparent" : "var(--qt-border, rgba(255,255,255,0.18))"}`,
+                color: visible ? "var(--white-a12, #fff)" : "var(--accent-11, rgb(177, 169, 255))",
+                background: visible ? "var(--accent-9, rgb(91, 91, 214))" : "transparent",
+                WebkitTapHighlightColor: "transparent",
