@@ -0,0 +1,54 @@
+import { describe, expect, it } from "vitest";
+
+import { computeReorderShifts, REORDER_SHIFT_MS } from "./trackReorder";
+
+/**
+ * E33 轨道拖动排序的**让位几何**。
+ *
+ * 为什么要单测：这段映射算错的三种方式（方向反了 / 少让一行 / 把被拖行自己也算了）
+ * 在设备上都不容易一眼看出来 —— 表现分别是"拖到下面却往上让"、"抬手后顺序和看到的差一格"、
+ * "被拖行同时被两处位移叠加 ⇒ 抖动"。纯函数，直接喂下标就能钉死。
+ */
+describe("拖动排序：让位位移", () => {
+    const ROW = 80;
+
+    it("往下拖：被经过的行各**上移**一行（让出空槽）", () => {
+        const s = computeReorderShifts(["a", "b", "c", "d"], 0, 2, ROW);
+        expect(s).toEqual({ b: -ROW, c: -ROW });
+        // 被拖行自己不含在内（它用跟手位移），未被经过的行不动
+        expect(s.a).toBeUndefined();
+        expect(s.d).toBeUndefined();
+    });
+
+    it("往上拖：被经过的行各**下移**一行", () => {
+        const s = computeReorderShifts(["a", "b", "c", "d"], 3, 1, ROW);
+        expect(s).toEqual({ b: ROW, c: ROW });
+    });
+
+    it("只挪一格：只有相邻那一行让位", () => {
+        expect(computeReorderShifts(["a", "b", "c"], 1, 2, ROW)).toEqual({ c: -ROW });
+        expect(computeReorderShifts(["a", "b", "c"], 1, 0, ROW)).toEqual({ a: ROW });
+    });
+
+    it("原地不动 ⇒ 没有任何位移", () => {
+        expect(computeReorderShifts(["a", "b", "c"], 1, 1, ROW)).toEqual({});
+    });
+
+    it("越界 / 非法行高 ⇒ 一律返回空（宁可不动，也不要算出错位）", () => {
+        expect(computeReorderShifts(["a", "b"], 0, 5, ROW)).toEqual({});
+        expect(computeReorderShifts(["a", "b"], -1, 1, ROW)).toEqual({});
+        expect(computeReorderShifts(["a", "b"], 0, 1, 0)).toEqual({});
+        expect(computeReorderShifts(["a", "b"], 0, 1, -ROW)).toEqual({});
+    });
+
+    it("嵌套层级场景：只传**同父兄弟** ⇒ 位移也只落在这一层", () => {
+        // 同一层是 ["a","a1","a2"]，被拖的是 a1 ⇒ 越过 a2
+        const s = computeReorderShifts(["a", "a1", "a2"], 1, 2, ROW);
+        expect(Object.keys(s)).toEqual(["a2"]);
+        expect(s.a2).toBe(-ROW);
+    });
+
+    it("让位时长与 FLIP 同源（180ms，避免「拖动中让位」和「抬手后落位」两种速度打架）", () => {
+        expect(REORDER_SHIFT_MS).toBe(180);
+    });
+});
