--- /dev/null
+++ b/frontend/src/components/mobile/ClipQuickActions.tsx
@@ -0,0 +1,395 @@
+/**
+ * 音频块「常用操作」浮动条 —— 规格 `docs/15` 音频块·单击：
+ * 「选中并显示常用操作与左右控制点（参考 flm1.png）」。
+ *
+ * 用户口径（prompt.md L52）：「单击音频块显示常用操作：模仿 flm 但**标图标而不是文字**，
+ * 复制 剪切 粘贴 删除 分割 编辑 更多」。
+ *
+ * 【形制】flm1.png 里是**块正上方**的一条圆形按钮浮条 ⇒ 这里同样：
+ *   位置 = 选中块的水平中点、块的**上沿再往上 8px**；仅在**手机**（<600px）出现。
+ *
+ * 【动作全部复用既有入口，不新开分支】
+ *   复制/剪切/粘贴/删除/分割 ⇒ `hifi:timelineEditOp`（时间轴编辑操作的**唯一入口**，
+ *     见 `useTimelineEventHandlers` 的注释：事件名即契约，消费者自己读 store 里的实时选区）；
+ *   「编辑」⇒ 与双击块同一出口（打开参数编辑器并显示该块范围）；
+ *   「更多」⇒ 展开二级面板，把时间轴通道里其余操作（规范化/编组/切换 take/粘贴到新轨道…）列出来。
+ *
+ * 【定位为什么用 `__hsViewport()`】块是 **canvas 内核绘制、没有 DOM**（规格表也印证：
+ * 双击块只能走内核回调）⇒ 只能由「秒 → 像素」换算：`x = 容器左 + startSec·pxPerSec − scrollLeft`，
+ * 纵向 = `容器上 + 行号·rowHeight − scrollTop`。视口真值取内核钩子（与渲染同源）。
+ */
+import React from "react";
+import { shallowEqual } from "react-redux";
+import { useAppDispatch, useAppSelector } from "../../app/hooks";
+import { showMobilePanel } from "../../features/session/sessionSlice";
+
+type ViewportTruth = {
+    scrollLeft: number;
+    scrollTop: number;
+    pxPerSec: number;
+    rowHeight: number;
+    containerRect?: { left: number; top: number; width: number; height: number };
+};
+
+/** 时间轴编辑通道（时间轴专属，见 `focusRouting` 的「事件名即契约」）。 */
+function timelineEditOp(op: string): void {
+    window.dispatchEvent(new CustomEvent("hifi:timelineEditOp", { detail: { op } }));
+}
+
+/**
+ * 「刚抓过控制点」的判定窗口（毫秒）：这段时间内落在时间线内核上的 `pointerdown`
+ * 不再被当成"用户回到时间线"从而把浮条放回来。一次 pointerdown 的 window/document
+ * 两个捕获监听相隔不到 1ms，给 400ms 只为兼容慢速事件派发，绝不会误伤下一次真实点击。
+ */
+const HIDE_SETTLE_MS = 400;
+
+/* ── 图标（统一 16×16 viewBox + currentColor，与项目其它图标同规格）────────── */
+const S = { width: 18, height: 18, viewBox: "0 0 16 16", fill: "none", "aria-hidden": true } as const;
+const stroke = { stroke: "currentColor", strokeWidth: 1.3, strokeLinecap: "round", strokeLinejoin: "round" } as const;
+
+const IconCopy = () => (
+    <svg {...S}>
+        <rect x="5.5" y="5.5" width="8" height="8" rx="1.2" {...stroke} />
+        <path d="M10.5 5.5V3.7A1.2 1.2 0 0 0 9.3 2.5H3.7A1.2 1.2 0 0 0 2.5 3.7v5.6A1.2 1.2 0 0 0 3.7 10.5h1.8" {...stroke} />
+    </svg>
+);
+const IconCut = () => (
+    <svg {...S}>
+        <path d="M4 2.5 11.5 11M12 2.5 4.5 11" {...stroke} />
+        <circle cx="3.6" cy="12.4" r="1.9" {...stroke} />
+        <circle cx="12.4" cy="12.4" r="1.9" {...stroke} />
+    </svg>
+);
+const IconPaste = () => (
+    <svg {...S}>
+        <rect x="3.5" y="3.5" width="9" height="10.5" rx="1.2" {...stroke} />
+        <path d="M6 3.5V2.6A1.1 1.1 0 0 1 7.1 1.5h1.8A1.1 1.1 0 0 1 10 2.6v.9" {...stroke} />
+        <path d="M6 7.5h4M6 10h3" {...stroke} />
+    </svg>
+);
+const IconTrash = () => (
+    <svg {...S}>
+        <path d="M2.8 4.4h10.4M6.4 4.4V3a.9.9 0 0 1 .9-.9h1.4a.9.9 0 0 1 .9.9v1.4" {...stroke} />
+        <path d="M4.2 4.4l.7 8.1a1.1 1.1 0 0 0 1.1 1h4a1.1 1.1 0 0 0 1.1-1l.7-8.1" {...stroke} />
+        <path d="M6.7 7v4M9.3 7v4" {...stroke} />
+    </svg>
+);
+/** 分割：一条竖虚线 + 两侧剪开箭头（与「剪切」区分：这是刀口落在块中间）。 */
+const IconSplit = () => (
+    <svg {...S}>
+        <path d="M8 1.6v12.8" stroke="currentColor" strokeWidth="1.3" strokeLinecap="round" strokeDasharray="2 2" />
+        <path d="M4.6 5.2 6.6 7.2 4.6 9.2M11.4 5.2 9.4 7.2l2 2" {...stroke} />
+    </svg>
+);
+/** 编辑：铅笔（与「绘制」工具区分：这里是"进入详细编辑"）。 */
+const IconEdit = () => (
+    <svg {...S}>
+        <path d="M11.2 2.6l2.2 2.2-7.6 7.6-3 .8.8-3 7.6-7.6Z" {...stroke} />
+        <path d="M9.9 3.9l2.2 2.2" {...stroke} />
+    </svg>
+);
+const IconMore = () => (
+    <svg {...S}>
+        <circle cx="3.4" cy="8" r="1.25" fill="currentColor" />
+        <circle cx="8" cy="8" r="1.25" fill="currentColor" />
+        <circle cx="12.6" cy="8" r="1.25" fill="currentColor" />
+    </svg>
+);
+
+type Action = { key: string; label: string; icon: React.ReactNode; run: () => void; danger?: boolean };
+
+export function ClipQuickActions() {
+    const dispatch = useAppDispatch();
+    const s = useAppSelector(
+        (st) => ({
+            selectedClipId: st.session.selectedClipId,
+            multiSelectedClipIds: st.session.multiSelectedClipIds,
+            clips: st.session.clips,
+            tracks: st.session.tracks,
+        }),
+        shallowEqual,
+    );
+    const [vp, setVp] = React.useState<ViewportTruth | null>(null);
+    const [moreOpen, setMoreOpen] = React.useState(false);
+    const [narrow, setNarrow] = React.useState(
+        () => typeof window !== "undefined" && window.innerWidth < 600,
+    );
+    /**
+     * 被"点别处"收起的块（TASKS.md B2：浮窗出现后点参数界面 / 播放等要隐藏）。
+     *
+     * 按**块 id** 记而不是布尔：收起的是"这一块的浮窗"，换选另一块当然要重新出现。
+     * 判据用"指针按下"（pointerdown，捕获阶段）而不是 click——浮窗必须在**别的控件
+     * 响应之前**消失，否则点「播放」时浮窗还挂在画面上压着刚启动的播放态。
+     */
+    const [hiddenForClipId, setHiddenForClipId] = React.useState<string | null>(null);
+    const selectedClipIdRef = React.useRef<string | null>(null);
+    selectedClipIdRef.current = s.selectedClipId ?? null;
+
+    React.useEffect(() => {
+        /**
+         * 「别处」= 既不在浮条自己身上、也不在时间线容器内。
+         *
+         * - 浮条自己（`[data-hs-clip-actions]`）：点按钮不能把浮条收掉；
+         * - 时间线容器（`[data-hs-timeline-kernel="1"]`）：留给**选中逻辑**裁决——
+         *   点同一块（选中不变）应保持浮窗、点别的块应换浮窗、点空白会取消选中
+         *   自然收起。这里若也一律收起，就会出现"再点一下块，浮窗反而没了"。
+         */
+        const onDown = (e: PointerEvent) => {
+            const t = e.target as HTMLElement | null;
+            if (!t || typeof t.closest !== "function") return;
+            /* ⚠️ 点在**浮条自己身上**一律不收。
+             *
+             * 🔴 2026-09-30 实测（`scripts/_dbg-clipmore.mjs`）：这里曾经对"命中浮条里的按钮"
+             * 也 `setHiddenForClipId(id)`（当时的意图是 E6「点选项后也要隐藏菜单」），
+             * 但这是在 `pointerdown` 的**捕获阶段**执行的 —— 比按钮自己的 `click` 早，
+             * 于是浮条在 `click` 派发**之前**就被卸载 ⇒ `click` 的 target 没了
+             * ⇒ **浮条上所有按钮（复制/剪切/删除/分割/编辑/更多）全都点不动**。
+             * 实测事件序列：`BAR-REMOVED → pointerdown → touchstart → touchend`（**没有 click**）。
+             *
+             * 修法：E6 的"点选项后收起"改到 **click 里**做（见下面 `btn` 的 onClick），
+             * 这里只负责"点浮条以外的地方才收"。 */
+            if (t.closest("[data-hs-clip-actions]")) return;
+            if (t.closest('[data-hs-timeline-kernel="1"]')) {
+                /* 回到时间线 = 用户又去操作块了 ⇒ 清掉"已收起"，让选中逻辑重新决定。
+                   ⚠️ 但"刚抓过控制点"这一下不算 —— 那次 pointerdown 的 target 也只能是内核
+                   （圆点 pointer-events:none），若在这里放回来就等于控制点永远收不起浮条。
+                   两道闸：① 整段控制点手势期间（`grabActive`，长按拖动可达数秒）；
+                          ② 同一次按下的时间窗（兜住"手势结束事件没到"的边缘情况）。 */
+                if (grabActive || performance.now() - lastHideAt < HIDE_SETTLE_MS) return;
+                setHiddenForClipId(null);
+                return;
+            }
+            const id = selectedClipIdRef.current;
+            if (id !== null) setHiddenForClipId(id);
+        };
+        document.addEventListener("pointerdown", onDown, true);
+
+        /* E5（用户口径）：「按下控制点后**隐藏临时的常用功能菜单**」。
+           控制点浮层自己是 pointer-events:none（不能吃掉内核命中区），所以它通过窗口事件通知这里。
+           🔴 2026-10-03 为什么还要 `lastHideAt`：两个监听都在**捕获阶段** ——
+           `ClipControlPoints` 挂在 `window`、本文件的 `onDown` 挂在 `document`，
+           而捕获是从外往内走（window → document）⇒ 顺序是"先 hide、后 onDown"。
+           偏偏圆点是 `pointer-events:none` ⇒ 这次 pointerdown 的 `target` 只能是**时间线内核**，
+           于是下面那个分支会走"回到时间线 ⇒ 重新显示浮条"，把刚放下的隐藏状态**当场撤销**
+           —— 用户报的「触摸到控制点后常用功能临时菜单就应该隐藏了」就是这么失效的。
+           记一个时间戳，让"同一次按下"里的那条分支不生效。 */
+        let lastHideAt = 0;
+        /**
+         * 「控制点手势进行中」（2026-10-03 第二次修正）。
+         *
+         * 用户**第二次**报同一条 ⇒ 时间窗不够：控制点的两段式手势（长按 700ms + 上/下划）
+         * 是**秒级**的，而 `HIDE_SETTLE_MS` 只有 400ms —— 手势中途只要再来一次落在内核上的
+         * `pointerdown`（多指 / 笔 / 系统补发），浮条就会被放回来。
+         * ⇒ 改成**手势作用域**的闸门：按下控制点置位，松手（`hs-control-point-grab-end`）复位，
+         * 这期间**任何**路径都不许把浮条放回来。
+         */
+        let grabActive = false;
+        const onHide = () => {
+            grabActive = true;
+            const id = selectedClipIdRef.current;
+            if (id !== null) {
+                setHiddenForClipId(id);
+                lastHideAt = performance.now();
+            }
+        };
+        const onGrabEnd = () => {
+            grabActive = false;
+        };
+        window.addEventListener("hs-hide-clip-actions", onHide);
+        window.addEventListener("hs-control-point-grab-end", onGrabEnd);
+        return () => {
+            document.removeEventListener("pointerdown", onDown, true);
+            window.removeEventListener("hs-hide-clip-actions", onHide);
+            window.removeEventListener("hs-control-point-grab-end", onGrabEnd);
+        };
+    }, []);
+
+    // 视口真值 + 断点：都能变（缩放/滚动/旋转），所以在 rAF 里跟一下。
+    React.useEffect(() => {
+        let raf = 0;
+        const tick = () => {
+            const w = window as unknown as { __hsViewport?: () => ViewportTruth };
+            const next = w.__hsViewport ? w.__hsViewport() : null;
+            setVp((prev) => (prev && next && prev.scrollLeft === next.scrollLeft && prev.pxPerSec === next.pxPerSec && prev.rowHeight === next.rowHeight && prev.scrollTop === next.scrollTop ? prev : next));
+            setNarrow(window.innerWidth < 600);
+            raf = requestAnimationFrame(tick);
+        };
+        raf = requestAnimationFrame(tick);
+        return () => cancelAnimationFrame(raf);
+    }, []);
+
+    // 选区一变（或点了空白）就收起二级面板
+    React.useEffect(() => {
+        setMoreOpen(false);
+    }, [s.selectedClipId]);
+
+    const clip = s.selectedClipId ? s.clips.find((c) => c.id === s.selectedClipId) : null;
+    if (!narrow || !clip || !vp || !vp.containerRect || s.multiSelectedClipIds.length > 1) {
+        return null;
+    }
+    // B2：这一块已被"点别处"收起 ⇒ 不渲染。
+    if (hiddenForClipId !== null && hiddenForClipId === clip.id) return null;
+    const rowIndex = s.tracks.findIndex((t) => t.id === clip.trackId);
+    if (rowIndex < 0) return null;
+
+    const c = vp.containerRect;
+    const left = c.left + (clip.startSec ?? 0) * vp.pxPerSec - vp.scrollLeft;
+    const width = Math.max(24, (clip.durationSec ?? 0) * vp.pxPerSec);
+    const top = c.top + rowIndex * vp.rowHeight - vp.scrollTop;
+    // 块完全不可见时不显示浮条（免得浮条孤零零挂在屏幕边上）
+    if (left + width < c.left + 8 || left > c.left + c.width - 8) return null;
+
+    /* ── 按钮尺寸：必须让整条**落在时间线容器内** ──────────────────────────
+       【为什么不能固定 38】轨道头占掉 132px，时间线只有 228px 宽；7 个 38px 按钮
+       加间距是 302px ⇒ 浮条横向溢出容器两侧，左边压在轨道头列上（轨道头的长按
+       排序等手势会被它吞掉）、右边出屏。改成按容器宽反算：放得下就用 38（手指
+       友好），放不下就按可用宽度均分（下限 26）。
+       —— 与「③ 淡入淡出区划动」同源的教训：**浮层不许和它浮在之上的东西抢命中**。 */
+    const gap = 6;
+
+    const actions: Action[] = [
+        { key: "copy", label: "复制", icon: <IconCopy />, run: () => timelineEditOp("copy") },
+        { key: "cut", label: "剪切", icon: <IconCut />, run: () => timelineEditOp("cut") },
+        { key: "paste", label: "粘贴", icon: <IconPaste />, run: () => timelineEditOp("paste") },
+        { key: "delete", label: "删除", icon: <IconTrash />, danger: true, run: () => timelineEditOp("delete") },
+        { key: "split", label: "分割", icon: <IconSplit />, run: () => timelineEditOp("split") },
+        {
+            key: "edit",
+            label: "编辑",
+            icon: <IconEdit />,
+            // 与「双击音频块」同一出口：打开参数编辑器（块范围随双击那条路径送入）。
+            run: () => dispatch(showMobilePanel("params")),
+        },
+        {
+                key: "more",
+                label: "更多",
+                icon: <IconMore />,
+                /* F1：展开**右键那套菜单**（由 TimelinePanel 里的 ClipContextMenu 实例呈现），
+                   不再另开一个小菜单。坐标用浮条自己的位置 —— 菜单会贴着浮条弹出，
+                   与"从浮条点开"的直觉一致。 */
+                run: () =>
+                    window.dispatchEvent(
+                        new CustomEvent("hs-open-clip-context-menu", {
+                            detail: { x: centerX, y: barTop, clipId: clip.id },
+                        }),
+                    ),
+            },
+    ];
+
+    const natural = actions.length * 38 + (actions.length - 1) * gap;
+    const btnSize =
+        natural <= c.width
+            ? 38
+            : Math.max(26, Math.floor((c.width - (actions.length - 1) * gap) / actions.length));
+    const barWidth = actions.length * btnSize + (actions.length - 1) * gap;
+    const centerX = Math.min(
+        Math.max(left + width / 2, c.left + barWidth / 2),
+        c.left + c.width - barWidth / 2,
+    );
+    /* 块正上方（flm1 形制），放不下就**贴容器上沿兜底**。
+       ⚠️ 用户明确否决过「兜底停到容器底部」的版本（TASKS.md B3：界面**顶部**的块的
+       常用操作**不应该显示在界面底部**）——浮条必须待在所选块附近，否则"选中它、
+       到别处去找操作"完全失去就近操作的意义。代价是首行的块会被压住顶部一小条
+       （淡变区上沿），这一条随 B1"单击显示左右控制点"一起解决，不再靠挪浮条回避。 */
+    const aboveTop = top - (btnSize + 10);
+    const barTop = Math.max(c.top + 4, aboveTop);
+
+
+    const moreActions: Action[] = [
+        { key: "normalize", label: "规范化", icon: <IconMore />, run: () => timelineEditOp("normalize") },
+        { key: "group", label: "编组", icon: <IconMore />, run: () => timelineEditOp("group") },
+        { key: "ungroup", label: "取消编组", icon: <IconMore />, run: () => timelineEditOp("ungroup") },
+        { key: "takeNext", label: "下一 Take", icon: <IconMore />, run: () => timelineEditOp("cycleTake") },
+        { key: "takePrev", label: "上一 Take", icon: <IconMore />, run: () => timelineEditOp("cycleTakePrev") },
+        { key: "pasteTracks", label: "粘贴为新轨道", icon: <IconMore />, run: () => timelineEditOp("pasteTracks") },
+        { key: "deselect", label: "取消选择", icon: <IconMore />, run: () => timelineEditOp("deselect") },
+    ];
+
+    const btn = (a: Action) => (
+        <button
+            key={a.key}
+            type="button"
+            aria-label={a.label}
+            title={a.label}
+            onPointerDown={(e) => e.stopPropagation()}
+            onClick={(e) => {
+                e.stopPropagation();
+                a.run();
+                if (a.key !== "more") {
+                    setMoreOpen(false);
+                    /* E6（用户口径「点击临时菜单中的选项后也要隐藏菜单」）：
+                       **在 click 里收**，而不是在 pointerdown 的捕获阶段收 ——
+                       后者会把这次 click 自己毁掉（见 `onDown` 里的长注释）。
+                       「更多」例外：它只是去开右键那套菜单，浮条要留着。 */
+                    setHiddenForClipId(clip.id);
+                }
+            }}
+            style={{
+                width: btnSize,
+                height: btnSize,
+                display: "inline-flex",
+                alignItems: "center",
+                justifyContent: "center",
+                borderRadius: 999,
+                border: "1px solid var(--qt-border, rgba(255,255,255,0.18))",
+                background: "var(--qt-window, #1b1b1f)",
+                color: a.danger ? "#f87171" : "var(--qt-text, #e5e7eb)",
+                boxShadow: "0 4px 12px rgba(0,0,0,0.45)",
+                cursor: "pointer",
+                WebkitTapHighlightColor: "transparent",
+            }}
+        >
+            {a.icon}
+        </button>
+    );
+
+    return (
+        <div
+            data-hs-clip-actions
+            onPointerDown={(e) => e.stopPropagation()}
+            /* 🔴 2026-10-03（用户口径）：「常用功能临时菜单、控制点、淡出与变速这两个临时窗口
+               **应可以显示在更高层级（如轨道头、拍数栏）**」。
+               原来这里是**裸数字 26**，与拍数栏（`TimeRuler` z=25）/ 轨道头同档
+               ⇒ 谁在 DOM 后面谁赢，浮条会被轨道头、拍数栏压住。
+               ⇒ 改用设计令牌 `--hs-z-transient`（60）：高过拍数栏/轨道头/menubar(41)，
+                 仍低于常驻面板(500) / 菜单(999) / 弹窗(1000)，不会盖住该盖的东西。 */
+            style={{ position: "absolute", left: 0, top: 0, zIndex: "var(--hs-z-transient)", pointerEvents: "none" }}
+        >
+            <div
+                style={{
+                    position: "fixed",
+                    left: centerX,
+                    top: barTop,
+                    transform: "translateX(-50%)",
+                    display: "flex",
+                    gap,
+                    pointerEvents: "auto",
+                }}
+            >
+                {actions.map(btn)}
+            </div>
+            {moreOpen ? (
+                <div
+                    style={{
+                        position: "fixed",
+                        left: centerX,
+                        top: barTop + btnSize + 8,
+                        transform: "translateX(-50%)",
+                        display: "flex",
+                        flexWrap: "wrap",
+                        gap: 6,
+                        maxWidth: Math.min(300, c.width),
+                        padding: 8,
+                        borderRadius: 12,
+                        border: "1px solid var(--qt-border, rgba(255,255,255,0.18))",
+                        background: "var(--qt-window, #1b1b1f)",
+                        boxShadow: "0 10px 28px rgba(0,0,0,0.5)",
+                        pointerEvents: "auto",
+                    }}
+                >
+                    {moreActions.map(btn)}
+                </div>
+            ) : null}
+        </div>
+    );
+}
