-type TakeOptimisticFlat = Pick<
-    ClipInfo,
-    | "gain"
-    | "sourcePath"
-    | "sourcePathRelative"
-    | "durationSec"
-    | "durationFrames"
-    | "sourceSampleRate"
-    | "sourceStartSec"
-    | "sourceEndSec"
-    | "playbackRate"
-    | "clipPlaybackRate"
-    | "reversed"
-    | "loopEnabled"
-    | "midiNoteData"
-    | "midiNoteCount"
-    | "midiFillGaps"
->;
