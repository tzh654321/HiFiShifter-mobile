+    React.useEffect(() => {
+        const on = () => {
+            const next = readParamUiState();
+            setUi(next);
+            if (typeof next.overlaysVisible === "boolean") setOverlaysVisible(next.overlaysVisible);
+        };
+        window.addEventListener("hs-param-ui-state", on);
+        on(); // 面板可能比镜像事件晚挂载，先主动读一次
