+/// 运行时激活一个**导入进来**的可选模型（`docs/11` 的本地导入通道用）。
+///
+/// `setup()` 只在启动时按"文件是否存在"设置一次这些 `OnceLock`。用户中途导入模型时
+/// 调用本函数把它补上，就能**免重启生效**。
+///
+/// 返回 `true` 表示这次真的设上了；`false` 表示早就设过（启动时就有）或 id 不认识。
+pub fn activate_optional_model(id: &str, path: PathBuf) -> bool {
+    match id {
+        "hnsep" => HNSEP_MODEL_DIR.set(path).is_ok(),
+        "fcpe" => FCPE_ONNX_PATH.set(path).is_ok(),
+        _ => false,
+    }
+}
