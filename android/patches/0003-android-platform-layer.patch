+++ b/backend/src-tauri/src/platform/logging.rs
@@ -0,0 +1,174 @@
+//! Android 的日志后端。
+//!
+//! # 为什么必须补这一个文件
+//!
+//! 上游的 `logging::init_logging()` **只在 `main.rs` 里被调用**：
+//!
+//! ```text
+//! src/main.rs:32:  backend_lib::logging::init_logging(...)
+//! ```
+//!
+//! 但 **Android 的入口是 `lib.rs`（经 `mobile_entry_point`）**，`main.rs` 根本不参与。
+//! 后果：移动端**没有任何 logger 被安装**，于是 `log::info!` / `warn!` / `error!`
+//! 全部**被静默丢弃**（`log` 门面在没有 logger 时就是空操作）。
+//!
+//! 实测症状：我们自己加的 `log::info!("[resources] 模型就绪…")` 在 logcat 里搜不到，
+//! 上游关于模型会话预热的日志也一条都看不到 —— 排查 M2/M3 的问题时会完全失明。
+//!
+//! 另外 `logging::default_log_dir()` 也**没有 Android 分支**
+//! （只有 windows / macos / unix 三个），所以即便调用它也解析不出路径。
+//!
+//! # 两条通道（沿用探针验证过的优先级）
+//!
+//! 1. **logcat**（tag `HiFiShifter`）：开发期最方便，`adb logcat -s HiFiShifter:V`。
+//! 2. **落盘**：`<app_log_dir>/android.log`，用
+//!    `adb exec-out run-as <pkg> cat <path>` 取全文。
+//!
+//! 为什么两条都要：logcat 是**环形 buffer 且有损**（本机实测有后台应用每 200 ms 刷屏，
+//! 很快把我们的行冲掉）；落盘则不受影响，可 grep / 可 diff / 可归档。
+//! 见 `docs/06` §4.x。
+
+use std::ffi::CString;
+use std::io::Write;
+use std::path::PathBuf;
+use std::sync::Mutex;
+
+use tauri::{AppHandle, Manager};
+
+/// logcat 的 tag。用固定值便于 `-s HiFiShifter:V` 过滤。
+const TAG: &str = "HiFiShifter";
+
+/// 日志文件上限。超过就在进程启动时截断（不做多份轮转 —— 移动端存储紧张，
+/// 而且我们真正需要的是"最近一次运行"的日志）。
+const MAX_LOG_BYTES: u64 = 4 * 1024 * 1024;
+
+#[link(name = "log")]
+extern "C" {
+    /// 注意签名：`(prio, tag, text)`，**不是** `(prio, tag, fmt, ...)`。
+    /// 直接传格式化好的字符串，免得踩可变参数的坑。
+    fn __android_log_write(prio: std::ffi::c_int, tag: *const std::ffi::c_char, text: *const std::ffi::c_char) -> std::ffi::c_int;
+}
+
+fn android_prio(level: log::Level) -> std::ffi::c_int {
+    // android/log.h: VERBOSE=2, DEBUG=3, INFO=4, WARN=5, ERROR=6
+    match level {
+        log::Level::Error => 6,
+        log::Level::Warn => 5,
+        log::Level::Info => 4,
+        log::Level::Debug => 3,
+        log::Level::Trace => 2,
+    }
+}
+
+struct AndroidLogger {
+    file: Mutex<Option<std::fs::File>>,
+}
+
+impl log::Log for AndroidLogger {
+    fn enabled(&self, _metadata: &log::Metadata) -> bool {
+        true
+    }
+
+    fn log(&self, record: &log::Record) {
+        // 少一次无谓的格式化：低于 max_level 的在这里已被过滤，但第三方库
+        // 仍可能绕过 —— 这里再尊重一次上游对啰嗦库的压制策略。
+        if !self.enabled(record.metadata()) {
+            return;
+        }
+        let msg = format!(
+            "[{}] {}: {}",
+            record.level(),
+            record.target(),
+            record.args()
+        );
+
+        // ① logcat
+        if let (Ok(tag), Ok(text)) = (CString::new(TAG), CString::new(msg.as_str())) {
+            unsafe {
+                __android_log_write(android_prio(record.level()), tag.as_ptr(), text.as_ptr());
+            }
+        }
+
+        // ② 落盘（失败就算了，不能因为日志把主流程搞崩）
+        if let Ok(mut guard) = self.file.lock() {
+            if let Some(f) = guard.as_mut() {
+                let _ = writeln!(f, "{msg}");
+                let _ = f.flush();
+            }
+        }
+    }
+
+    fn flush(&self) {
+        if let Ok(mut guard) = self.file.lock() {
+            if let Some(f) = guard.as_mut() {
+                let _ = f.flush();
+            }
+        }
+    }
+}
+
+fn open_log_file(app: &AppHandle) -> Option<(PathBuf, std::fs::File)> {
+    // `app_log_dir()` 在 Android 上是 <data>/logs（Tauri 会按包名建目录）。
+    // 取不到就退到 app_data_dir/logs —— 我们自己创建。
+    let dir = app
+        .path()
+        .app_log_dir()
+        .or_else(|_| app.path().app_data_dir().map(|d| d.join("logs")))
+        .ok()?;
+    std::fs::create_dir_all(&dir).ok()?;
+    let path = dir.join("android.log");
+
+    // 上次运行的日志只保留到上限，超过就直接清空重来（移动端不做多份轮转）
+    if let Ok(meta) = std::fs::metadata(&path) {
+        if meta.len() > MAX_LOG_BYTES {
+            let _ = std::fs::File::create(&path);
+        }
+    }
+
+    let file = std::fs::OpenOptions::new()
+        .create(true)
+        .append(true)
+        .open(&path)
+        .ok()?;
+    Some((path, file))
+}
+
+/// 安装 Android 日志后端。**幂等**：重复调用只返回上次的记录路径。
+///
+/// 必须在 `setup()` 里**尽早**调用 —— 越早越好，否则它之前的 `log::` 调用会被丢弃
+/// （包括 `ensure_ndk_context()` 的输出）。
+///
+/// 返回日志文件路径（便于在启动日志里打出来，方便 `run-as cat`）。
+pub fn init(app: &AppHandle) -> Option<PathBuf> {
+    static LOG_PATH: std::sync::OnceLock<Option<PathBuf>> = std::sync::OnceLock::new();
+
+    LOG_PATH
+        .get_or_init(|| {
+            let (path, file) = match open_log_file(app) {
+                Some((p, f)) => (Some(p), Some(f)),
+                None => (None, None),
+            };
+
+            let logger = AndroidLogger {
+                file: Mutex::new(file),
+            };
+
+            // `set_boxed_logger` 已被安装过时返回 Err —— 忽略即可（本函数幂等）
+            if log::set_boxed_logger(Box::new(logger)).is_ok() {
+                // 级别：Android 上没有 HIFISHIFTER_LOG 环境变量，默认 Info。
+                // 定位疑难问题时可临时改成 Trace。
+                log::set_max_level(log::LevelFilter::Info);
+            }
+
+            match &path {
+                Some(p) => log::info!(
+                    "[platform::logging] Android 日志后端就绪，落盘于 {}",
+                    p.display()
+                ),
+                None => log::warn!("[platform::logging] 无法打开日志文件，仅走 logcat"),
+            }
+
+            path
+        })
+        .clone()
+}
