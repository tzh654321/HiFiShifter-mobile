+                                // 内居中，尺寸钳制到该显示器。绝不让窗口落在
+                                // 屏幕外导致"启动即不可见"。
+                                let fallback = win
+                                    .primary_monitor()
+                                    .ok()
+                                    .flatten()
+                                    .or_else(|| monitors.first().cloned());
+                                if let Some(m) = fallback {
