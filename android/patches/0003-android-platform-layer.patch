+//! 桌面专属窗口方法在移动端的兼容层。
+//!
+//! ## 问题
+//!
+//! Tauri 把 `set_title` / `set_size` / `set_position` / `set_fullscreen` /
+//! `maximize` / `close` 这批方法标记为 **desktop-only** —— 移动端
+//! （Android / iOS）的 `WebviewWindow` / `Window` 上根本没有它们，
+//! 因为移动端窗口是全屏且由 OS 管理的，这些操作在语义上不成立。
+//!
+//! 交叉编译到 `aarch64-linux-android` 时，上游 18 处调用会直接报：
+//!
+//! ```text
+//! src/lib.rs:370:37: error[E0599]: no method named `set_size` found for
+//!     struct `tauri::WebviewWindow<R>` in the current scope
+//! ```
+//!
+//! 分布：`lib.rs` 8 处（窗口尺寸/位置的记忆恢复 + 全屏/最大化状态恢复）、
+//! `commands/project.rs` 6 处、`commands/project_import.rs` / `reaper.rs` /
+//! `vocalshifter.rs` 各 1 处（标题）、`state.rs` 1 处（标题）。
+//!
+//! ## 处理方式
+//!
+//! **提供同名同签名的扩展 trait，移动端实现为 no-op**，这样：
+//!
+//! 1. 18 处调用点**一行都不用改**，业务逻辑不分叉；
+//! 2. 这些功能在移动端本来就该由 OS 提供（标题栏、关闭手势）
+//!    或者根本无意义（窗口尺寸/位置/最大化）；
+//! 3. 桌面端**固有方法优先**，本 trait 不会被选中，行为与上游完全一致。
+//!
+//! > 为什么用 no-op 而不是"返回 unsupported 错误"：这 18 处的返回值
+//! > 全都被忽略（`let _ = ...`），没有任何调用方会读它，
+//! > 返回 `Err` 只会污染日志。
+//!
+//! ## 移动端上的一个额外注意
+//!
+//! `lib.rs` 里那段窗口状态恢复逻辑还会调 `scale_factor()` /
+//! `primary_monitor()` / `available_monitors()`。这些在移动端**是存在的**
+//! （Tauri 移动端实现了查询类 API），所以不需要兼容层；
+//! 恢复出的尺寸/位置最终会落到本 trait 的 no-op 上，白算一遍但无害。
+//! 后续如果要省掉这次无用计算，应该在那段逻辑入口加 `#[cfg(desktop)]`。
+
+use tauri::{Position, Runtime, Size, WebviewWindow, Window};
+
+/// 桌面专属窗口方法的兼容层。方法签名与 Tauri 桌面端保持一致。
+pub trait DesktopWindowCompat<R: Runtime> {
+    /// 桌面：设置窗口标题。移动端：no-op（标题由 OS 管理）。
+    fn set_title(&self, title: &str) -> tauri::Result<()>;
+
+    /// 桌面：设置窗口尺寸。移动端：no-op（全屏，尺寸由 OS 决定）。
+    fn set_size<S: Into<Size>>(&self, size: S) -> tauri::Result<()>;
+
+    /// 桌面：设置窗口位置。移动端：no-op。
+    fn set_position<P: Into<Position>>(&self, position: P) -> tauri::Result<()>;
+
+    /// 桌面：切换全屏。移动端：no-op（本来就是全屏）。
+    fn set_fullscreen(&self, fullscreen: bool) -> tauri::Result<()>;
+
+    /// 桌面：最大化窗口。移动端：no-op（没有窗口化的概念）。
+    fn maximize(&self) -> tauri::Result<()>;
+
+    /// 桌面：关闭窗口。移动端：no-op。
+    ///
+    /// 移动端的"关闭"是 OS 的返回手势/任务切换，应用自己关窗口没有意义；
+    /// 对应的业务（关闭工程）应当由前端 UI 显式调用，而不是走系统窗口关闭。
+    fn close(&self) -> tauri::Result<()>;
+}
+
+/// 桌面端**不会**用到这些实现（固有方法优先），只是为了：
+/// ① 让 `use` 在任何 target 下都不是 unused（省掉一堆 `#[allow]`）；
+/// ② 万一某个目标上固有方法缺失，也能退化为 no-op 而不是编译失败。
+///
+/// ⚠️ 如果将来 Tauri 给移动端补上了这些方法，固有方法会优先，无需改动本文件。
+macro_rules! impl_desktop_window_compat_noop {
+    ($ty:ty) => {
+        impl<R: Runtime> DesktopWindowCompat<R> for $ty {
+            fn set_title(&self, _title: &str) -> tauri::Result<()> {
+                Ok(())
+            }
+            fn set_size<S: Into<Size>>(&self, _size: S) -> tauri::Result<()> {
+                Ok(())
+            }
+            fn set_position<P: Into<Position>>(&self, _position: P) -> tauri::Result<()> {
+                Ok(())
+            }
+            fn set_fullscreen(&self, _fullscreen: bool) -> tauri::Result<()> {
+                Ok(())
+            }
+            fn maximize(&self) -> tauri::Result<()> {
+                Ok(())
+            }
+            fn close(&self) -> tauri::Result<()> {
+                Ok(())
+            }
+        }
+    };
+}
+
+impl_desktop_window_compat_noop!(Window<R>);
+impl_desktop_window_compat_noop!(WebviewWindow<R>);
