+                                        probe_w, probe_h, &bounds,
+                                    );
+                                    let _ =
+                                        win.set_size(tauri::Size::Physical(tauri::PhysicalSize {
+                                            width: cw.round() as u32,
+                                            height: ch.round() as u32,
+                                        }));
+                                    let (px, py) =
+                                        crate::config::centered_position((cw, ch), &bounds);
