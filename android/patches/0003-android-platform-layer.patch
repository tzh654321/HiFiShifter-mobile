+    /// `pick_file` 的便捷封装。
+    pub fn pick_file(mime: &str, suggested_name: Option<&str>) -> Result<Option<PathBuf>, String> {
+        match request(KIND_OPEN, mime, suggested_name, DEFAULT_TIMEOUT)? {
+            Some(SafOutcome::Path(p)) => Ok(Some(p)),
+            // KIND_OPEN 不该回 SaveTarget；真出现了就当成没选（并留痕）。
+            Some(SafOutcome::SaveTarget { uri, .. }) => {
+                log::warn!("[saf] pick_file 收到了保存目标，按未选择处理：{uri}");
+                Ok(None)
+            }
+            None => Ok(None),
