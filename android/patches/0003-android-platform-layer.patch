-                        match anchor {
-                            Some((bounds, _)) => {
-                                // 位置有效；尺寸超出该显示器时钳制
-                                if let (Some(w), Some(h)) = (ws.width, ws.height) {
-                                    let (cw, ch) = crate::config::clamp_size_to_bounds(
-                                        w * scale,
-                                        h * scale,
-                                        &bounds,
-                                    );
-                                    if cw < w * scale - 0.5 || ch < h * scale - 0.5 {
-                                        let _ = win.set_size(tauri::Size::Physical(
