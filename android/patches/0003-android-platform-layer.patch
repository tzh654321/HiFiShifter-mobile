+#[cfg_attr(mobile, tauri::mobile_entry_point)]
+pub fn run() {
+    tauri::Builder::default()
+        .manage(state::AppState::default())
+        .plugin(tauri_plugin_opener::init())
+        .setup(|app| {
+            // ── Android: 安装日志后端（必须是 setup 里的第一件事）──
+            //
+            // 上游的 `logging::init_logging()` **只在 `main.rs` 里调用**，
+            // 而 Android 的入口是 lib.rs（经 mobile_entry_point）——
+            // 所以移动端原本**一个 logger 都没装**，所有 `log::*!` 被静默丢弃。
+            // 不装它的话，下面 `ensure_ndk_context()` 的成功/失败、模型加载、
+            // 音频设备枚举的可读诊断全都看不到。
+            #[cfg(target_os = "android")]
+            if let Some(p) = platform::logging::init(app.handle()) {
+                log::info!("[setup] 日志文件：{}（adb exec-out run-as … cat 可读）", p.display());
+            }
+
+            // ── Android: 初始化 ndk_context（必须早于任何音频设备枚举）──
+            //
+            // cpal 的 Oboe 后端在查设备能力时会走
+            // `ndk_context::android_context()`，而它在未初始化时**直接 panic**
+            // （不是返回 Err），并且整个 Tauri 栈（tauri / wry / tao /
+            // tauri-runtime-wry）都不初始化它。
+            //
+            // 所以必须在这里补上，否则 `host.devices()` 与
+            // `device.default_output_config()` 必崩 —— 而音频引擎一定要查它们。
+            // 详见 src/platform/ndk_context.rs 与 docs/10 §4。
+            #[cfg(target_os = "android")]
+            match platform::ensure_ndk_context() {
+                Ok(()) => log::info!("[setup] ndk_context 已就绪（cpal/Oboe 可用）"),
+                Err(e) => log::error!(
+                    "[setup] ndk_context 初始化失败: {e} —— \
+                     音频设备枚举会 panic，UI 需要给出明确提示而不是静默降级"
+                ),
+            }
+
+            // ── AppImage Mesa/EGL driver path ──────────────────────────
+            // When running inside an AppImage, Mesa's libEGL is bundled
+            // along with its DRI drivers under usr/lib/dri/.  Tell Mesa
+            // where to find them so WebKit2GTK can create its EGL display.
+            #[cfg(target_os = "linux")]
+            if let Ok(appdir) = std::env::var("APPDIR") {
+                let dri_dir = format!("{appdir}/usr/lib/dri");
+                if std::path::Path::new(&dri_dir).is_dir() {
+                    std::env::set_var("LIBGL_DRIVERS_PATH", &dri_dir);
+                    log::warn!("[setup] LIBGL_DRIVERS_PATH={dri_dir}");
+                }
+            }
+
+            // 打包后的应用：从资源目录查找内嵌的 ONNX 模型。
+            //
+            // ⚠️ 不能直接 `app.path().resource_dir()`：**Android 上它返回的是
+            // `asset://localhost/`**（Tauri 的 asset 协议 URL，不是文件路径），
+            // 交给 `std::fs` 必然失败。
+            // `platform::resolve_asset_root()` 会把 Android 的随包 `models/`
+            // 先同步到私有数据目录再返回真实路径（桌面端行为不变）。
+            // 实测数据见 `docs/10` 探针 0 / 探针 4。
+            if let Some(root) = crate::platform::resolve_asset_root(app.handle()) {
+                let nsf = root.join("models").join("nsf_hifigan");
+                let has_model = nsf.join("pc_nsf_hifigan.onnx").exists()
+                    || nsf.join("pc_nsf_hifigan_coreml.onnx").exists();
+                if has_model && nsf.join("config.json").exists() {
