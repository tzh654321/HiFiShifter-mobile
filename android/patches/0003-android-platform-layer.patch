+    /// 从 tree URI 反推它在真实文件系统里的路径前缀。
+    ///
+    /// `content://com.android.externalstorage.documents/tree/primary%3AHiFiShifter`
+    ///   ⇒ `Some("/storage/emulated/0/HiFiShifter")`
+    /// 不是 externalstorage 提供者、或卷名不认识时返回 `None`（调用方退回普通 fs）。
+    pub fn tree_real_prefix(tree_uri: &str) -> Option<String> {
+        let seg = tree_uri.split("/tree/").nth(1)?;
+        let seg = seg.split('?').next().unwrap_or(seg);
+        let decoded = percent_decode(seg);
+        let (volume, rel) = decoded.split_once(':')?;
+        let base = match volume {
+            "primary" => "/storage/emulated/0",
+            other => {
+                // 形如 "1B2C-3D4E" 的 SD 卡卷 ⇒ /storage/<vol>
+                if other.len() >= 4 && other.contains('-') {
+                    // 需要 &'static 语义：这里拼成 String 再借用
+                    let p = format!("/storage/{other}");
+                    return if rel.is_empty() { Some(p) } else { Some(format!("{p}/{rel}")) };
+                }
+                return None;
+            }
+        };
+        Some(if rel.is_empty() {
+            base.to_string()
+        } else {
+            format!("{base}/{rel}")
+        })
+    }
+
+    /// 列出 tree 下某相对路径的子项，返回 Kotlin 给的 JSON 数组字符串。
+    pub fn list_tree_children(tree_uri: &str, rel_path: &str) -> Result<String, String> {
+        let (a, b) = (tree_uri.to_string(), rel_path.to_string());
+        with_env(|env| {
+            let cls = app_class(env, KOTLIN_CLASS)?;
+            let ja = env
+                .new_string(&a)
+                .map_err(|e| format!("new_string(tree) 失败: {e}"))?;
+            let jb = env
+                .new_string(&b)
+                .map_err(|e| format!("new_string(rel) 失败: {e}"))?;
+            let ret = env
+                .call_static_method(
+                    &cls,
+                    "listTreeChildren",
+                    "(Ljava/lang/String;Ljava/lang/String;)Ljava/lang/String;",
+                    &[JValue::Object(&ja), JValue::Object(&jb)],
+                )
+                .map_err(|e| {
+                    let _ = env.exception_clear();
+                    format!("调用 listTreeChildren 失败: {e}")
+                })?;
+            let obj = ret.l().map_err(|e| format!("取返回值失败: {e}"))?;
+            if obj.is_null() {
+                return Ok("[]".to_string());
+            }
+            let s = env
+                .get_string(&JString::from(obj))
+                .map(|v| String::from(v))
+                .map_err(|e| {
+                    let _ = env.exception_clear();
+                    format!("读 JSON 失败: {e}")
+                })?;
+            Ok(s)
+        })
+    }
+
+    /// 极简 percent-decode（SAF 的 tree URI 里冒号被编成 `%3A`）。
+    fn percent_decode(s: &str) -> String {
+        let bytes = s.as_bytes();
+        let mut out = Vec::with_capacity(bytes.len());
+        let mut i = 0;
+        while i < bytes.len() {
+            if bytes[i] == b'%' && i + 2 < bytes.len() {
+                let hex = std::str::from_utf8(&bytes[i + 1..i + 3]).unwrap_or("");
+                if let Ok(v) = u8::from_str_radix(hex, 16) {
+                    out.push(v);
+                    i += 3;
+                    continue;
+                }
+            }
+            out.push(bytes[i]);
+            i += 1;
+        }
+        String::from_utf8_lossy(&out).into_owned()
+    }
+
+    /// 向 Kotlin 要导出中转目录（JNI → `HifishifterFs.stagingDir`）。
+    fn staging_dir() -> Result<PathBuf, String> {
+        with_env(|env| {
+            let cls = app_class(env, KOTLIN_CLASS)?;
+            let ret = env
+                .call_static_method(&cls, "stagingDir", "()Ljava/lang/String;", &[])
+                .map_err(|e| {
+                    let _ = env.exception_clear();
+                    format!("调用 stagingDir 失败: {e}")
+                })?;
+            let obj = ret
+                .l()
+                .map_err(|e| format!("取 stagingDir 返回值失败: {e}"))?;
+            let js = JString::from(obj);
+            let s = env
+                .get_string(&js)
+                .map(|v| String::from(v))
+                .map_err(|e| {
+                    let _ = env.exception_clear();
+                    format!("读取 stagingDir 字符串失败: {e}")
+                })?;
+            if s.trim().is_empty() {
+                return Err("stagingDir 返回空（Activity 尚未 attach？）".to_string());
+            }
+            Ok(PathBuf::from(s))
+        })
+    }
+
+    /// 把 `src` 的内容写进之前 `ACTION_CREATE_DOCUMENT` 返回的 URI（JNI → `HifishifterFs.writeToUri`）。
+    pub fn write_to_uri(uri: &str, src: &std::path::Path) -> Result<bool, String> {
+        let src_s = src.display().to_string();
+        with_env(|env| {
+            let cls = app_class(env, KOTLIN_CLASS)?;
+            let juri = env
+                .new_string(uri)
+                .map_err(|e| format!("构造 uri 字符串失败: {e}"))?
+                .into_raw();
+            let jsrc = env
+                .new_string(&src_s)
+                .map_err(|e| format!("构造 path 字符串失败: {e}"))?
+                .into_raw();
+            let ret = env
+                .call_static_method(
+                    &cls,
+                    "writeToUri",
+                    "(Ljava/lang/String;Ljava/lang/String;)Z",
+                    &[
+                        jni::objects::JValue::Object(unsafe { &jni::objects::JObject::from_raw(juri) }),
+                        jni::objects::JValue::Object(unsafe { &jni::objects::JObject::from_raw(jsrc) }),
+                    ],
+                )
+                .map_err(|e| {
+                    let _ = env.exception_clear();
+                    format!("调用 writeToUri 失败: {e}")
+                })?;
+            Ok(ret.z().map_err(|e| format!("读取 writeToUri 返回值失败: {e}"))?)
+        })
+    }
+
+    /// 文件名净化：去掉路径分隔符与 Windows 非法字符，避免 `join` 被穿越。
+    fn sanitize_file_name(name: &str) -> String {
+        let cleaned: String = name
+            .chars()
+            .map(|c| match c {
+                '/' | '\\' | ':' | '*' | '?' | '"' | '<' | '>' | '|' | '\0' => '_',
+                c if (c as u32) < 0x20 => '_',
+                c => c,
+            })
+            .collect();
+        let trimmed = cleaned.trim().trim_matches('.');
+        if trimmed.is_empty() {
+            "export.bin".to_string()
+        } else {
+            trimmed.to_string()
+        }
+    }
+
+    fn drop_pending(id: u64) {
+        PENDING.lock().unwrap().retain(|(k, _)| *k != id);
+    }
+
+    // ── Rust → Kotlin ───────────────────────────────────────────────────────
+
+    /// 附加到当前线程并借用 JNIEnv。
+    ///
+    /// 用 `attach_current_thread_permanently` 而不是 `attach_current_thread`：
+    /// 后者返回的 guard 析构时会 `DetachCurrentThread`，而这里跑在 tokio 的
+    /// worker 线程上（会被复用），一旦别的代码已经附加过、我们却把它 detach 了，
+    /// 后续 JNI 调用就会变成野指针。永久附加直到进程结束，代价可忽略。
+    fn with_env<F, R>(f: F) -> Result<R, String>
+    where
+        F: FnOnce(&mut JNIEnv) -> Result<R, String>,
+    {
+        if !crate::platform::ndk_context::is_ready() {
+            return Err("ndk_context 尚未初始化（setup 里没调 ensure_ndk_context？）".to_string());
+        }
+        let ctx = ndk_context::android_context();
+        // SAFETY: vm 来自 ndk_context（其值源自 JNI_OnLoad），进程生命周期内有效。
+        let vm = unsafe { jni::JavaVM::from_raw(ctx.vm().cast()) }
+            .map_err(|e| format!("JavaVM::from_raw 失败: {e}"))?;
+        let mut env = vm
+            .attach_current_thread_permanently()
+            .map_err(|e| format!("attach_current_thread 失败: {e}"))?;
+        f(&mut env)
+    }
+
+    /// 取应用自己的类。
+    ///
+    /// ⚠️ **不能用 `env.find_class()`**：从 native 附加进来的线程只有**系统类加载器**的
+    /// 视野，找不到 app 的类（会抛 `NoClassDefFoundError`）。正确做法是借
+    /// `Application.getClassLoader()` 再 `loadClass`。
+    fn app_class<'local>(env: &mut JNIEnv<'local>, name: &str) -> Result<JClass<'local>, String> {
+        let ctx = ndk_context::android_context();
+        // SAFETY: context 是 ndk_context 持有的全局引用，不会被我们删除。
+        let app = unsafe { JObject::from_raw(ctx.context().cast()) };
+        let loader = env
+            .call_method(&app, "getClassLoader", "()Ljava/lang/ClassLoader;", &[])
+            .map_err(|e| {
+                let _ = env.exception_clear();
+                format!("Application.getClassLoader() 失败: {e}")
+            })?
+            .l()
+            .map_err(|e| format!("取 ClassLoader 对象失败: {e}"))?;
+        let jname = env
+            .new_string(name)
+            .map_err(|e| format!("new_string 失败: {e}"))?;
+        let cls = env
+            .call_method(
+                &loader,
+                "loadClass",
+                "(Ljava/lang/String;)Ljava/lang/Class;",
+                &[JValue::Object(&jname)],
+            )
+            .map_err(|e| {
+                let _ = env.exception_clear();
+                format!("loadClass({name}) 失败: {e}")
+            })?
+            .l()
+            .map_err(|e| format!("取 Class 对象失败: {e}"))?;
+        Ok(JClass::from(cls))
+    }
+
+    fn call_kotlin_request(
+        id: u64,
+        kind: i32,
+        mime: &str,
+        suggested_name: Option<&str>,
+    ) -> Result<(), String> {
+        with_env(|env| {
+            let cls = app_class(env, KOTLIN_CLASS)?;
+            let jmime = env
+                .new_string(mime)
+                .map_err(|e| format!("new_string(mime) 失败: {e}"))?;
+            // 建议名一律以字符串传（空串 = 没有建议），避免在 JValue 里塞 null 对象。
+            let jsug = env
+                .new_string(suggested_name.unwrap_or(""))
+                .map_err(|e| format!("new_string(suggested) 失败: {e}"))?;
+            env.call_static_method(
+                &cls,
+                "request",
+                "(JILjava/lang/String;Ljava/lang/String;)V",
+                &[
+                    JValue::Long(id as i64),
+                    JValue::Int(kind),
+                    JValue::Object(&jmime),
+                    JValue::Object(&jsug),
+                ],
+            )
+            .map_err(|e| {
+                let _ = env.exception_describe();
+                let _ = env.exception_clear();
+                format!("HifishifterFs.request 调用失败: {e}")
+            })?;
+            Ok(())
+        })
+    }
+
+    // ── HS-OPEN-WITH-PATCH：关联文件（其他应用「打开方式」）──────────────────
+
+    /// 取一次「用本应用打开」的文件路径（Kotlin 侧 `acceptOpenIntent` 物化好的）。
+    ///
+    /// * `Ok(Some(path))` —— 有文件等着导入，`path` 是 cacheDir 里的真实路径；
+    /// * `Ok(None)` —— 没有（正常启动，或已经被取过了）。
+    ///
+    /// Kotlin 侧**取一次即清**（`takePendingOpenPath`），所以前端只在启动/恢复时各调一次。
+    pub fn take_pending_open_path() -> Result<Option<PathBuf>, String> {
+        with_env(|env| {
+            let cls = app_class(env, KOTLIN_CLASS)?;
+            let ret = env
+                .call_static_method(
+                    &cls,
+                    "takePendingOpenPath",
+                    // ⚠️ 返回对象签名（不是 ()V）；null 表示没有。
+                    "()Ljava/lang/String;",
+                    &[],
+                )
+                .map_err(|e| {
+                    let _ = env.exception_describe();
+                    let _ = env.exception_clear();
+                    format!("HifishifterFs.takePendingOpenPath 调用失败: {e}")
+                })?
+                .l()
+                .map_err(|e| format!("取返回值失败: {e}"))?;
+            if ret.is_null() {
+                return Ok(None);
+            }
+            // ⚠️ JString 只在 env 作用域内有效 ⇒ 在这里就转成 Rust String。
+            let jstr = JString::from(ret);
+            let s: String = env
+                .get_string(&jstr)
+                .map_err(|e| format!("get_string 失败: {e}"))?
+                .into();
+            if s.trim().is_empty() {
+                return Ok(None);
+            }
+            Ok(Some(PathBuf::from(s)))
+        })
+    }
+
+    // ── Kotlin → Rust ───────────────────────────────────────────────────────
+
+    /// 由 Kotlin 的 `HifishifterFs.nativeOnResult` 调用（`@JvmStatic external fun`）。
+    ///
+    /// ⚠️ 函数名与包名**逐字符对应**（`.` → `_`）。改包名要同步改这里
+    /// 与 `scripts/setup-gen-android.sh`。
+    ///
+    /// # Safety
+    /// 由 JNI 运行期调用，参数由运行期保证有效。返回值必须是 `()`。
+    #[no_mangle]
+    pub extern "system" fn Java_com_arounder_hifishifter_HifishifterFs_nativeOnResult(
+        mut env: JNIEnv,
+        _class: JClass,
+        request_id: jlong,
+        kind: jint,
+        local_path: JString,
+        display_name: JString,
+        error: JString,
+    ) {
+        let id = request_id as u64;
+        let err = jstring(&mut env, &error);
+        // ⚠️ 第三、四个参数的含义**随 kind 变**（与 Kotlin 侧的约定）：
+        //   · KIND_OPEN ⇒ path = 物化后的真实路径，name = 原文件名
+        //   · KIND_SAVE ⇒ path = 用户选定的目标 **URI**，name = 用户可能改过的文件名
+        // 所以必须按 kind 分派，不能一律当 PathBuf 用。
+        let payload = jstring(&mut env, &local_path);
+        let name = jstring(&mut env, &display_name);
+
+        let result: Result<SafOutcome, String> = match err {
+            Some(e) if !e.is_empty() => Err(e),
+            _ => match payload {
+                Some(p) if !p.is_empty() => {
+                    if kind == KIND_SAVE {
+                        Ok(SafOutcome::SaveTarget { uri: p, name })
+                    } else {
+                        Ok(SafOutcome::Path(PathBuf::from(p)))
+                    }
+                }
+                _ => Err(ERR_CANCELLED.to_string()),
+            },
+        };
+
+        let tx = {
+            let mut guard = match PENDING.lock() {
+                Ok(g) => g,
+                Err(poisoned) => poisoned.into_inner(),
+            };
+            let found = guard
+                .iter()
+                .position(|(k, _)| *k == id)
+                .map(|i| guard.remove(i).1);
+            drop(guard);
+            found
+        };
+
+        match tx {
+            Some(tx) => {
+                // 接收端可能已经超时走人（SendError）—— 那不是错误，记一条日志即可。
+                if let Err(e) = tx.send(result) {
+                    log::info!("[saf] 请求 #{id} 回传时已经没有等待者（多半已超时）: {e:?}");
+                }
+            }
+            // 没有等待者：超时后才回来的结果，或 requestCode 撞码。丢弃。
+            None => log::warn!("[saf] 收到未知 requestId #{id} 的回传，已忽略"),
+        }
+    }
+
+    fn jstring(env: &mut JNIEnv, s: &JString) -> Option<String> {
+        if s.as_raw().is_null() {
+            return None;
+        }
+        match env.get_string(s) {
+            Ok(js) => Some(String::from(js)),
+            Err(e) => {
+                let _ = env.exception_clear();
+                log::warn!("[saf] 读取 JNI 字符串失败: {e}");
+                None
+            }
+        }
+    }
+
+    /// 供诊断用：当前有几个请求在等。
+    #[allow(dead_code)]
+    pub fn pending_count() -> usize {
+        PENDING.lock().map(|g| g.len()).unwrap_or(0)
+    }
+}
