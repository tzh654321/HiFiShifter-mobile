+/// N2-S：发起 Shizuku 授权请求。
+#[tauri::command(rename_all = "camelCase")]
+pub fn request_shizuku_permission() -> serde_json::Value {
+    #[cfg(target_os = "android")]
+    {
+        let ok = crate::platform::saf::request_shizuku_permission();
+        return serde_json::json!({ "ok": ok });
+    }
+    #[cfg(not(target_os = "android"))]
+    {
+        serde_json::json!({ "ok": false })
+    }
+}
+
+/// N2-S：借 Shizuku 的 shell 身份执行 `appops set <pkg> MANAGE_EXTERNAL_STORAGE allow`。
+/// ⚠️ 现在是**异步**的：Shizuku 的 API 要求主线程，从 JNI 线程同步调用会整进程崩溃
+/// （真机实测：点一下按钮应用直接闪退、连 Java 栈都没有）。本命令只负责发起，
+/// 立刻返回 `{ ok: true, pending: true }`，结果用 `shizuku_grant_result` 轮询。
+#[tauri::command(rename_all = "camelCase")]
+pub fn grant_all_files_via_shizuku() -> serde_json::Value {
+    #[cfg(target_os = "android")]
+    {
+        let first = crate::platform::saf::grant_all_files_via_shizuku();
+        return serde_json::json!({ "ok": true, "pending": true, "first": first });
+    }
+    #[cfg(not(target_os = "android"))]
+    {
+        serde_json::json!({ "ok": false, "pending": false, "error": "desktop" })
+    }
+}
+
+/// N2-S：轮询「用 Shizuku 开全盘访问」的结果。
+/// `error` 空串 = 成功；`pending` = 还在跑；其它 = 错误码。
+#[tauri::command(rename_all = "camelCase")]
+pub fn shizuku_grant_result() -> serde_json::Value {
+    #[cfg(target_os = "android")]
+    {
+        let res = crate::platform::saf::shizuku_grant_result();
+        let all_files = crate::platform::saf::is_external_storage_manager();
+        return serde_json::json!({
+            "ok": res.is_empty(),
+            "pending": res == "pending",
+            "error": res,
+            "allFiles": all_files,
+        });
+    }
+    #[cfg(not(target_os = "android"))]
+    {
+        serde_json::json!({ "ok": false, "pending": false, "error": "desktop", "allFiles": false })
+    }
+}
