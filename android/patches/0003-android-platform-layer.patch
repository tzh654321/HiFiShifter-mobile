+    /// `save_file`（SAF v2）—— 弹系统「新建文档」，返回**要写到哪儿**。
+    ///
+    /// 返回 `(临时路径, URII 字符串)`：
+    ///   · **临时路径**在 cacheDir 里，调用方往它写（保持上游"拿到路径就写"的调用形状不变）；
+    ///   · 同时起一个后台 watcher，等文件写稳后自动 `write_to_uri` 上传。
+    ///
+    /// ⚠️ 为什么用 watcher 而不是加个 `commit_export` 命令：上游调用点有 4 处
+    /// （导出 WAV / 导出 MIDI / 工程另存 / 诊断报告），它们**写完就返回**。
+    /// 加"提交"命令要改 4 个调用点 + 前端；watcher 零侵入。
+    pub fn save_file(
+        mime: &str,
+        suggested_name: Option<&str>,
+    ) -> Result<Option<PathBuf>, String> {
+        let Some(SafOutcome::SaveTarget { uri, name }) =
+            request(KIND_SAVE, mime, suggested_name, DEFAULT_TIMEOUT)?
+        else {
+            return Ok(None);
+        };
+        // 用户可能在系统对话框里改了文件名；用它（拿不到就退回建议名）。
+        let file_name = name
+            .filter(|s| !s.trim().is_empty())
+            .or_else(|| suggested_name.map(|s| s.to_string()))
+            .unwrap_or_else(|| format!("export_{}.bin", std::process::id()));
+
+        // 中转目录由 Kotlin 给（只有它有 Context）—— 见 HifishifterFs.stagingDir()。
+        let dir = staging_dir()?.join(format!(
+            "{}",
+            std::time::SystemTime::now()
+                .duration_since(std::time::UNIX_EPOCH)
+                .map(|d| d.as_millis())
+                .unwrap_or(0)
+        ));
+        std::fs::create_dir_all(&dir).map_err(|e| format!("创建导出目录失败: {e}"))?;
+        let tmp = dir.join(sanitize_file_name(&file_name));
+
+        log::info!(
+            "[saf] 保存目标 → 临时路径 {}（写稳后自动上传到 {}）",
+            tmp.display(),
+            uri
+        );
+        spawn_export_watcher(tmp.clone(), uri);
+        Ok(Some(tmp))
+    }
+
+    /// 监视 `path`：等它**连续 3 次采样大小不变且 > 0**（≈1.2 秒没再长），
+    /// 就认定"写完了"，调 Kotlin 的 `writeToUri` 上传。最多等 10 分钟。
+    fn spawn_export_watcher(path: PathBuf, uri: String) {
+        std::thread::spawn(move || {
+            use std::time::{Duration, Instant};
+            let started = Instant::now();
+            let mut last_size = 0u64;
+            let mut stable = 0u32;
+            loop {
+                std::thread::sleep(Duration::from_millis(400));
+                let size = std::fs::metadata(&path).map(|m| m.len()).unwrap_or(0);
+                if size > 0 && size == last_size {
+                    stable += 1;
+                    if stable >= 3 {
+                        break;
+                    }
+                } else {
+                    stable = 0;
+                }
+                last_size = size;
+                if started.elapsed() > Duration::from_secs(600) {
+                    log::warn!("[saf] 导出 {} 等满 10 分钟仍未见文件写稳，放弃上传", path.display());
+                    return;
+                }
+            }
+            match write_to_uri(&uri, &path) {
+                Ok(true) => log::info!("[saf] 已上传 {} → {}", path.display(), uri),
+                Ok(false) => log::warn!("[saf] 上传失败（Kotlin 侧返回 false）：{uri}"),
+                Err(e) => log::warn!("[saf] 上传异常：{e}"),
+            }
+        });
+    }
