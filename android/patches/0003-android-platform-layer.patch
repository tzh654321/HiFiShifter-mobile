+// ===================== 可选模型的本地导入（ADR-012 的减包前置）===============
+//
+// 两者都走 spawn_blocking：
+//   · `import` 要等用户在系统选择器里挑文件（最长 300 秒）—— 理由与上面 dialogs 那组
+//     完全一致，绝不能留在主线程；
+//   · `list` 本身很快，但统一成 async 免得以后有人往里加一句 `metadata()` 就埋雷。
+
+#[tauri::command(rename_all = "camelCase")]
+pub async fn list_optional_models(app: tauri::AppHandle) -> serde_json::Value {
+    run_dialog_blocking("list_optional_models", move || {
+        let models = crate::model_import::list(&app);
+        serde_json::json!({ "ok": true, "models": models })
+    })
+    .await
+}
+
+#[tauri::command(rename_all = "camelCase")]
+pub async fn import_optional_model(model_id: String, app: tauri::AppHandle) -> serde_json::Value {
+    run_dialog_blocking("import_optional_model", move || {
+        serde_json::to_value(crate::model_import::import(&app, &model_id))
+            .unwrap_or_else(|e| serde_json::json!({ "ok": false, "error": e.to_string() }))
+    })
+    .await
+}
