+//! 平台差异的收口层。
+//!
+//! ## 为什么要有这一层
+//!
+//! 上游是为 Windows / macOS / Linux 写的，Android 的差异面很宽
+//! （音频后端、文件对话框、剪贴板、原生库、模型资源路径……）。
+//! 如果每个差异点都在原地写 `#[cfg(target_os = "android")]`，
+//! 那么上游每次迭代都会跟我们的 `cfg` 打架，补丁会迅速腐化。
+//!
+//! 所以约定：**平台判断尽量收口到这里**，业务代码只调用本模块暴露的
+//! 平台无关接口。上游要 rebase 时，冲突面就集中在这几个文件。
+//!
+//! 相关决策见 `docs/06-风险登记与决策记录.md` 的 ADR-004 / ADR-005。
+
+pub mod dialog;
+pub mod resources;
+pub mod window;
+
+#[cfg(target_os = "android")]
+pub mod logging;
+#[cfg(target_os = "android")]
+pub mod ndk_context;
+#[cfg(target_os = "android")]
+pub mod saf;
+
+pub use dialog::FileDialog;
+pub use resources::resolve_asset_root;
+pub use window::DesktopWindowCompat;
+
+#[cfg(target_os = "android")]
+pub use ndk_context::ensure_ndk_context;
