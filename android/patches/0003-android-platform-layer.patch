index 00000000..7dbea22f
--- /dev/null
+++ b/backend/src-tauri/src/platform/ndk_context.rs
@@ -0,0 +1,158 @@
+//! Android 的 `ndk_context` 全局初始化。
+//!
+//! ## 为什么必须有这个模块（这是本次移植的**头号硬阻塞**）
+//!
+//! `cpal` 在 Android 上的后端是 Oboe，而 Oboe 需要 Java 侧的
+//! `AudioManager` / `Context` 才能查设备能力。cpal 是通过
+//! `ndk_context::android_context()` 拿这个 Context 的：
+//!
+//! - `cpal-0.15.3/src/host/oboe/android_media.rs` 直接调用它
+//! - `cpal-0.15.3/src/host/oboe/mod.rs` 在枚举设备时经
+//!   `oboe::AudioDeviceInfo::request()` 走 `oboe-rs` 的
+//!   `src/java_interface/utils.rs`，同样落到它
+//!
+//! 而 **`ndk_context::android_context()` 在未初始化时会 `panic!`**
+//! （`ndk-context-0.1.1/src/lib.rs:72`，`expect("android context was not initialized")`）。
+//!
+//! 问题是：**整个 Tauri 栈都不初始化它**。逐处查过：
+//!
+//! | crate | 是否调用 `initialize_android_context` |
+//! | :--- | :--- |
+//! | `tauri-2.11.5` | 无 |
+//! | `tauri-runtime-wry` | 无 |
+//! | `wry-0.55.1` | 无 |
+//! | `tao-0.35.3` | 无（它的 `android_binding!` 只管自己的 Activity 生命周期）|
+//!
+//! 而且 `tauri::RuntimeOrDispatch` 位于 `pub(crate) mod sealed`，
+//! `run_on_android_context` **不是公开 API**，外部拿不到 JNIEnv / Activity。
+//!
+//! 所以症状是：**`host.devices()` 与 `device.default_output_config()` 必定 panic**，
+//! 而音频引擎一定要查设备能力 —— 硬阻塞。
+//!
+//! ## 解法
+//!
+//! 1. 自己实现 `JNI_OnLoad` 抓 `JavaVM`（`tao` / `wry` / `jni` 都没有占用这个符号，
+//!    不会重复定义）；
+//! 2. 用 `ActivityThread.currentApplication()` 拿一个 `Context`；
+//! 3. **转成全局引用**后喂给 `ndk_context::initialize_android_context`。
+//!
+//! 第 3 步的「全局引用」是关键坑：`ndk_context` 会长期持有这个 `jobject`，
+//! 而 `attach_current_thread()` 返回的 guard 析构时会 `DetachCurrentThread`，
+//! 本地引用随之失效 —— 必须 `new_global_ref` 并故意泄漏。
+//!
+//! > `ActivityThread` 属于 Android 隐藏 API，理论上可能被 non-SDK 接口限制拦截。
+//! > 在 Android 15 / API 35 / targetSdk 36 上**实测可用**（返回真实的 Application 对象）。
+//! > 真被拦时的退路：在 `gen/android` 的 Kotlin `MainActivity` 里调一个
+//! > `#[no_mangle]` 的 Rust 函数，把 Activity 显式传进来。
+//!
+//! 实测数据见 `docs/10-M0探针实测结果.md` §4。
+
+use std::ffi::c_void;
+use std::sync::atomic::{AtomicPtr, Ordering};
+
+/// `JNI_OnLoad` 拿到的 `JavaVM*`。load 期写入，之后只读。
+static JVM: AtomicPtr<c_void> = AtomicPtr::new(std::ptr::null_mut());
+
+/// JNI 版本常量。`jni-sys` 里有 `JNI_VERSION_1_6`，但这里不想为此多引一个依赖，
+/// 直接写字面量（`0x00010006`）。
+const JNI_VERSION_1_6: i32 = 0x0001_0006;
+
+/// 由 Android 的 JNI 运行期在 `dlopen` 我们的 `.so` **之后、任何 Java 调用之前**调用。
+///
+/// 这是唯一能可靠拿到 `JavaVM*` 的标准入口。
+/// 注意：`tao` / `wry` / `jni` 都**没有**定义这个符号（已逐处 grep 确认），
+/// 所以不会出现重复定义链接错误。
+///
+/// # Safety
+/// 由 JNI 运行期调用，参数由运行期保证有效。
+#[no_mangle]
+pub extern "system" fn JNI_OnLoad(vm: *mut c_void, _reserved: *mut c_void) -> i32 {
+    JVM.store(vm, Ordering::SeqCst);
+    JNI_VERSION_1_6
+}
+
+fn java_vm_ptr() -> *mut c_void {
+    JVM.load(Ordering::SeqCst)
+}
+
+/// `ndk_context` 是否已经可用。
+///
+/// **必须捕获 panic**：`android_context()` 在未初始化时会 `panic!` 而不是返回 `Err`，
+/// 所以直接用它做判断会把调用线程带走。
+pub fn is_ready() -> bool {
+    std::panic::catch_unwind(|| {
+        let ctx = ndk_context::android_context();
+        !ctx.vm().is_null() && !ctx.context().is_null()
+    })
+    .unwrap_or(false)
+}
+
+/// 确保 `ndk_context` 已初始化；已初始化则直接返回 `Ok`。
+///
+/// 应当在 Tauri 的 `setup` 里**尽早调用**，且必须在任何音频设备枚举之前。
+/// 幂等，可重复调用。
+pub fn ensure_ndk_context() -> Result<(), String> {
+    if is_ready() {
+        return Ok(());
+    }
+
+    let vm_raw = java_vm_ptr();
+    if vm_raw.is_null() {
+        return Err("JNI_OnLoad 尚未被调用（JavaVM 指针为空）—— \
+                    检查 .so 是否被 JNI 正常加载"
+            .to_string());
+    }
+
+    // SAFETY: vm_raw 来自 JNI_OnLoad，由 JNI 运行期保证是有效的 JavaVM*。
+    let vm = unsafe { jni::JavaVM::from_raw(vm_raw.cast()) }
+        .map_err(|e| format!("JavaVM::from_raw 失败: {e}"))?;
+
+    let mut env = vm
+        .attach_current_thread()
+        .map_err(|e| format!("attach_current_thread 失败: {e}"))?;
+
+    // `ActivityThread` 是隐藏 API，可能被 non-SDK 接口限制拦截（表现为抛异常）。
+    // 被拦时的退路见本模块文档。
+    let activity_thread = env.find_class("android/app/ActivityThread").map_err(|e| {
+        let _ = env.exception_clear();
+        format!("find_class(\"android/app/ActivityThread\") 失败（隐藏 API 被拦？）: {e}")
+    })?;
+
+    let app = env
+        .call_static_method(
+            activity_thread,
+            "currentApplication",
+            "()Landroid/app/Application;",
+            &[],
+        )
+        .map_err(|e| {
+            let _ = env.exception_clear();
+            format!("ActivityThread.currentApplication() 失败（隐藏 API 被拦？）: {e}")
+        })?
+        .l()
+        .map_err(|e| format!("取 Application 对象失败: {e}"))?;
+
+    if app.is_null() {
+        return Err("ActivityThread.currentApplication() 返回 null".to_string());
+    }
+
+    // ⚠️ 必须用**全局引用**。
+    // ndk_context 会长期持有这个 jobject，而本地引用会随 attach guard 析构
+    // （DetachCurrentThread）一起失效，之后任何 Java 调用都是野指针。
+    let app_global = env
+        .new_global_ref(&app)
+        .map_err(|e| format!("new_global_ref 失败: {e}"))?;
+    let ctx_ptr: *mut c_void = app_global.as_obj().as_raw().cast();
+    // 故意泄漏：ndk_context 持有它直到进程结束，释放会变成悬垂引用。
+    std::mem::forget(app_global);
+
+    // SAFETY: 两个指针都来自 JNI 且保证在整个进程生命周期内有效
+    // （JavaVM 由 JNI 持有；Context 是全局引用且我们不再释放）。
+    unsafe { ndk_context::initialize_android_context(vm_raw, ctx_ptr) };
+
+    if is_ready() {
+        Ok(())
+    } else {
+        Err("已调用 initialize_android_context，但取回来仍为空".to_string())
+    }
+}
diff --git a/backend/src-tauri/src/platform/resources.rs b/backend/src-tauri/src/platform/resources.rs
new file mode 100644
index 00000000..c0f15e17
--- /dev/null
+++ b/backend/src-tauri/src/platform/resources.rs
@@ -0,0 +1,313 @@
+//! 随包资源（`models/` 等）的路径解析。
+//!
+//! # 为什么需要这一层
+//!
+//! 上游在 `lib.rs` 的 `setup()` 里用 `app.path().resource_dir()` 找内嵌模型，
+//! 这在桌面是对的：`resource_dir()` 返回一个真实目录。
+//!
+//! 但在 **Android 上 `resource_dir()` 返回的是 `asset://localhost/`** ——
+//! 那是 Tauri 的 asset 协议 URL，**不是文件系统路径**，交给 `std::fs` 必然失败。
+//! 实测（见 `docs/10` 探针 0）：
+//!
+//! ```text
+//! resource_dir()  = asset://localhost/
+//! app_data_dir()  = /data/user/0/<pkg>      ← 真实可写
+//! ```
+//!
+//! # 做法
+//!
+//! 首次运行时把 APK 里 `assets/models/**` **流式拷贝**到
+//! `<app_data_dir>/models/**`，之后直接复用。拷贝是幂等的：
+//! 目标文件大小与资产声明长度一致就跳过。
+//!
+//! 拷到**私有数据目录**而不是 cache：
+//! - 模型不可被系统在低存储时回收；
+//! - 卸载应用时随之清理，不残留。
+//!
+//! 吞吐实测（`docs/10` 探针 4）：47–461 MB/s ⇒ 全部模型（184 MB）
+//! 在真机上约 0.4 秒、模拟器上约 1 秒。所以放在 `setup()` 里同步做是可接受的，
+//! 不需要额外的进度 UI。
+
+use std::path::PathBuf;
+
+use tauri::{AppHandle, Manager};
+
+/// 需要物化到私有目录的随包资产（相对 APK 里 `assets/` 的路径）。
+///
+/// **缺失的资产会被静默跳过** —— 这是刻意的：
+/// ADR-012 计划把 `hnsep`(88 MB) / `fcpe`(41 MB) 移出 APK 改成按需下载，
+/// 届时这份清单不用改，缺哪个就少拷哪个，上层已有的 `is_available()` 降级分支接手。
+const BUNDLED_ASSETS: &[&str] = &[
+    "models/nsf_hifigan/pc_nsf_hifigan.onnx",
+    "models/nsf_hifigan/config.json",
+    "models/hnsep/hnsep.onnx",
+    "models/hnsep/config.yaml",
+    "models/fcpe/fcpe.onnx",
+];
+
+/// 返回一个**真实文件系统**路径，其下 `models/` 可用。
+///
+/// - 桌面：直接返回 `resource_dir()`。
+/// - Android：先把随包 `models/` 同步到私有数据目录，再返回 `app_data_dir()`。
+///
+/// 返回 `None` 表示连基础目录都取不到（这种情况下上游会退回到
+/// `default_model_dir_guess()`，即"模型不可用"的降级路径）。
+pub fn resolve_asset_root(app: &AppHandle) -> Option<PathBuf> {
+    #[cfg(not(target_os = "android"))]
+    {
+        return app.path().resource_dir().ok();
+    }
+
+    // Android：`resource_dir()` 是 `asset://localhost/`，不能当路径用。
+    // 这里**完全不碰它** —— 万一它哪天返回 Err，也不该连累模型物化。
+    #[cfg(target_os = "android")]
+    {
+        let data_dir = match app.path().app_data_dir() {
+            Ok(p) => p,
+            Err(e) => {
+                log::error!("[resources] 取 app_data_dir 失败，模型将不可用: {e}");
+                return None;
+            }
+        };
+        match ensure_models_materialized(&data_dir) {
+            Ok(s) => log::info!(
+                "[resources] 模型就绪：拷贝 {} / 跳过 {} / 缺失 {}，耗时 {} ms",
+                s.copied,
+                s.skipped,
+                s.missing,
+                s.elapsed_ms
+            ),
+            // 物化失败不返回 None —— 可能只是可选模型不在包里；
+            // 让上层按各模型的存在性自然降级（上游已有 is_available() 分支）。
+            Err(e) => log::error!("[resources] 模型物化失败: {e}"),
+        }
+        Some(data_dir)
+    }
+}
+
+#[cfg(target_os = "android")]
+struct MaterializeSummary {
+    copied: usize,
+    skipped: usize,
+    missing: usize,
+    elapsed_ms: u128,
+}
+
+/// 把 `BUNDLED_ASSETS` 同步到 `data_root`（幂等）。
+#[cfg(target_os = "android")]
+fn ensure_models_materialized(data_root: &std::path::Path) -> Result<MaterializeSummary, String> {
+    use std::io::Write;
+
+    let t0 = std::time::Instant::now();
+    let mut copied = 0usize;
+    let mut skipped = 0usize;
+    let mut missing = 0usize;
+
+    with_assets(|mgr| -> Result<(), String> {
+        for rel in BUNDLED_ASSETS {
+            let Some(mut asset) = (unsafe { aasset::RawAsset::open(mgr, rel) }) else {
+                // 资产不在包里（例如 ADR-012 之后被移出的 hnsep/fcpe），跳过。
+                log::info!("[resources] 资产缺失，跳过: assets/{rel}");
+                missing += 1;
+                continue;
+            };
+            let declared = asset.len();
+
+            let dst = data_root.join(rel);
+            // 已经有同样大小的文件 → 跳过。用"大小一致"而不是"存在"，
+            // 这样中途被杀导致的半截文件会在下次启动被重拷。
+            if let Ok(meta) = std::fs::metadata(&dst) {
+                if meta.len() == declared {
+                    skipped += 1;
+                    continue;
+                }
+                log::warn!(
+                    "[resources] {} 大小不符（{} vs {}），重新拷贝",
+                    dst.display(),
+                    meta.len(),
+                    declared
+                );
+            }
+
+            if let Some(parent) = dst.parent() {
+                std::fs::create_dir_all(parent)
+                    .map_err(|e| format!("创建目录 {} 失败: {e}", parent.display()))?;
+            }
+
+            // 先写临时文件再 rename —— 避免中途被杀留下半截模型被当成完整文件。
+            let tmp = dst.with_extension("part");
+            let copy = (|| -> std::io::Result<u64> {
+                let mut f = std::fs::File::create(&tmp)?;
+                let mut buf = vec![0u8; 256 * 1024];
+                let mut total = 0u64;
+                loop {
+                    let n = asset
+                        .read(&mut buf)
+                        .map_err(|e| std::io::Error::new(e.kind(), e.to_string()))?;
+                    if n == 0 {
+                        break;
+                    }
+                    f.write_all(&buf[..n])?;
+                    total += n as u64;
+                }
+                f.flush()?;
+                Ok(total)
+            })();
+
+            match copy {
+                Ok(n) if n == declared => {
+                    std::fs::rename(&tmp, &dst)
+                        .map_err(|e| format!("rename {} 失败: {e}", dst.display()))?;
+                    log::info!(
+                        "[resources] 拷贝 {} → {}（{} MB）",
+                        rel,
+                        dst.display(),
+                        n / 1024 / 1024
+                    );
+                    copied += 1;
+                }
+                Ok(n) => {
+                    let _ = std::fs::remove_file(&tmp);
+                    return Err(format!("{rel} 实读 {n} 字节，声明 {declared} 字节，不一致"));
+                }
+                Err(e) => {
+                    let _ = std::fs::remove_file(&tmp);
+                    return Err(format!("拷贝 {rel} 失败: {e}"));
+                }
+            }
+        }
+        Ok(())
+    })
+    .ok_or_else(|| "ndk_context 未初始化，拿不到 AssetManager".to_string())??;
+
+    Ok(MaterializeSummary {
+        copied,
+        skipped,
+        missing,
+        elapsed_ms: t0.elapsed().as_millis(),
+    })
+}
+
+// ─────────────────────────────────────────────────────────────────────────────
+// Android：读取 APK assets 的底层设施
+//
+// 直接用 `AAsset*` 的 C FFI，而不用 `ndk::asset::AssetManager` ——
+// 因为 `ndk 0.9` **没有 `AssetManager::from_java`**（只有 `from_ptr`），
+// 也没公开重导出 `ndk_sys`，硬写版本号会把代码和 ndk crate 内部依赖绑死。
+// 这几个符号在 **libandroid.so**（不是 libc），NDK sysroot 里两个 ABI 都有 stub。
+// ─────────────────────────────────────────────────────────────────────────────
+#[cfg(target_os = "android")]
+mod aasset {
+    use std::ffi::{c_char, c_int, c_void, CString};
+
+    #[link(name = "android")]
+    extern "C" {
+        fn AAssetManager_fromJava(env: *mut c_void, asset_manager: *mut c_void) -> *mut c_void;
+        fn AAssetManager_open(mgr: *mut c_void, filename: *const c_char, mode: c_int) -> *mut c_void;
+        fn AAsset_getLength64(asset: *mut c_void) -> i64;
+        fn AAsset_read(asset: *mut c_void, buf: *mut c_void, count: usize) -> c_int;
+        fn AAsset_close(asset: *mut c_void);
+    }
+
+    /// `AASSET_MODE_STREAMING` —— 顺序读整个资产，内部走解压流。
+    /// （enum：UNKNOWN=0, RANDOM=1, STREAMING=2, BUFFER=3）
+    const MODE_STREAMING: c_int = 2;
+
+    /// 取原生 `AAssetManager*`。返回的指针由 Java 侧持有，**不可释放**。
+    ///
+    /// # Safety
+    /// `env` 必须是当前线程有效的 `JNIEnv*`。
+    pub unsafe fn manager_from_java(env: *mut c_void, java_am: *mut c_void) -> *mut c_void {
+        unsafe { AAssetManager_fromJava(env, java_am) }
+    }
+
+    /// 持有 `AAsset*` 的 RAII 包装，`Drop` 时 `AAsset_close`。
+    pub struct RawAsset {
+        ptr: *mut c_void,
+    }
+
+    impl RawAsset {
+        /// # Safety
+        /// `mgr` 必须来自 [`manager_from_java`]。
+        pub unsafe fn open(mgr: *mut c_void, name: &str) -> Option<Self> {
+            let cname = CString::new(name).ok()?;
+            let ptr = unsafe { AAssetManager_open(mgr, cname.as_ptr(), MODE_STREAMING) };
+            // 🔴 这里**不能**写 `(!ptr.is_null()).then_some(Self { ptr })`。
+            // `bool::then_some` 的参数是**按值传**的 ⇒ 它会**先无条件构造** `Self { ptr }`，
+            // 再在条件为假时把这个值丢掉 —— 而本类型的 `Drop` 要调 `AAsset_close`，
+            // 于是 `AAsset_close(NULL)` 直接 **SIGSEGV**。
+            //
+            // 实测（2026-09-21，ADR-012 减包后）：APK 里不再包含 `hnsep.onnx` / `fcpe.onnx`，
+            // `ensure_models_materialized` 走"资产缺失就跳过"的分支，刚启动就崩：
+            //   Fatal signal 11 (SIGSEGV), fault addr 0x0
+            //     AAsset_close+4 ← RawAsset::drop ← drop_glue ← bool::then_some ← RawAsset::open
+            // 以前 5 个模型都随包，这条路径从未被走到，所以一直没暴露。
+            if ptr.is_null() {
+                None
+            } else {
+                Some(Self { ptr })
+            }
+        }
+
+        /// 资产声明长度（用于和实际拷贝字节数交叉校验）。
+        pub fn len(&self) -> u64 {
+            unsafe { AAsset_getLength64(self.ptr).max(0) as u64 }
+        }
+
+        /// 读一段。返回 0 表示 EOF，负数转成 `io::Error`。
+        pub fn read(&mut self, buf: &mut [u8]) -> std::io::Result<usize> {
+            let n = unsafe { AAsset_read(self.ptr, buf.as_mut_ptr().cast(), buf.len()) };
+            if n < 0 {
+                Err(std::io::Error::last_os_error())
+            } else {
+                Ok(n as usize)
+            }
+        }
+    }
+
+    impl Drop for RawAsset {
+        fn drop(&mut self) {
+            // 防御性判空：即便将来又有谁构造出空指针的实例（见 `open` 的注释），
+            // 也不能让 `AAsset_close(NULL)` 把进程崩掉。
+            if !self.ptr.is_null() {
+                unsafe { AAsset_close(self.ptr) }
+            }
+        }
+    }
+}
+
+/// 在「当前线程 attached 且持有 Java AssetManager」的作用域内执行 `f`。
+///
+/// `ndk_context` 由本 crate 的 `platform::ndk_context::ensure_ndk_context()` 初始化
+/// （Tauri 栈自己不初始化它，见 `docs/10` §4）。
+#[cfg(target_os = "android")]
+fn with_assets<R>(f: impl FnOnce(*mut std::ffi::c_void) -> R) -> Option<R> {
+    let ctx = ndk_context::android_context();
+    if ctx.vm().is_null() || ctx.context().is_null() {
+        log::error!("[resources] ndk_context 未初始化，拿不到 AssetManager");
+        return None;
+    }
+    let vm = unsafe { jni::JavaVM::from_raw(ctx.vm().cast()) }.ok()?;
+    let mut env = vm.attach_current_thread().ok()?;
+    let activity = unsafe { jni::objects::JObject::from_raw(ctx.context().cast()) };
+    let java_am = env
+        .call_method(
+            &activity,
+            "getAssets",
+            "()Landroid/content/res/AssetManager;",
+            &[],
+        )
+        .ok()?
+        .l()
+        .ok()?;
+
+    let raw_env: *mut std::ffi::c_void = env.get_native_interface().cast();
+    let raw_am: *mut std::ffi::c_void = java_am.as_raw().cast();
+    let mgr = unsafe { aasset::manager_from_java(raw_env, raw_am) };
+    if mgr.is_null() {
+        log::error!("[resources] AAssetManager_fromJava 返回空指针");
+        return None;
+    }
+
+    Some(f(mgr))
+}
diff --git a/backend/src-tauri/src/platform/saf.rs b/backend/src-tauri/src/platform/saf.rs
new file mode 100644
index 00000000..4c3eb51e
--- /dev/null
+++ b/backend/src-tauri/src/platform/saf.rs
@@ -0,0 +1,968 @@
+//! SAF（Storage Access Framework）桥接 —— Android 上的文件选择。
+//!
+//! *设计见 `docs/11-SAF文件访问设计.md`。*
+//!
+//! ## 为什么需要它
+//!
+//! Android 不允许应用浏览文件系统路径，文件入口只有 SAF：由系统选择器返回
+//! `content://` URI。而上游是**路径驱动**的（`std::fs::File::open(path)` 散落几十处，
+//! 工程文件里存的就是路径），把 `content://` 一路透传要改几十处 IO 并破坏架构。
+//!
+//! 所以走「**边界物化**」：Kotlin 侧拿到 URI 后立刻把流拷进 `cacheDir/saf_import/`
+//! （见 `android/kotlin/HifishifterFs.kt`），把**真实路径**回传到这里。
+//! 上游 13 处 `FileDialog` 调用点与全部路径驱动 IO **一行不改**。
+//!
+//! ## 线程模型
+//!
+//! `request()` **阻塞当前线程**直到 Kotlin 回传或超时。上游命令是 async（tokio），
+//! 每次调用占一个 worker，可以接受。**绝不能在 UI 线程调用**（会把选择器冻住）。
+//!
+//! 回传走 JNI 静态方法 `HifishifterFs.nativeOnResult`，它运行在 **UI 线程**；
+//! 两者通过 `PENDING` 里的 `mpsc::Sender` 会合。
+//!
+//! ## 为什么必须有超时
+//!
+//! 用户可能把选择器留在后台不管，或者系统在低内存时杀了 Activity ——
+//! 没有超时那张 `Sender` 会永远等下去，命令永久挂住、前端卡在 loading。
+
+#[cfg(target_os = "android")]
+pub use android_impl::*;
+
+#[cfg(target_os = "android")]
+mod android_impl {
+    use std::path::PathBuf;
+    use std::sync::atomic::{AtomicU64, Ordering};
+    use std::sync::mpsc::{channel, RecvTimeoutError, Sender};
+    use std::sync::Mutex;
+    use std::time::Duration;
+
+    use jni::objects::{JClass, JObject, JString, JValue};
+    use jni::sys::{jint, jlong};
+    use jni::JNIEnv;
+
+    /// Kotlin 侧 `HifishifterFs.KIND_*`，改动要同步。
+    pub const KIND_OPEN: i32 = 0;
+    #[allow(dead_code)]
+    pub const KIND_SAVE: i32 = 1;
+    #[allow(dead_code)]
+    pub const KIND_TREE: i32 = 2;
+
+    /// 用户可能把选择器晾着，但不能无限等 —— 见模块头。
+    pub const DEFAULT_TIMEOUT: Duration = Duration::from_secs(300);
+
+    /// 导出中转目录（在 cacheDir 下）。调用方先往这里写，写稳后由 watcher 上传到用户选的 URI。
+    /// 与导入侧的 `saf_import/` 分开，便于 `pruneOldImports` 之外单独清理。
+    const EXPORT_DIR: &str = "saf_export";
+
+    /// 取消的专用错误码。Kotlin 用它区分「用户取消」（⇒ `Ok(None)`）
+    /// 与「能力/系统出错」（⇒ `Err`）。这条语义区分是 `dialog.rs` 头部注释
+    /// 承诺过的：**取消 = None，能力缺失 = Err**。
+    const ERR_CANCELLED: &str = "saf_cancelled";
+
+    const KOTLIN_CLASS: &str = "com.arounder.hifishifter.HifishifterFs";
+
+    /// 一次 SAF 请求的三种落点。
+    ///
+    /// ⚠️ 必须分开表达，不能都塞进 `Option<PathBuf>`（2026-09-22 加 SAF v2 时踩到）：
+    /// **导入与保存的方向是相反的** ——
+    ///   · 导入（KIND_OPEN）：`content://` 在用户那边，我们把它**拷进** cacheDir
+    ///     ⇒ 落点是「cacheDir 里的真实路径」；
+    ///   · 保存（KIND_SAVE）：用户选的是"**要写到哪儿**"，此时 cacheDir 里还没有东西
+    ///     ⇒ 落点是「目标 URI + 建议文件名」，必须先生成临时路径让调用方写，
+    ///     写完再由 `write_to_uri` 上传。
+    /// 若仍用 `PathBuf` 硬装 URI，调用方会拿它当真实文件去 fopen —— 必然失败。
+    pub enum SafOutcome {
+        /// 导入：已物化到 cacheDir 的真实路径。
+        Path(PathBuf),
+        /// 保存：用户选定的目标（URI 字符串 + 用户可能改过的文件名）。
+        SaveTarget { uri: String, name: Option<String> },
+    }
+
+    /// 等待中的请求。`Vec` 而不是 `HashMap`：同一时刻最多一两个（选择器是模态的），
+    /// 而且 `Vec::new()` 是 const，可以直接放 `static`。
+    static PENDING: Mutex<Vec<(u64, Sender<Result<SafOutcome, String>>)>> = Mutex::new(Vec::new());
+
+    static NEXT_ID: AtomicU64 = AtomicU64::new(1);
+
+    /// 发起一次 SAF 请求并等待结果。
+    ///
+    /// * `Ok(Some(path))` —— 用户选了文件，`path` 是物化到 cacheDir 的真实路径
+    /// * `Ok(None)` —— 用户取消（与上游 `FileDialog` 的 `None` 语义一致）
+    /// * `Err(_)` —— 桥接不可用 / 系统出错（**不该**被当成"取消"）
+    pub fn request(
+        kind: i32,
+        mime: &str,
+        suggested_name: Option<&str>,
+        timeout: Duration,
+    ) -> Result<Option<SafOutcome>, String> {
+        let id = NEXT_ID.fetch_add(1, Ordering::Relaxed);
+        let (tx, rx) = channel();
+        PENDING.lock().unwrap().push((id, tx));
+
+        if let Err(e) = call_kotlin_request(id, kind, mime, suggested_name) {
+            drop_pending(id);
+            return Err(e);
+        }
+
+        match rx.recv_timeout(timeout) {
+            Ok(Ok(outcome)) => Ok(Some(outcome)),
+            Ok(Err(e)) if e == ERR_CANCELLED => Ok(None),
+            Ok(Err(e)) => Err(e),
+            Err(RecvTimeoutError::Timeout) => {
+                drop_pending(id);
+                Err(format!(
+                    "SAF 选择器 {} 秒内没有回传（用户把选择器晾着，或 Activity 被系统回收）",
+                    timeout.as_secs()
+                ))
+            }
+            Err(RecvTimeoutError::Disconnected) => Err("SAF 等待通道被关闭".to_string()),
+        }
+    }
