+pub fn nsf_hifigan_onnx_probe() -> Result<String, String> {
+    // Probe ONNX model availability.
+    #[cfg(feature = "onnx")]
+    {
+        nsf_hifigan_onnx::probe_load().map(|_| "ok".to_string())
+    }
+    #[cfg(not(feature = "onnx"))]
+    {
+        Err("onnx feature disabled".to_string())
+    }
+}
