+                // Force-drop all ONNX sessions to release GPU memory before exit.
+                crate::nsf_hifigan_onnx::drop_shared_session();
+                crate::fcpe_onnx::drop_shared_session();
+                crate::hnsep_onnx::drop_shared_session();
+            }
+        });
+}
diff --git a/backend/src-tauri/src/model_import.rs b/backend/src-tauri/src/model_import.rs
new file mode 100644
index 00000000..f54089de
--- /dev/null
+++ b/backend/src-tauri/src/model_import.rs
@@ -0,0 +1,306 @@
+//! 可选模型的「本地导入」通道（ADR-012 减包的前置）。
+//!
+//! ## 背景
+//!
+//! APK 里只内置核心声码器 `nsf_hifigan`（54 MB）；`hnsep`（气声分离，~92 MB）与
+//! `fcpe`（F0 提取，~43 MB）走「下载 / 本地导入」双通道 —— 见 `docs/02` §3.3 与 §7.4。
+//! **本地导入走的就是 SAF**（`docs/11`），所以本项排在 SAF 之后。
+//!
+//! ## 落点：与「从 APK 拷贝」完全同一个位置
+//!
+//! `platform::resources.rs` 会把随包的 `assets/models/**` 拷到
+//! `<app_data_dir>/models/**`；本模块把用户导入的权重放到**同一个目录树**里。
+//! 于是模型加载侧（`lib.rs` 里那三个 `OnceLock` + `vocoder/*`）**一行都不用改**，
+//! 也不需要"这个模型是内置的还是导入的"这种区分。
+//!
+//! ## 为什么只导入权重、不导入整个目录
+//!
+//! `hnsep` 还带一个 78 字节的 `config.yaml`，`nsf_hifigan` 带 `config.json`。
+//! 这些小文件**继续随包**（合计 < 1 KB），只有大权重需要用户提供。
+//! 这样"选目录"就不是必需的 —— 而 SAF v1 恰好没实现 `pick_folder`
+//! （tree URI 要懒物化，见 `docs/11` §7.2）。
+//!
+//! ## 免重启生效
+//!
+//! `lib.rs::setup()` 只在启动时按"文件是否存在"设置一次那三个 `OnceLock`。
+//! 用户中途导入时我们**自己把 `OnceLock` 设上**（`lib.rs::activate_optional_model`），
+//! 所以不需要重启应用 —— 这是这个模块能"点完就用"的关键。
+
+use std::path::{Path, PathBuf};
+
+/// 一个可导入的可选模型。
+#[derive(Debug, Clone, Copy)]
+pub struct OptionalModel {
+    /// 前端用的稳定 id（也是 `activate_optional_model` 的键）
+    pub id: &'static str,
+    /// 界面上的名字
+    pub label: &'static str,
+    /// 相对 `models/` 的落点，同时也是文件选择器里的建议文件名
+    pub rel: &'static str,
+    /// 大概体积，仅用于界面提示
+    pub approx_mb: u32,
+}
+
+/// 清单。落点必须与 `platform::resources::BUNDLED_ASSETS` 里的同名条目一致。
+pub const OPTIONAL_MODELS: &[OptionalModel] = &[
+    OptionalModel {
+        id: "hnsep",
+        label: "气声分离（hnsep）",
+        rel: "hnsep/hnsep.onnx",
+        approx_mb: 88,
+    },
+    OptionalModel {
+        id: "fcpe",
+        label: "F0 提取（fcpe）",
+        rel: "fcpe/fcpe.onnx",
+        approx_mb: 41,
+    },
+];
+
+pub fn find(id: &str) -> Option<&'static OptionalModel> {
+    OPTIONAL_MODELS.iter().find(|m| m.id == id)
+}
+
+/// `<app_data_dir>/models`。取不到（或桌面端不该往这里写）时返回 `None`。
+///
+/// 桌面端返回 `None`：桌面上 `resolve_asset_root()` 是 `resource_dir()`，
+/// 那是安装目录、通常不可写；桌面用户直接手工放模型即可，不需要这条通道。
+pub fn models_root(app: &tauri::AppHandle) -> Option<PathBuf> {
+    #[cfg(target_os = "android")]
+    {
+        use tauri::Manager;
+        app.path().app_data_dir().ok().map(|d| d.join("models"))
+    }
+    #[cfg(not(target_os = "android"))]
+    {
+        let _ = app;
+        None
+    }
+}
+
+/// 某个模型当前的状态。
+#[derive(Debug, Clone, serde::Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct OptionalModelStatus {
+    pub id: String,
+    pub label: String,
+    /// 用户需要提供的那一个文件名（如 `hnsep.onnx`）
+    pub file_name: String,
+    pub approx_mb: u32,
+    /// 文件已在位
+    pub present: bool,
+    /// 实际字节数（不在位则 `None`）
+    pub size_bytes: Option<u64>,
+    /// 运行时是否已经加载（`OnceLock` 已设）。`present && !active` 只可能出现在
+    /// "文件在位但启动时还没设上"的窗口期，正常流程里两者一致。
+    pub active: bool,
+    /// 这条通道在本平台是否可用
+    pub supported: bool,
+}
+
+pub fn list(app: &tauri::AppHandle) -> Vec<OptionalModelStatus> {
+    let root = models_root(app);
+    let supported = root.is_some();
+    OPTIONAL_MODELS
+        .iter()
+        .map(|m| {
+            let path = root.as_ref().map(|r| r.join(m.rel));
+            let size_bytes = path
+                .as_ref()
+                .and_then(|p| std::fs::metadata(p).ok())
+                .map(|meta| meta.len())
+                .filter(|n| *n > 0);
+            OptionalModelStatus {
+                id: m.id.to_string(),
+                label: m.label.to_string(),
+                file_name: file_name_of(m.rel),
+                approx_mb: m.approx_mb,
+                present: size_bytes.is_some(),
+                size_bytes,
+                active: is_active(m.id),
+                supported,
+            }
+        })
+        .collect()
+}
+
+fn is_active(id: &str) -> bool {
+    match id {
+        "hnsep" => crate::hnsep_model_dir().is_some(),
+        "fcpe" => crate::fcpe_onnx_path().is_some(),
+        _ => false,
+    }
+}
+
+fn file_name_of(rel: &str) -> String {
+    rel.rsplit('/').next().unwrap_or(rel).to_string()
+}
+
+/// ONNX 权重的体积下限。低于这个值基本不可能是模型（`nsf_hifigan` 最小也有 54 MB）。
+const MIN_WEIGHT_BYTES: u64 = 1024 * 1024;
+
+/// 导入结果。
+#[derive(Debug, Clone, serde::Serialize)]
+#[serde(rename_all = "camelCase")]
+pub struct ImportResult {
+    pub ok: bool,
+    /// 用户在系统选择器里取消了（**不是**错误）
+    pub canceled: bool,
+    pub id: String,
+    pub path: Option<String>,
+    pub size_bytes: Option<u64>,
+    /// 导入后运行时是否已激活（免重启生效）
+    pub activated: bool,
+    pub error: Option<String>,
+}
+
+impl ImportResult {
+    fn canceled(id: &str) -> Self {
+        Self {
+            ok: true,
+            canceled: true,
+            id: id.to_string(),
+            path: None,
+            size_bytes: None,
+            activated: false,
+            error: None,
+        }
+    }
+
+    fn failed(id: &str, error: impl Into<String>) -> Self {
+        Self {
+            ok: false,
+            canceled: false,
+            id: id.to_string(),
+            path: None,
+            size_bytes: None,
+            activated: false,
+            error: Some(error.into()),
+        }
+    }
+}
+
+/// 弹系统选择器让用户挑一个权重文件，校验后放进 `<models_root>/<m.rel>`。
+///
+/// **阻塞**（等用户操作，最长 300 秒），调用方必须已经在非主线程上。
+pub fn import(app: &tauri::AppHandle, id: &str) -> ImportResult {
+    let Some(model) = find(id) else {
+        return ImportResult::failed(id, format!("未知的模型 id: {id}"));
+    };
+    let Some(root) = models_root(app) else {
+        return ImportResult::failed(
+            id,
+            "本平台不支持本地导入（桌面端请直接把模型放到资源目录）",
+        );
+    };
+
+    let suggested = file_name_of(model.rel);
+    let picked = match pick_weight_file(&suggested) {
+        Ok(Some(path)) => path,
+        Ok(None) => return ImportResult::canceled(id),
+        Err(e) => return ImportResult::failed(id, e),
+    };
+
+    let size = match inspect_weight(&picked) {
+        Ok(size) => size,
+        Err(e) => return ImportResult::failed(id, e),
+    };
+
+    let dst = root.join(model.rel);
+    if let Err(e) = copy_atomic(&picked, &dst) {
+        return ImportResult::failed(id, e);
+    }
+    log::info!(
+        "[model-import] {} 导入完成：{} → {}（{} 字节）",
+        id,
+        picked.display(),
+        dst.display(),
+        size
+    );
+
+    // 免重启生效：把启动时没设上的 OnceLock 补上。
+    let activated = crate::activate_optional_model(id, dst.clone());
+    if !activated && !is_active(id) {
+        log::warn!("[model-import] {id} 文件已就位，但没能激活 —— 可能需要重启应用");
+    }
+
+    ImportResult {
+        ok: true,
+        canceled: false,
+        id: id.to_string(),
+        path: Some(dst.display().to_string()),
+        size_bytes: Some(size),
+        activated: activated || is_active(id),
+        error: None,
+    }
+}
+
+/// 校验候选文件，返回字节数。
+///
+/// 只做**体积下限**这一条硬校验；ONNX 是 protobuf，理论上首字节应是
+/// `0x08`（`ir_version`，field 1 + varint），但字段顺序并没有强制规定，
+/// **硬拒会误杀合法导出**。所以这条只记日志（soft）：真选错文件时，
+/// 模型加载会给出明确错误，用户重导即可 —— 比"选对了却被拒"好处理得多。
+fn inspect_weight(path: &Path) -> Result<u64, String> {
+    let meta = std::fs::metadata(path).map_err(|e| format!("读不到所选文件：{e}"))?;
+    if !meta.is_file() {
+        return Err("选中的不是文件".to_string());
+    }
+    let size = meta.len();
+    if size < MIN_WEIGHT_BYTES {
+        return Err(format!(
+            "文件只有 {size} 字节，不像模型权重（至少要 {} 字节）",
+            MIN_WEIGHT_BYTES
+        ));
+    }
+
+    use std::io::Read;
+    if let Ok(mut f) = std::fs::File::open(path) {
+        let mut head = [0u8; 4];
+        if f.read_exact(&mut head).is_ok() && head[0] != 0x08 {
+            log::warn!(
+                "[model-import] {} 的首字节是 {:#04x}（ONNX 通常是 0x08），\
+                 可能是非 ONNX 文件；不拦，交给模型加载去报错",
+                path.display(),
+                head[0]
+            );
+        }
+    }
+    Ok(size)
+}
+
+/// 先写 `.part` 再 `rename` —— 中途失败不会留下"看起来完整的半截模型"。
+/// 与 `platform::resources::sync_bundled_assets` 的做法一致。
+fn copy_atomic(src: &Path, dst: &Path) -> Result<(), String> {
+    let parent = dst
+        .parent()
+        .ok_or_else(|| format!("目标路径没有父目录: {}", dst.display()))?;
+    std::fs::create_dir_all(parent).map_err(|e| format!("建目录 {} 失败: {e}", parent.display()))?;
+
+    let name = dst
+        .file_name()
+        .and_then(|n| n.to_str())
+        .ok_or_else(|| format!("目标文件名非法: {}", dst.display()))?;
+    let tmp = parent.join(format!("{name}.part"));
+
+    std::fs::copy(src, &tmp).map_err(|e| format!("拷贝到 {} 失败: {e}", tmp.display()))?;
+    std::fs::rename(&tmp, dst).map_err(|e| {
+        let _ = std::fs::remove_file(&tmp);
+        format!("落位 {} 失败: {e}", dst.display())
+    })?;
+    Ok(())
+}
+
+/// 弹 SAF 选择器挑权重文件。
+///
+/// MIME 用 `*/*`：ONNX 没有注册的 MIME，给 `application/octet-stream` 在部分
+/// 机型的 DocumentsUI 上会把文件灰掉（不可选）。
+#[cfg(target_os = "android")]
+fn pick_weight_file(suggested: &str) -> Result<Option<PathBuf>, String> {
+    crate::platform::saf::pick_file("*/*", Some(suggested))
+}
+
+#[cfg(not(target_os = "android"))]
+fn pick_weight_file(_suggested: &str) -> Result<Option<PathBuf>, String> {
+    Err("本平台不支持本地导入".to_string())
+}
diff --git a/backend/src-tauri/src/platform/dialog.rs b/backend/src-tauri/src/platform/dialog.rs
new file mode 100644
index 00000000..53b08762
--- /dev/null
+++ b/backend/src-tauri/src/platform/dialog.rs
@@ -0,0 +1,293 @@
+//! 文件对话框的平台收口。
+//!
+//! ## 为什么需要收口
+//!
+//! 上游直接调用 `rfd::FileDialog`（13 处，分布在 `commands/` 下 6 个文件）。
+//! **`rfd 0.15` 在 Android 上没有实现任何对话框后端**，交叉编译直接失败：
+//!
+//! ```text
+//! rfd-0.15.4/src/file_dialog.rs:151:39: error[E0277]:
+//!     the trait bound `FileDialog: FileSaveDialogImpl` is not satisfied
+//! rfd-0.15.4/src/message_dialog.rs:80:33: error[E0277]:
+//!     the trait bound `MessageDialog: MessageDialogImpl` is not satisfied
+//! error: could not compile `rfd` (lib) due to 12 previous errors
+//! ```
+//!
+//! ## Android 上走 SAF（M2 已接）
+//!
+//! Android 不允许应用浏览文件系统路径，正确做法是
+//! **SAF（Storage Access Framework）**：Kotlin 侧用
+//! `Intent.ACTION_OPEN_DOCUMENT` 等拿到 `content://` URI，**立刻把流物化到
+//! `cacheDir/saf_import/`**，把真实路径回传给 Rust —— 这样上游几十处
+//! 「路径驱动」的文件 IO 一行不改。链路与取舍见 `docs/11`，实现见
+//! `crate::platform::saf` + `android/kotlin/HifishifterFs.kt`。
+//!
+//! ## 返回形状没有变（刻意的）
+//!
+//! 上游 13 处调用点都写成 `if let Some(path) = dialog.pick_file() { … } else { 取消 }`。
+//! 把返回值改成 `Result` 会牵动这 13 处业务代码，与本移植「不碰上游业务逻辑」的
+//! 原则冲突。所以这里**保持 `Option` 形状**，代价是「取消」与「桥接失败」都表现为
+//! `None`；两者的区别只能靠日志区分（见各方法里的 `warn!` / `error!`）。
+//! `docs/11` §3.4 原计划用 `Result` 表达这个区分，实现时按上述理由降级为日志级别。
+//!
+//! ## v1 覆盖范围（2026-09-20）
+//!
+//! | 方法 | 调用点 | 状态 |
+//! | :--- | ---: | :--- |
+//! | `pick_file` | 7 | ✅ 真弹窗（导入音频/打开工程/导入 MIDI/REAPER/VocalShifter/诊断）|
+//! | `pick_files` | 1 | ✅ 单选降级（多选要 `EXTRA_ALLOW_MULTIPLE` + `clipData`，见 `docs/11` §6）|
+//! | `pick_folder` | 1 | ⏳ 返回 `None` + `warn`（tree URI 需要"懒物化"，`docs/11` §7.2 留到 v2）|
+//! | `save_file` | 4 | ⏳ 返回 `None` + `warn`（"另存为"是唯一有状态的方向，`docs/11` §3.5）|
+
+#[cfg(not(target_os = "android"))]
+pub use rfd::FileDialog;
+
+#[cfg(target_os = "android")]
+pub use android_impl::FileDialog;
+
+#[cfg(target_os = "android")]
+mod android_impl {
+    use std::path::{Path, PathBuf};
+
+    /// `rfd::FileDialog` 的 Android 实装（SAF）。
+    ///
+    /// builder 的方法签名与 `rfd 0.15` 对齐（含 `impl Into<String>` /
+    /// `impl AsRef<Path>` 这类泛型参数），保证调用点可以原样迁移。
+    #[derive(Clone, Debug, Default)]
+    pub struct FileDialog {
+        title: Option<String>,
+        file_name: Option<String>,
+        /// `add_filter` 记下来的扩展名。SAF 用 MIME 过滤，所以要把它翻译成 MIME。
+        extensions: Vec<String>,
+    }
+
+    impl FileDialog {
+        pub fn new() -> Self {
+            Self::default()
+        }
+
+        pub fn add_filter(self, _name: impl Into<String>, extensions: &[&str]) -> Self {
+            let mut merged = self.extensions;
+            for e in extensions {
+                let e = e.trim_start_matches('*').trim_start_matches('.').to_ascii_lowercase();
+                if !e.is_empty() && !merged.contains(&e) {
+                    merged.push(e);
+                }
+            }
+            Self {
+                extensions: merged,
+                ..self
+            }
+        }
+
+        /// SAF 没有"起始目录"的概念（就是系统选择器的上次位置），只记录不参与。
+        pub fn set_directory(self, _directory: impl AsRef<Path>) -> Self {
+            self
+        }
+
+        pub fn set_file_name(self, file_name: impl Into<String>) -> Self {
+            Self {
+                file_name: Some(file_name.into()),
+                ..self
+            }
+        }
+
+        pub fn set_title(self, title: impl Into<String>) -> Self {
+            Self {
+                title: Some(title.into()),
+                ..self
+            }
+        }
+
+        pub fn pick_file(self) -> Option<PathBuf> {
+            self.pick("pick_file")
+        }
+
+        /// 多选在 v1 降级为单选（`docs/11` §6）。
+        pub fn pick_files(self) -> Option<Vec<PathBuf>> {
+            self.pick("pick_files（v1 降级为单选）").map(|p| vec![p])
+        }
+
+        pub fn pick_folder(self) -> Option<PathBuf> {
+            // #8：已实现。返回的是 **tree URI**（不是真实路径）—— Android 11+ 下真实路径
+            // 不可读，必须持 URI 走 SAF。`file_browser::list_directory` 会据此反推真实路径前缀，
+            // 前端仍然用熟悉的 `/storage/emulated/0/...` 显示。
+            match crate::platform::saf::pick_folder() {
+                Ok(Some(uri)) => {
+                    log::info!("[dialog] 选择目录 → 已授权 {uri}");
+                    Some(PathBuf::from(uri))
+                }
+                Ok(None) => {
+                    log::info!("[dialog] 选择目录 → 用户取消");
+                    None
+                }
+                Err(e) => {
+                    log::error!("[dialog] 选择目录 → SAF 失败：{e}");
+                    None
+                }
+            }
+        }
+
+        /// 保存（另存为）—— **SAF v2，2026-09-22 起已实现**。
+        ///
+        /// 之前一直按「未实现」返回 None，用户看到的就是「已取消保存」。
+        ///
+        /// 方向与导入相反，所以走法也不同：先弹系统「新建文档」拿**目标 URI**，
+        /// 再在 cacheDir 里生成一个**中转路径**返回给调用方写（保持上游
+        /// 「拿到路径就写」的调用形状不变）；中转文件写稳后由 watcher 自动上传。
+        /// 详见 platform::saf 里的 save_file 与 spawn_export_watcher。
+        pub fn save_file(self) -> Option<PathBuf> {
+            let mime = self.save_mime();
+            let detail = self.detail();
+            log::info!("[dialog] 另存为{detail} → 用 MIME {mime} 发起 CREATE_DOCUMENT");
+            match crate::platform::saf::save_file(&mime, self.file_name.as_deref()) {
+                Ok(Some(path)) => {
+                    log::info!(
+                        "[dialog] 另存为{detail} → 中转路径 {}（写稳后自动上传）",
+                        path.display()
+                    );
+                    Some(path)
+                }
+                Ok(None) => {
+                    log::info!("[dialog] 另存为{detail} → 用户取消");
+                    None
+                }
+                Err(e) => {
+                    // 与导入一致：这不是「取消」，是桥接出问题，用 error 级别留痕。
+                    log::error!("[dialog] 另存为{detail} → SAF 失败：{e}");
+                    None
+                }
+            }
+        }
+
+        // ── 内部 ────────────────────────────────────────────────────────────
+
+        /// 扩展名是否落在 `add_filter` 声明的那组里（大小写不敏感）。
+        ///
+        /// 🔴 为什么必须有这道闸门（2026-09-22 实测）：**SAF 只能按 MIME 过滤**，
+        /// Android 上"系统不认识"的类型照样会出现在选择器里、也照样能点。
+        /// 日志实证：用户点「导入工程」（exts=`hshp/hsp/json`）时选中了一个 **.mp3**，
+        /// 它被正常物化进 `cache/saf_import/`，然后交给下游按工程格式解析 ——
+        /// 报出来的错又深又难懂。这里提前拦住，`None` 的形状与"用户取消"一致，
+        /// 调用点一行不用改（见文件头"返回形状没有变"）。
+        fn extension_ok(&self, path: &std::path::Path) -> bool {
+            if self.extensions.is_empty() {
+                return true; // 没声明过滤器 = 什么都收
+            }
+            let Some(ext) = path.extension().and_then(|e| e.to_str()) else {
+                return false;
+            };
+            let ext = ext.to_ascii_lowercase();
+            self.extensions.iter().any(|e| e == &ext)
+        }
+
+        fn pick(self, what: &str) -> Option<PathBuf> {
+            let mime = self.mime();
+            let detail = self.detail();
+            match crate::platform::saf::pick_file(&mime, self.file_name.as_deref()) {
+                Ok(Some(path)) => {
+                    // ⚠️ 2026-09-22 修正：这道闸门**只记日志、不拦截**。
+                    //
+                    // 最初写成"扩展名不符就 return None"，本意是拦掉 SAf 拦不住的错选
+                    // （日志里确实抓到过用户点「导入工程」却选中 .mp3）。但实测真机上
+                    // 变成了**误伤**：正常导入也弹「已取消导入」—— 因为
+                    //   · 不同的导入入口声明的扩展名集合不同（音频 / MIDI / 工程各一套），
+                    //   · 而 SAF 物化出来的临时文件名未必保留原扩展名，
+                    // 两者一错位就把合法文件判成非法，而 `None` 的语义又正好是"用户取消"，
+                    // 用户看到的就是"我明明选了文件却说已取消"。
+                    //
+                    // 现在退回到"放行 + 留证据"：文件照常交给下游，下游真处理不了时
+                    // 这里的 warn 日志能指明是类型不对，排查时不用再猜。
+                    if !self.extension_ok(&path) {
+                        log::warn!(
+                            "[dialog] {what}{detail} → 扩展名不在期望集合内（期望 {exts}），\
+                             但**仍按用户选择放行**。若下游随后报解析失败，根因多半在这里：\
+                             SAF 只能按 MIME 过滤，扩展名拦不住。",
+                            exts = self.extensions.join("/")
+                        );
+                    }
+                    log::info!("[dialog] {what}{detail} → 已物化 {}", path.display());
+                    Some(path)
+                }
+                Ok(None) => {
+                    log::info!("[dialog] {what}{detail} → 用户取消");
+                    None
+                }
+                Err(e) => {
+                    // 注意：这里**不是**取消 —— 是桥接不可用。用 error 级别，
+                    // 但返回值形状仍是 None（见文件头"返回形状没有变"）。
+                    log::error!("[dialog] {what}{detail} → SAF 失败：{e}");
+                    None
+                }
+            }
+        }
+
+        /// 把 `add_filter` 记下的扩展名翻译成 SAF 的 MIME。
+        ///
+        /// SAF 只接受 MIME；给 `*/*` 最保险但会让选择器列出所有文件，
+        /// 所以能识别就收窄（音频是最常见的一类）。
+        fn mime(&self) -> String {
+            let mut audio = false;
+            let mut midi = false;
+            let mut project = false;
+            for e in &self.extensions {
+                match e.as_str() {
+                    "wav" | "wave" | "mp3" | "flac" | "ogg" | "oga" | "m4a" | "aac" | "opus"
+                    | "aiff" | "aif" | "wma" => audio = true,
+                    "mid" | "midi" => midi = true,
+                    "json" | "hsp" | "hifishifter" => project = true,
+                    _ => {}
+                }
+            }
+            if audio && !midi && !project {
+                "audio/*".to_string()
+            } else if midi && !audio && !project {
+                "audio/midi".to_string()
+            } else {
+                // 混合类型（或含 json/工程文件）：只能放开，否则用户看不到自己要的文件。
+                "*/*".to_string()
+            }
+        }
+
+        /// 保存方向的 MIME —— **不能直接复用 `mime()`**。
+        ///
+        /// 🔴 2026-09-23：用户报「工程保存还是已取消，但 WAV 导出没问题」。
+        /// 两者的 `save_file` 调用链**完全相同**（同一个 `FileDialog::save_file`），
+        /// 唯一差异就是这个字段：
+        ///   · WAV 导出  ⇒ exts=[wav]        ⇒ `audio/*`（具体）
+        ///   · 工程保存  ⇒ exts=[hshp,hsp,json,zip] ⇒ 落到 `*/*`
+        ///
+        /// `ACTION_CREATE_DOCUMENT` 的 `type` 要求**具体的** MIME，`*/*` 在部分 ROM
+        /// （ColorOS 实测）上会让创建流程异常、回传空 data —— 我们那边就判成了
+        /// 「用户取消」。所以保存一律换成 `application/octet-stream` 兜底。
+        ///
+        /// ⚠️ **不要**改 `mime()` 本身：导入方向恰恰需要 `*/*`，否则用户在选择器里
+        /// 看不到自己要的文件（这条在「导入工程时选到 mp3」那次已经验证过）。
+        fn save_mime(&self) -> String {
+            let m = self.mime();
+            if m == "*/*" {
+                "application/octet-stream".to_string()
+            } else {
+                m
+            }
+        }
+
+        fn detail(&self) -> String {
+            let mut parts = Vec::new();
+            if let Some(t) = &self.title {
+                parts.push(format!("title={t:?}"));
+            }
+            if let Some(f) = &self.file_name {
+                parts.push(format!("file_name={f:?}"));
+            }
+            if !self.extensions.is_empty() {
+                parts.push(format!("exts={:?}", self.extensions));
+            }
+            if parts.is_empty() {
+                String::new()
+            } else {
+                format!("（{}）", parts.join(", "))
+            }
+        }
+    }
+}
