diff --git a/frontend/src/index.css b/frontend/src/index.css
index 29f737e2..4a5f3852 100644
--- a/frontend/src/index.css
+++ b/frontend/src/index.css
@@ -493,4 +493,32 @@ textarea {
     .hs-tracklist-head {
         width: 132px;
     }
+    /* 参数编辑器标题是纯装饰，360px 下被挤成 12px 宽的竖排字（w=12,h=80），
+       且会骑到手机顶栏上 —— 直接隐藏（真机实测 2026-09-19）。 */
+    .hs-param-title {
+        display: none;
+    }
+    /* 参数工具行（参考轨道组/导入 MIDI/参数 pills）横向滚动：内容宽 > 360，
+       不处理会与相邻元素重叠。 */
+    .hs-param-toolbar {
+        overflow-x: auto;
+        flex-wrap: nowrap;
+        max-width: 100%;
+    }
+    /* 子项禁止被 flex 压缩换行（"平滑度"曾压成两行、"导入 MIDI"截断） */
+    .hs-param-toolbar button,
+    .hs-param-toolbar .param-pill {
+        white-space: nowrap;
+        flex-shrink: 0;
+    }
+    /* 头部条左侧块（同步轨道/选择·绘制/静态参数标签）是另一条会溢出的行：
+       "平滑度:" 在 360px 下压成两行且与右侧 hs-param-toolbar 交叠（真机实测）。 */
+    .hs-param-head {
+        overflow-x: auto;
+        overflow-y: hidden;
+    }
+    .hs-param-head span,
+    .hs-param-head button {
+        white-space: nowrap;
+    }
 }
