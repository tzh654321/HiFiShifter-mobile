index 90012222..800b049e 100644
--- a/frontend/src/utils/platform.ts
+++ b/frontend/src/utils/platform.ts
@@ -13,6 +13,16 @@ export const IS_MAC =
 export const IS_LINUX =
     typeof navigator !== "undefined" && /Linux/i.test(navigator.platform || navigator.userAgent);
 
+/**
+ * 是否运行在 Android（Tauri 移动端）。
+ *
+ * Tauri Android 用系统 WebView 承载前端，其 `navigator.userAgent` 含 "Android"，
+ * 在真机与模拟器上均稳定。触控手势层（docs/08）据此判定是否接管双指手势，
+ * 桌面端（Mac/Win/Linux）一律不接入（ADR-005）。
+ */
+export const IS_ANDROID =
