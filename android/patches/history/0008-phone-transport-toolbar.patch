@@ -0,0 +1,128 @@
+/**
+ * PlaybackBar — 手机常驻播放条（`docs/03` §2.2：播放条必须常驻，不能藏进菜单）。
+ *
+ * 按你给的「轨道界面外显优先级」排序，这一组（停止 / 播放 / 录制）是**第一档**，
+ * 因此常驻显示在底部页签之上；手机上此前没有任何播放入口，这是补上的第一块。
+ *
+ * 语义与桌面 Transport 完全一致：
+ * - 停止：`stopAudioPlayback({ restoreAnchor: true })`
+ * - 播放/暂停：`isPlaying ? stopAudioPlayback() : playOriginal()`
+ * - 录制：`active ? stop : countdown>0 ? cancel : start`
+ */
+
+import React from "react";
+import { useAppDispatch, useAppSelector } from "../../app/hooks";
+import { shallowEqual } from "react-redux";
+import { playOriginal, stopAudioPlayback } from "../../features/session/sessionSlice";
+import {
+    cancelRecordingCountdown,
+    startRecordingFlow,
+    stopRecordingFlow,
+} from "../../features/recording/recordingSlice";
+
+export const PLAYBACK_BAR_HEIGHT = 56;
+
+function Svg({ children }: { children: React.ReactNode }) {
+    return (
+        <svg width="20" height="20" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
+            {children}
+        </svg>
+    );
+}
+
+interface BtnProps {
+    label: string;
+    active: boolean;
+    danger?: boolean;
+    onClick: () => void;
+    children: React.ReactNode;
+}
+
+function TransportButton({ label, active, danger, onClick, children }: BtnProps) {
+    return (
+        <button
+            type="button"
+            onClick={onClick}
+            aria-label={label}
+            aria-pressed={active}
+            className="flex items-center justify-center bg-transparent border-0 cursor-pointer"
+            style={{
+                minWidth: 56,
+                minHeight: 48,
+                borderRadius: 8,
+                color: danger ? "#e5484d" : undefined,
+                background: active ? "rgba(127,119,221,0.18)" : "transparent",
+                WebkitTapHighlightColor: "transparent",
+            }}
+        >
+            {children}
+        </button>
+    );
+}
+
+export function PlaybackBar() {
+    const dispatch = useAppDispatch();
+    const isPlaying = useAppSelector((s) => s.session.runtime.isPlaying);
+    const recording = useAppSelector((s) => s.recording, shallowEqual);
+
+    const handleStop = () => {
+        dispatch(stopAudioPlayback({ restoreAnchor: true }));
+    };
+
+    const handlePlayToggle = () => {
+        if (isPlaying) {
+            dispatch(stopAudioPlayback());
+        } else {
+            dispatch(playOriginal());
+        }
+    };
+
+    const handleRecordToggle = () => {
+        if (recording.active) {
+            void dispatch(stopRecordingFlow());
+        } else if (recording.countdownRemaining > 0) {
+            void dispatch(cancelRecordingCountdown());
+        } else {
+            void dispatch(startRecordingFlow());
+        }
+    };
+
+    return (
+        <div
+            className="shrink-0 flex items-center gap-1 px-2 bg-qt-window border-t border-qt-border"
+            style={{ minHeight: PLAYBACK_BAR_HEIGHT }}
+            role="toolbar"
+            aria-label="播放控制"
+        >
+            <TransportButton label="停止" active={false} onClick={handleStop}>
+                <Svg>
+                    <rect x="3" y="3" width="10" height="10" rx="1.5" />
+                </Svg>
+            </TransportButton>
+
+            <TransportButton label={isPlaying ? "暂停" : "播放"} active={isPlaying} onClick={handlePlayToggle}>
+                <Svg>
+                    {isPlaying ? (
+                        <>
+                            <rect x="3" y="2.5" width="3.5" height="11" rx="1" />
+                            <rect x="9.5" y="2.5" width="3.5" height="11" rx="1" />
+                        </>
+                    ) : (
+                        <path d="M4 2.5 L13 8 L4 13.5 Z" />
+                    )}
+                </Svg>
+            </TransportButton>
+
+            <TransportButton
+                label={recording.active ? "停止录制" : "录制"}
+                active={recording.active}
+                danger={recording.active}
+                onClick={handleRecordToggle}
+            >
+                <Svg>
+                    <circle cx="8" cy="8" r="5.5" />
+                </Svg>
+            </TransportButton>
+        </div>
+    );
+}
