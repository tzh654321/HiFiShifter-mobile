+    // 👁 总开关（手机底栏「所有隐藏/显示」，ps1.png）：MobileBottomBar 派发
+    // 自定义事件切换**全部**参考覆盖层。覆盖层可见性目前是本组件 state（尚未
+    // 提升 redux），先以事件桥接（ADR-005：不重构上游组件的最小侵入方式），
+    // 长期应随该 state 一起提升。__hsOverlaysVisible 供 CDP 验收读取。
+    useEffect(() => {
+        const onToggle = (e: Event) => {
+            const show = (e as CustomEvent<boolean>).detail;
+            if (show) {
+                const next: Partial<Record<ParamName, boolean>> = { pitch: true };
+                for (const d of processorParamsRef.current) {
+                    (next as Record<string, boolean>)[d.id] = true;
+                }
+                setSecondaryParamVisible(next);
+            } else {
+                setSecondaryParamVisible({});
+            }
+            (window as unknown as { __hsOverlaysVisible?: boolean }).__hsOverlaysVisible = show;
+        };
+        window.addEventListener("hs-toggle-secondary-overlays", onToggle);
+        return () => window.removeEventListener("hs-toggle-secondary-overlays", onToggle);
+    }, []);
+
     const toggleSecondaryParam = useCallback((param: ParamName) => {
         setSecondaryParamVisible((prev) => toggleSecondaryParamVisibility(prev, param));
     }, []);
