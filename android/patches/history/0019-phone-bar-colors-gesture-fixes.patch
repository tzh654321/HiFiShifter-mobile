+/* ── 自绘滚动条 / 滑条：触屏拖拽的两条硬要求（2026-09-19 用户清单）──────────
+   ① `touch-action: none`：不加的话触屏上手指划几像素就被浏览器接管为翻页/滚动，
+      派发 pointercancel 打断拖拽 —— 表现就是「滑条只能小幅划动」（与轨道头音量
+      旋钮同一根因，那次只修了旋钮）。鼠标不受影响（touch-action 只管触摸输入）。
+   ② 命中区：轨道视觉 8px，手机上加厚到 20px（thumb 仍画 8px 居中），
+      否则手指按不住。桌面维持原样。                                       */
+.hs-sb,
+.hs-sb-thumb {
+    touch-action: none;
+}
+/* 原生 range 滑条（平滑度等）走同一约定：拖 value 时不许被合成滚动打断。 */
+.qt-range {
+    touch-action: none;
+}
+
 /* ── 手机形态（<600px）排版覆盖（docs/04；全项目第一条响应式规则）──────────
    轨道头桌面固定 w-64(256px)。360px 宽的手机上它吃掉 71%，时间线画布只剩 104px，
    根本没法编辑。压窄到 132px，画布拿到 ~227px。桌面（≥600px）不受影响。 */
 @media (max-width: 599px) {
+    /* 滚动条命中区外扩（视觉不变）：横条向上长 12px 进内容区、竖条向左长 12px。 */
+    .hs-sb-v {
+        width: 20px !important;
+    }
+    .hs-sb-v .hs-sb-thumb {
+        width: 8px !important;
+        left: 6px !important;
+    }
+    .hs-sb-h {
+        height: 20px !important;
+    }
+    .hs-sb-h .hs-sb-thumb {
+        height: 8px !important;
+        top: 6px !important;
+    }
     .hs-tracklist-head {
         width: 132px;
     }
@@ -561,6 +591,12 @@ textarea {
