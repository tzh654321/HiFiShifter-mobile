@@ -0,0 +1,104 @@
+/**
+ * MobileTopBar — 手机形态的顶部栏（替代桌面 MenuBar，`docs/04` §9）。
+ *
+ * 手机上没有顶部菜单栏的使用习惯，桌面 `MenuBar` 的菜单语义改为汉堡入口。
+ * 现阶段只把最关键的「新建 / 打开工程」放进来（否则手机上一启动就没有任何工程入口），
+ * 其余菜单项在触控交互阶段（`docs/03`）补齐。
+ *
+ * 顶部预留 `env(safe-area-inset-top)`：inset 修复后状态栏仍会压住最顶端的内容。
+ */
+
+import React from "react";
+
+interface MobileTopBarProps {
+    onNewProject?: () => void;
+    onOpenProject?: () => void;
+}
+
+export const MOBILE_TOP_BAR_HEIGHT = 48;
+
+export function MobileTopBar({ onNewProject, onOpenProject }: MobileTopBarProps) {
+    const [menuOpen, setMenuOpen] = React.useState(false);
+
+    const run = (action?: () => void) => () => {
+        setMenuOpen(false);
+        action?.();
+    };
+
+    const items: ReadonlyArray<{ label: string; action?: () => void }> = [
+        { label: "新建工程", action: onNewProject },
+        { label: "打开工程", action: onOpenProject },
+    ];
+
+    return (
+        <header
+            className="shrink-0 relative flex items-center gap-2 px-3 bg-qt-window border-b border-qt-border"
+            style={{
+                minHeight: MOBILE_TOP_BAR_HEIGHT,
+                paddingTop: "env(safe-area-inset-top, 0px)",
+            }}
+        >
+            <button
+                type="button"
+                onClick={() => setMenuOpen((v) => !v)}
+                aria-label="主菜单"
+                aria-expanded={menuOpen}
+                className="flex items-center justify-center bg-transparent border-0 cursor-pointer"
+                style={{
+                    minWidth: 44,
+                    minHeight: 44,
+                    fontSize: 18,
+                    WebkitTapHighlightColor: "transparent",
+                }}
+            >
+                <span aria-hidden="true">≡</span>
+            </button>
+
+            <span className="flex-1 truncate" style={{ fontSize: 16, fontWeight: 500 }}>
+                HiFiShifter
+            </span>
+
+            {menuOpen ? (
+                <>
+                    <button
+                        type="button"
+                        aria-label="关闭菜单"
+                        onClick={() => setMenuOpen(false)}
+                        className="fixed border-0 cursor-pointer"
+                        style={{ inset: 0, background: "transparent", zIndex: 40 }}
+                    />
+                    <div
+                        role="menu"
+                        className="absolute bg-qt-window border border-qt-border"
+                        style={{
+                            top: "100%",
+                            left: 8,
+                            minWidth: 180,
+                            zIndex: 41,
+                            borderRadius: 8,
+                            overflow: "hidden",
+                        }}
+                    >
+                        {items.map((item) => (
+                            <button
+                                key={item.label}
+                                type="button"
+                                role="menuitem"
+                                onClick={run(item.action)}
+                                className="flex w-full items-center bg-transparent border-0 cursor-pointer"
+                                style={{
+                                    minHeight: 48,
+                                    padding: "0 16px",
+                                    fontSize: 16,
+                                    textAlign: "left",
+                                }}
+                            >
+                                {item.label}
+                            </button>
+                        ))}
+                    </div>
+                </>
+            ) : null}
+        </header>
+    );
+}
