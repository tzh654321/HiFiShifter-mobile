diff --git a/frontend/src/utils/layoutMode.ts b/frontend/src/utils/layoutMode.ts
new file mode 100644
index 00000000..2e00f306
--- /dev/null
+++ b/frontend/src/utils/layoutMode.ts
@@ -0,0 +1,53 @@
+/**
+ * layoutMode.ts — 三套布局的形态判定（ADR-006 / ADR-007；`docs/04` §2）。
+ *
+ * - `phone`   宽 < 600 —— 单面板 + 底部页签，时间线与参数面板**互斥**
+ * - `tablet`  宽 ≥ 600 且高 ≥ 500 —— 可停靠多面板（不是手机布局的放大）
+ * - `desktop` 宽 ≥ 1280 —— 上游现有布局，一行不改
+ *
+ * 判据同时看宽和高：横屏手机宽度够但高度只有 360，塞不下双面板，仍归 phone。
+ * 支持 `?layout=phone|tablet|desktop` 强制切换，便于在一台设备上对照三套布局。
+ */
+
+import { useEffect, useState } from "react";
+
+export type LayoutMode = "phone" | "tablet" | "desktop";
+
+export function resolveLayoutMode(w: number, h: number, forced?: string | null): LayoutMode {
+    if (forced === "phone" || forced === "tablet" || forced === "desktop") return forced;
+    if (w >= 1280) return "desktop";
+    if (w >= 600 && h >= 500) return "tablet";
+    return "phone";
+}
+
+/** 读取 URL 上的强制布局参数（?layout=phone）。 */
+export function readForcedLayoutMode(): string | null {
+    if (typeof window === "undefined") return null;
+    try {
+        return new URLSearchParams(window.location.search).get("layout");
+    } catch {
+        return null;
+    }
+}
+
+function currentMode(): LayoutMode {
+    if (typeof window === "undefined") return "desktop";
+    return resolveLayoutMode(window.innerWidth, window.innerHeight, readForcedLayoutMode());
+}
+
+/** 订阅视口尺寸变化，返回当前形态。 */
+export function useLayoutMode(): LayoutMode {
+    const [mode, setMode] = useState<LayoutMode>(currentMode);
+
+    useEffect(() => {
+        const update = () => setMode(currentMode());
+        window.addEventListener("resize", update);
+        window.addEventListener("orientationchange", update);
+        return () => {
+            window.removeEventListener("resize", update);
+            window.removeEventListener("orientationchange", update);
+        };
+    }, []);
+
+    return mode;
+}
